</AdminLayout>

<script>
  function setupPartnersPage() {
    // 1. Accordion drawer toggle
    const rows = document.querySelectorAll('.partner-main-row');
    rows.forEach((r) => {
      r.addEventListener('click', () => {
        const targetId = r.getAttribute('data-target');
        if (!targetId) return;
        const drawer = document.getElementById(targetId);
        if (!drawer) return;

        const isHidden = drawer.classList.contains('hidden');
        document.querySelectorAll('.partner-drawer').forEach((d) => d.classList.add('hidden'));
        if (isHidden) {
          drawer.classList.remove('hidden');
        }
      });
    });

    // 2. Tab switching inside drawer
    const tabBtns = document.querySelectorAll('.tab-btn');
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const tabTarget = btn.getAttribute('data-tab');
        if (!tabTarget) return;

        const drawer = btn.closest('.partner-drawer');
        if (!drawer) return;

        drawer.querySelectorAll('.tab-btn').forEach((b) => {
          b.classList.remove('border-brand', 'text-brand');
          b.classList.add('border-transparent', 'text-gray-500');
        });
        btn.classList.remove('border-transparent', 'text-gray-500');
        btn.classList.add('border-brand', 'text-brand');

        drawer.querySelectorAll('.tab-content').forEach((c) => c.classList.add('hidden'));
        const activeTab = drawer.querySelector(`#${tabTarget}`);
        if (activeTab) activeTab.classList.remove('hidden');
      });
    });

    // 3. Mở modal tạo mới
    const openBtn = document.getElementById('btnOpenPartnerModal');
    openBtn?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-mainPartnerModal', {
        detail: {
          is_customer: window.location.search.includes('type=SUPPLIER') ? false : true,
          is_supplier: window.location.search.includes('type=SUPPLIER') ? true : false,
        }
      }));
    });

    // 4. Mở modal sửa đối tác
    const editBtns = document.querySelectorAll('.btn-edit-partner');
    editBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const dataStr = btn.getAttribute('data-partner');
        if (!dataStr) return;
        try {
          const partner = JSON.parse(dataStr);
          window.dispatchEvent(new CustomEvent('edit-mainPartnerModal', { detail: partner }));
        } catch (err) {
          console.error('Lỗi parse partner data:', err);
        }
      });
    });

    // 5. Mở modal thanh toán / thu nợ gắn liền chứng từ gốc
    const payDebtBtns = document.querySelectorAll('.btn-open-pay-debt');
    payDebtBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        try {
          const partner = JSON.parse(btn.getAttribute('data-partner') || '{}');
          const targetType = btn.getAttribute('data-target-type') || 'PURCHASE';
          const documents = JSON.parse(btn.getAttribute('data-docs') || '[]');
          window.dispatchEvent(new CustomEvent('open-mainPayDebtModal', {
            detail: { partner, targetType, documents }
          }));
        } catch (err) {
          console.error('Lỗi parse dữ liệu thanh toán nợ:', err);
        }
      });
    });

    // 6. Lắng nghe khi lưu đối tác thành công để reload
    window.addEventListener('partner-saved', () => {
      window.location.reload();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPartnersPage);
  } else {
    setupPartnersPage();
  }
</script>

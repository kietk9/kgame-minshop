---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getBuybackById } from '../../../features/kgame/db';

export const prerender = false;

const id = Number(Astro.params.id);
if (!id || isNaN(id)) {
  return Astro.redirect('/admin/buybacks');
}

const buyback = await getBuybackById(env.DB, id);
if (!buyback) {
  return Astro.redirect('/admin/buybacks?error=' + encodeURIComponent('Không tìm thấy phiếu thu mua'));
}

const formatNumber = (val: number) => {
  if (!val || isNaN(val)) return '0';
  return new Intl.NumberFormat('en-US').format(val);
};
const formatVND = formatNumber;

const formatDate = (iso: string) => {
  if (!iso) return '-';
  try {
    const d = new Date(iso);
    return d.toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit', year: 'numeric' });
  } catch {
    return iso;
  }
};

const success = Astro.url.searchParams.get('success');
---

<AdminLayout title={`Phiếu Thu Mua ${buyback.buyback_code}`} active="buybacks">
  <!-- TOPBAR & ACTIONS -->
  <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-sm text-gray-500 mb-1">
        <a href="/admin/buybacks" class="hover:underline text-brand">Thu Mua Máy Cũ</a>
        <span>/</span>
        <span class="font-normal text-gray-700">{buyback.buyback_code}</span>
      </div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-bold text-gray-900">Phiếu Thu Mua {buyback.buyback_code}</h1>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
          Đã hoàn tất &amp; Nhập kho QSD
        </span>
      </div>
      <p class="text-xs text-gray-500 mt-1">Lập lúc: {formatDate(buyback.created_at)}</p>
    </div>

    <div class="flex items-center gap-3">
      <a
        href={`/admin/buybacks/${buyback.id}/print`}
        target="_blank"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gray-900 text-white text-sm font-semibold hover:bg-black transition shadow"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
        In Biên Bản Bàn Giao (A4/A5)
      </a>

      <a
        href="/admin/buybacks"
        class="px-3.5 py-2 border border-line rounded-xl text-sm font-medium text-gray-600 hover:bg-gray-50 transition"
      >
        Danh sách
      </a>
    </div>
  </div>

  {success === 'created' && (
    <div class="mb-6 rounded-lg border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800 flex items-center gap-2">
      <svg class="w-5 h-5 flex-shrink-0 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
      <span>Tạo phiếu thu mua <strong>{buyback.buyback_code}</strong> thành công! Đã tự động nhập hàng vào Sổ kho và xuất Phiếu Chi trong Sổ Quỹ.</span>
    </div>
  )}

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- CỘT TRÁI (2/3): BẢNG MẶT HÀNG THU MUA -->
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white rounded-xl border border-line shadow-sm overflow-hidden">
        <div class="p-4 border-b border-line bg-gray-50/50 flex items-center justify-between">
          <h2 class="text-sm font-bold text-gray-900">Danh Sách Mặt Hàng &amp; Máy Cũ Thu Mua</h2>
          <span class="text-xs text-gray-500">{buyback.items.length} mặt hàng</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-[14.5px] text-gray-700">
            <thead class="bg-[#f8f9fa] text-[14px] font-semibold text-gray-700 border-b border-line select-none">
              <tr>
                <th class="px-4 py-3">Sản phẩm &amp; Phiên bản</th>
                <th class="px-4 py-3">Mã bộ / Tình trạng</th>
                <th class="px-4 py-3 text-center">Số lượng</th>
                <th class="px-4 py-3 text-right">Đơn giá thu mua</th>
                <th class="px-4 py-3 text-right">Thành tiền</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              {buyback.items.map((it: any) => (
                <tr class="hover:bg-blue-50/40 transition">
                  <td class="px-4 py-3">
                    <div class="font-normal text-gray-900">{it.product_name}</div>
                    <div class="text-[12px] text-gray-500">{it.type_name || 'Tiêu chuẩn'}</div>
                  </td>
                  <td class="px-4 py-3">
                    {it.program_code ? (
                      <div class="space-y-1">
                        <a
                          href={`/admin/units/lookup?code=${encodeURIComponent(it.program_code)}`}
                          class="inline-flex items-center gap-1 font-normal text-[12.5px] text-brand bg-blue-50 px-2 py-0.5 rounded hover:underline border border-blue-200"
                        >
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                          {it.program_code}
                        </a>
                        <span class="inline-block px-1.5 py-0.5 rounded text-[11px] font-medium bg-amber-100 text-amber-800 ml-1">
                          QSD
                        </span>
                      </div>
                    ) : (
                      <span class="inline-block px-1.5 py-0.5 rounded text-[11px] font-medium bg-amber-100 text-amber-800">
                        Đã qua sử dụng (QSD)
                      </span>
                    )}

                    {it.condition_note && (
                      <div class="text-[12px] text-gray-500 mt-1 italic">
                        "{it.condition_note}"
                      </div>
                    )}
                  </td>
                  <td class="px-4 py-3 text-center font-normal tabular-nums text-gray-900">
                    {it.quantity}
                  </td>
                  <td class="px-4 py-3 text-right font-normal tabular-nums text-gray-700">
                    {formatVND(it.purchase_price_cents)}
                  </td>
                  <td class="px-4 py-3 text-right font-normal tabular-nums text-gray-900">
                    {formatVND(it.quantity * it.purchase_price_cents)}
                  </td>
                </tr>
              ))}
            </tbody>
            <tfoot class="bg-gray-50/70 font-medium text-gray-900 border-t border-line text-[14.5px]">
              <tr>
                <td colspan="4" class="px-4 py-3 text-right font-medium">Tổng tiền chi thu mua:</td>
                <td class="px-4 py-3 text-right text-[15px] text-red-600 font-normal tabular-nums">
                  {formatVND(buyback.total_amount_cents)}
                </td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

      <!-- GHI CHÚ BÀN GIAO -->
      {buyback.note && (
        <div class="bg-white rounded-xl border border-line p-4 shadow-sm">
          <h3 class="text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Ghi chú &amp; Thỏa thuận bàn giao</h3>
          <p class="text-sm text-gray-700 whitespace-pre-line">{buyback.note}</p>
        </div>
      )}
    </div>

    <!-- CỘT PHẢI (1/3): THÔNG TIN NGƯỜI BÁN & SỔ QUỸ -->
    <div class="space-y-6">
      <!-- NGƯỜI BÁN -->
      <div class="bg-white rounded-xl border border-line p-5 shadow-sm">
        <h2 class="text-sm font-bold text-gray-900 border-b border-line pb-3 mb-3">Người Bán (Khách Hàng)</h2>
        <div class="space-y-2.5 text-sm">
          <div>
            <span class="text-xs text-gray-500 block">Họ và tên:</span>
            <span class="font-semibold text-gray-900">{buyback.customer_name || 'Khách thanh lý'}</span>
          </div>
          {buyback.customer_phone && (
            <div>
              <span class="text-xs text-gray-500 block">Số điện thoại:</span>
              <span class="font-medium text-gray-800">{buyback.customer_phone}</span>
            </div>
          )}
          {buyback.customer_address && (
            <div>
              <span class="text-xs text-gray-500 block">Địa chỉ:</span>
              <span class="text-gray-700">{buyback.customer_address}</span>
            </div>
          )}
          {buyback.customer_code && (
            <div>
              <span class="text-xs text-gray-500 block">Mã khách hàng:</span>
              <a href={`/admin/customers?q=${buyback.customer_code}`} class="text-brand font-normal text-[13.5px] hover:underline">
                {buyback.customer_code}
              </a>
            </div>
          )}
        </div>
      </div>

      <!-- DÒNG TIỀN & SỔ QUỸ -->
      <div class="bg-white rounded-xl border border-line p-5 shadow-sm">
        <h2 class="text-[14.5px] font-semibold text-gray-900 border-b border-line pb-3 mb-3">Hạch Toán Sổ Quỹ (Cashbook)</h2>
        <div class="space-y-3 text-[14px]">
          <div class="flex items-center justify-between">
            <span class="text-gray-500 text-xs">Tổng chi trả:</span>
            <span class="font-normal tabular-nums text-red-600">{formatVND(buyback.total_amount_cents)}</span>
          </div>

          <div class="flex items-center justify-between">
            <span class="text-gray-500 text-xs">Hình thức chi:</span>
            <span class="font-normal text-gray-900">
              {buyback.payment_method === 'BANK' ? 'Chuyển khoản ngân hàng' : 'Tiền mặt tại két'}
            </span>
          </div>

          {buyback.bank_account && (
            <div class="flex items-center justify-between">
              <span class="text-gray-500 text-xs">Tài khoản chi:</span>
              <span class="text-xs font-medium text-blue-700 bg-blue-50 px-2 py-0.5 rounded">
                {buyback.bank_account}
              </span>
            </div>
          )}

          <div class="pt-3 border-t border-line">
            <div class="text-xs text-gray-500 mb-1">Chứng từ Sổ Quỹ:</div>
            {buyback.cash_transaction_code ? (
              <a
                href={`/admin/cash?q=${buyback.cash_transaction_code}`}
                class="inline-flex items-center gap-1.5 font-normal text-[12.5px] text-brand bg-blue-50 px-2.5 py-1 rounded-lg border border-blue-200 hover:bg-blue-100 transition"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                Phiếu Chi {buyback.cash_transaction_code}
              </a>
            ) : (
              <span class="text-xs text-gray-400 italic">Chưa liên kết</span>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

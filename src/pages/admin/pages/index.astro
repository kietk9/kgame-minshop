---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listPages } from '../../../features/pages/db';
import { menuReferencesFor } from '../../../features/navigation/admin';

const pages = await listPages(env.DB);
// Deleting a page that a menu links to silently shrinks the storefront nav.
// One bounded query for the whole list, so say so before it happens.
const menuRefs = await menuReferencesFor(
  env.DB,
  'page',
  pages.map((p) => p.id),
);
const dateFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' });
const formatDate = (iso: string) => dateFmt.format(new Date(`${iso.replace(' ', 'T')}Z`));
---

<AdminLayout title="Pages" active="pages">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">Trang Nội Dung (Pages)</h1>
    <a
      href="/admin/pages/new"
      class="rounded-lg bg-brand px-4 py-2 text-xs font-semibold uppercase tracking-wider text-white hover:bg-brand-hover shadow-sm transition"
    >
      + Tạo trang mới
    </a>
  </div>

  {
    pages.length === 0 ? (
      <p class="py-12 text-center text-sm text-gray-500">
        No pages yet. Create one for About, Shipping, Returns, or Privacy, then add it to your
        {' '}
        <a href="/admin/navigation" class="underline hover:text-brand">
          Navigation
        </a>
        .
      </p>
    ) : (
      <div class="bg-white rounded-xl border border-line shadow-sm overflow-hidden">
        <table class="w-full text-left text-[14.5px] text-gray-700">
          <thead class="bg-[#f8f9fa] text-[14px] font-semibold text-gray-700 border-b border-line select-none">
            <tr>
              <th class="px-4 py-3">Tiêu đề</th>
              <th class="px-4 py-3">Đường dẫn</th>
              <th class="px-4 py-3">Trạng thái</th>
              <th class="px-4 py-3">Cập nhật</th>
              <th class="px-4 py-3 text-right">Thao tác</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {pages.map((page) => (
              <tr class="hover:bg-blue-50/40 transition">
                <td class="px-4 py-3">
                  <a href={`/admin/pages/${page.public_id}/edit`} class="font-normal text-gray-900 hover:text-brand">
                    {page.title}
                  </a>
                </td>
                <td class="px-4 py-3 text-gray-500 text-[13.5px]">/pages/{page.slug}</td>
                <td class="px-4 py-3">
                  <span class={`inline-flex items-center px-2 py-0.5 rounded text-[12px] font-medium ${
                    page.published ? 'bg-emerald-100 text-emerald-800' : 'bg-gray-100 text-gray-700'
                  }`}>
                    {page.published ? 'Đã xuất bản' : 'Bản nháp'}
                  </span>
                </td>
                <td class="px-4 py-3 text-gray-500 text-[13px] tabular-nums">
                  {formatDate(page.updated_at)}
                </td>
                <td class="px-4 py-3 text-right">
                  <span class="inline-flex items-center gap-3 text-[13px]">
                    {page.published !== 0 && (
                      <a
                        href={`/pages/${page.slug}`}
                        target="_blank"
                        rel="noopener"
                        class="text-gray-500 hover:text-brand transition"
                      >
                        Xem
                      </a>
                    )}
                    <a
                      href={`/admin/pages/${page.public_id}/edit`}
                      class="text-brand hover:underline"
                    >
                      Sửa
                    </a>
                    <form
                      method="POST"
                      action={`/api/admin/pages/${page.public_id}`}
                      onsubmit={`return confirm('${
                        menuRefs.has(page.id)
                          ? 'This page is linked from your navigation. Deleting it hides that link on the storefront. Continue?'
                          : 'Delete this page?'
                      }')`}
                    >
                      <input type="hidden" name="_action" value="delete" />
                      <button
                        type="submit"
                        class="text-xs uppercase tracking-widest text-red-600 hover:text-red-700"
                      >
                        Delete
                      </button>
                    </form>
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>

---
import AdminLayout from '../../layouts/AdminLayout.astro';
export const prerender=false;
const principal=Astro.locals.adminPrincipal;
if(!principal || principal.role==='OWNER')return new Response('Trang này dành cho tài khoản nhân viên. Chủ cửa hàng đổi mật khẩu trong cấu hình quản trị.',{status:403});
const error=Astro.url.searchParams.get('error');
---
<AdminLayout title="Đổi mật khẩu nhân viên">
 <section class="mx-auto max-w-lg rounded-lg border bg-white p-5">
  <h1 class="text-xl font-bold mb-3">Đổi mật khẩu</h1>
  <p class="mb-4">Tài khoản: <strong>{principal.username}</strong></p>
  {principal.mustChangePassword && <p class="mb-4 rounded border border-amber-300 bg-amber-50 p-3 text-amber-900">Bạn cần thay mật khẩu được cấp bằng mật khẩu riêng trước khi sử dụng hệ thống.</p>}
  <p class="text-sm text-gray-600 mb-4">Mật khẩu mới phải khác mật khẩu hiện tại, dài 12–128 ký tự. Đổi thành công sẽ đăng xuất mọi phiên của tài khoản này, kể cả phiên đang dùng.</p>
  {error && <p role="alert" class="mb-4 rounded border border-red-300 p-3 text-red-700">{error}</p>}
  <form method="POST" action="/api/admin/staff-password" class="space-y-4">
   <label class="block">Mật khẩu hiện tại<input name="current_password" type="password" autocomplete="current-password" required maxlength="128" class="block w-full border rounded p-2 mt-1" /></label>
   <label class="block">Mật khẩu mới<input name="new_password" type="password" autocomplete="new-password" required minlength="12" maxlength="128" class="block w-full border rounded p-2 mt-1" /></label>
   <label class="block">Nhập lại mật khẩu mới<input name="confirm_password" type="password" autocomplete="new-password" required minlength="12" maxlength="128" class="block w-full border rounded p-2 mt-1" /></label>
   <button class="w-full rounded bg-blue-700 p-3 text-white font-semibold">Đổi mật khẩu và đăng xuất</button>
  </form>
 </section>
</AdminLayout>

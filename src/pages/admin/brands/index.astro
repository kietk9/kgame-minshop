---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listBrands } from '../../../features/kgame/db';

export const prerender = false;

const brands = await listBrands(env.DB);
const success = Astro.url.searchParams.get('success');
const error = Astro.url.searchParams.get('error');
---

<AdminLayout title="Quản lý Thương hiệu / Nguồn gốc" active="products">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <a href="/admin/products" class="text-xs font-semibold text-gray-500 hover:text-brand">&larr; Về Hàng hóa</a>
      </div>
      <h1 class="mt-1 text-2xl font-bold text-gray-900">Quản lý Thương hiệu / Nguồn gốc</h1>
      <p class="mt-1 text-sm text-gray-500">
        Chuẩn hóa hãng sản xuất và nguồn gốc linh kiện (Kgame, Đài Loan, Trung Quốc, Sanwa, SEGA, IGS...).
      </p>
    </div>
    <button
      type="button"
      id="openCreateBrandBtn"
      class="inline-flex items-center gap-1.5 rounded-lg bg-brand px-4 py-2.5 text-xs font-semibold uppercase tracking-wider text-white shadow-sm transition hover:bg-brand-hover hover:shadow"
    >
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Thêm thương hiệu mới
    </button>
  </div>

  {success && (
    <div class="mb-6 rounded-lg border border-emerald-200 bg-emerald-50 p-4 text-xs font-semibold text-emerald-800 flex items-center gap-2">
      <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
      <span>
        {success === 'created' && 'Đã thêm thương hiệu mới thành công!'}
        {success === 'updated' && 'Đã cập nhật thông tin thương hiệu thành công!'}
        {success === 'deleted' && 'Đã xóa thương hiệu thành công!'}
      </span>
    </div>
  )}

  {error && (
    <div class="mb-6 rounded-lg border border-red-200 bg-red-50 p-4 text-xs font-semibold text-red-800 flex items-center gap-2">
      <svg class="w-4 h-4 text-red-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
      <span>{error}</span>
    </div>
  )}

  <!-- Search & Stats -->
  <div class="rounded-xl border border-line bg-white shadow-sm overflow-hidden mb-6">
    <div class="p-4 border-b border-line bg-gray-50/50 flex items-center justify-between">
      <div class="text-xs font-bold text-gray-700 uppercase tracking-wider">
        Danh sách thương hiệu ({brands.length})
      </div>
      <div class="text-xs text-gray-500">
        Các thương hiệu này sẽ tự động xuất hiện trong form Tạo hàng hóa &amp; Bộ lọc
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-[14.5px]">
        <thead class="bg-[#f8f9fa] border-b border-line text-[14px] font-semibold text-gray-700 select-none">
          <tr>
            <th class="px-6 py-3.5 w-16 text-center">STT</th>
            <th class="px-6 py-3.5">Tên thương hiệu / Nguồn gốc</th>
            <th class="px-6 py-3.5">Mô tả chi tiết</th>
            <th class="px-6 py-3.5 text-center w-36">Số mặt hàng</th>
            <th class="px-6 py-3.5 text-right w-44">Thao tác</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {brands.map((b: any, idx: number) => (
            <tr class="hover:bg-blue-50/40 transition">
              <td class="px-6 py-4 text-center text-[13px] tabular-nums text-gray-400">{idx + 1}</td>
              <td class="px-6 py-4">
                <span class="font-normal text-gray-900 text-[14.5px]">{b.name}</span>
              </td>
              <td class="px-6 py-4 text-[13px] text-gray-500">
                {b.description || <span class="italic text-gray-400">Không có mô tả</span>}
              </td>
              <td class="px-6 py-4 text-center">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[12px] font-normal tabular-nums bg-blue-50 text-blue-700 border border-blue-200">
                  {b.product_count || 0} hàng
                </span>
              </td>
              <td class="px-6 py-4 text-right space-x-3 text-[13px]">
                <button
                  type="button"
                  class="font-medium text-blue-600 hover:underline cursor-pointer"
                  onclick={`openEditBrandModal(${b.id}, '${b.name.replace(/'/g, "\\'")}', '${(b.description || '').replace(/'/g, "\\'")}')`}
                >
                  Sửa
                </button>
                <form method="POST" action="/api/admin/brands" class="inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa thương hiệu này không? Các sản phẩm thuộc thương hiệu sẽ không bị xóa.');">
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="id" value={b.id} />
                  <button type="submit" class="font-medium text-red-600 hover:underline cursor-pointer">
                    Xóa
                  </button>
                </form>
              </td>
            </tr>
          ))}

          {brands.length === 0 && (
            <tr>
              <td colspan="5" class="py-12 text-center text-gray-400 text-xs">
                Chưa có thương hiệu nào. Bấm nút "Thêm thương hiệu mới" ở trên để tạo.
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- MODAL THÊM / SỬA THƯƠNG HIỆU -->
  <div
    id="brandModal"
    class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm p-4 flex items-center justify-center transition-all"
  >
    <div class="relative w-full max-w-md rounded-2xl bg-white shadow-2xl border border-line overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      <div class="flex items-center justify-between border-b border-line px-6 py-4 bg-gray-50/70">
        <h3 id="brandModalTitle" class="text-base font-bold text-gray-900">Thêm thương hiệu mới</h3>
        <button
          type="button"
          id="closeBrandModalBtn"
          class="text-gray-400 hover:text-gray-600 transition rounded-lg p-1.5 hover:bg-gray-100"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <form method="POST" action="/api/admin/brands" class="p-6 space-y-4">
        <input type="hidden" name="action" id="brandFormAction" value="create" />
        <input type="hidden" name="id" id="brandFormId" value="" />

        <div>
          <label class="block text-xs font-semibold text-gray-700 mb-1">Tên thương hiệu / Nguồn gốc <span class="text-red-500">*</span></label>
          <input
            type="text"
            name="name"
            id="brandInputName"
            required
            placeholder="VD: Sanwa, IGS, SEGA, Đài Loan..."
            class="w-full py-2 px-3 text-sm border border-line rounded-lg focus:outline-none focus:border-brand font-medium text-gray-900"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-700 mb-1">Mô tả / Ghi chú</label>
          <textarea
            name="description"
            id="brandInputDesc"
            rows="2"
            placeholder="Ghi chú về xuất xứ, độ tin cậy..."
            class="w-full py-2 px-3 text-xs border border-line rounded-lg focus:outline-none focus:border-brand text-gray-700"
          ></textarea>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2 border-t border-line">
          <button
            type="button"
            id="cancelBrandModalBtn"
            class="px-4 py-2 text-xs font-medium text-gray-600 hover:text-gray-800 transition rounded-lg"
          >
            Hủy
          </button>
          <button
            type="submit"
            class="px-5 py-2 text-xs font-bold text-white bg-brand hover:bg-brand-hover rounded-lg shadow-sm transition"
          >
            Lưu thương hiệu
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const modal = document.getElementById('brandModal');
    const openBtn = document.getElementById('openCreateBrandBtn');
    const closeBtn = document.getElementById('closeBrandModalBtn');
    const cancelBtn = document.getElementById('cancelBrandModalBtn');

    const modalTitle = document.getElementById('brandModalTitle');
    const formAction = document.getElementById('brandFormAction') as HTMLInputElement;
    const formId = document.getElementById('brandFormId') as HTMLInputElement;
    const inputName = document.getElementById('brandInputName') as HTMLInputElement;
    const inputDesc = document.getElementById('brandInputDesc') as HTMLTextAreaElement;

    function openModal(isEdit = false, id = '', name = '', desc = '') {
      if (!modal) return;
      if (isEdit) {
        if (modalTitle) modalTitle.textContent = 'Chỉnh sửa thương hiệu';
        if (formAction) formAction.value = 'update';
        if (formId) formId.value = id;
        if (inputName) inputName.value = name;
        if (inputDesc) inputDesc.value = desc;
      } else {
        if (modalTitle) modalTitle.textContent = 'Thêm thương hiệu mới';
        if (formAction) formAction.value = 'create';
        if (formId) formId.value = '';
        if (inputName) inputName.value = '';
        if (inputDesc) inputDesc.value = '';
      }
      modal.classList.remove('hidden');
      setTimeout(() => inputName?.focus(), 100);
    }

    function closeModal() {
      if (modal) modal.classList.add('hidden');
    }

    openBtn?.addEventListener('click', () => openModal(false));
    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);

    (window as any).openEditBrandModal = function (id: number, name: string, desc: string) {
      openModal(true, String(id), name, desc);
    };
  </script>
</AdminLayout>

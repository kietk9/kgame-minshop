  <!-- DỮ LIỆU JSON ĐƯỢC INJECT ĐỂ CLIENT JS XỬ LÝ SIÊU TỐC KHÔNG GIẬT LAG -->
  <script is:inline define:vars={{ products, productTypes, inStockUnits, customers, deliveryPartners, senderInfo, initialPreorderData, authority }}>
    window.POS_DATA = {
      products,
      productTypes,
      inStockUnits,
      customers,
      deliveryPartners,
      senderInfo,
      initialPreorderData, authority
    };
  </script>

  <!-- CLIENT-SIDE LOGIC POS ENGINE -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const { products, productTypes, inStockUnits, customers, deliveryPartners, senderInfo, initialPreorderData, authority } = window.POS_DATA;

      const catalogPrice=(p,t,condition)=>condition==='QSD' ? (p?.price_used_cents || t?.sale_price_cents || p?.price_cents || 0) : (t?.sale_price_cents || p?.price_cents || p?.price_used_cents || 0);
      // Cấu trúc State của từng Tab hóa đơn
      let tabs = [];
      const requestIds = new Map();
      const requestIdFor = payload => {
        const tab = getActiveTab();
        if (!tab.operationSession) tab.operationSession = crypto.randomUUID();
        const signature = tab.operationSession + ':' + JSON.stringify(payload);
        if (!requestIds.has(signature)) requestIds.set(signature, crypto.randomUUID());
        return requestIds.get(signature);
      };
      if (initialPreorderData) {
        const pOrder = initialPreorderData;
        const items = (pOrder.lines || []).map(l => {
          const unit = l.units?.[0];
          return {
            orderLineId: l.id,
            hasSerial: !!products.find(p => p.id === l.product_id)?.has_serial || products.find(p => p.id === l.product_id)?.tracking_mode === 'CODE' || productTypes.find(t => t.id === l.product_type_id)?.tracking_mode === 'CODE',
            productId: l.product_id,
            productTypeId: l.product_type_id,
            productUnitId: unit?.product_unit_id || null,
            programCode: unit?.program_code || null,
            productCode: l.product_code || 'SP',
            productName: l.product_name || l.product_name_snapshot || 'Sản phẩm',
            typeName: l.product_type_name || l.type_name_snapshot || 'Tiêu chuẩn',
            condition: l.condition || 'NEW',
            quantity: l.quantity || 1,
            unitPrice: l.unit_price_cents || 0,
            discount: l.discount_cents || 0,
          };
        });

        const remainingToPay = Math.max(0, pOrder.amount_total_cents - pOrder.paid_amount_cents);

        tabs.push({
          id: 1,
          name: `Xử lý ${pOrder.order_code}`,
          mode: (pOrder.shipment?.carrier && pOrder.shipment?.carrier !== 'PICKUP') ? 'delivery' : 'quick',
          orderType: 'FULFILL_PREORDER',
          preorderId: pOrder.id,
          preorderCode: pOrder.order_code,
          items: items,
          customerId: pOrder.customer_id || null,
          customerCode: `KH#${pOrder.customer_id || ''}`,
          customerName: pOrder.customer_name || 'Khách đặt hàng',
          customerPhone: pOrder.customer_phone || '',
          customerAddress: pOrder.customer_address || '',
          customerDebt: 0,
          customerCredit: pOrder.customer_credit_cents || 0,
          discount: pOrder.discount_cents || 0,
          paid: remainingToPay,
          depositPaid: pOrder.paid_amount_cents || 0,
          paymentMethod: 'CASH',
          note: pOrder.note || '',
          shipment: {
            partnerId: pOrder.shipment?.delivery_partner_id || '',
            carrier: pOrder.shipment?.carrier || 'PICKUP',
            busStation: pOrder.shipment?.bus_station || '',
            trackingCode: pOrder.shipment?.tracking_code || '',
            shippingFee: pOrder.shipment?.shipping_fee_cents || 0,
            payer: pOrder.shipment?.shipping_payer || 'BUYER_PAYS',
            receiverName: pOrder.shipment?.receiver_name || pOrder.customer_name || '',
            receiverPhone: pOrder.shipment?.receiver_phone || pOrder.customer_phone || '',
            receiverAddress: pOrder.shipment?.receiver_address || pOrder.customer_address || '',
            weightGrams: pOrder.shipment?.weight_grams || 1500,
            dimensions: pOrder.shipment?.dimensions || '40 x 20 x 12',
            codAmount: 0,
            orderType: 'ORDER',
          }
        });
      } else {
        tabs = [
          {
            id: 1,
            name: 'Hóa đơn 1',
            mode: 'quick',
            orderType: 'ORDER',
            items: [],
            customerId: null,
            customerCode: '',
            customerName: '',
            customerPhone: '',
            customerAddress: '',
            customerDebt: 0,
            discount: 0,
            paid: 0,
            paymentMethod: 'CASH',
            note: '',
            shipment: {
              partnerId: '',
              carrier: 'BUS',
              busStation: '',
              trackingCode: '',
              shippingFee: 0,
              payer: 'BUYER_PAYS',
              receiverName: '',
              receiverPhone: '',
              receiverAddress: '',
              weightGrams: 1500,
              dimensions: '40 x 20 x 12',
              codAmount: 0,
              orderType: 'ORDER',
            }
          }
        ];
      }
      let activeTabId = 1;

      // Utility format số tiền
      const formatNum = (cents) => {
        if (!cents || isNaN(cents)) return '0';
        return new Intl.NumberFormat('en-US').format(cents);
      };

      const parseNum = (str) => {
        if (!str) return 0;
        const value = String(str).trim();
        if (!/^(?:[0-9]+|[0-9]{1,3}(?:,[0-9]{3})+|[0-9]{1,3}(?:\.[0-9]{3})+)$/.test(value)) return NaN;
        const amount = Number(value.replace(/[,.]/g, ''));
        return Number.isSafeInteger(amount) ? amount : NaN;
      };

      const getActiveTab = () => tabs.find(t => t.id === activeTabId) || tabs[0];

      // ĐỒNG HỒ THỜI GIAN THỰC
      const clockEl = document.getElementById('liveClock');
      setInterval(() => {
        if (clockEl) {
          const d = new Date();
          clockEl.innerText = d.toLocaleString('vi-VN', {
            day: '2-digit', month: '2-digit', year: 'numeric',
            hour: '2-digit', minute: '2-digit'
          });
        }
      }, 10000);

      // 1. RENDER TABS HÓA ĐƠN
      const renderTabs = () => {
        const container = document.getElementById('orderTabsContainer');
        if (!container) return;
        container.innerHTML = '';

        tabs.forEach(t => {
          const isActive = t.id === activeTabId;
          const isPreorder = t.orderType === 'PREORDER' || t.shipment?.orderType === 'PREORDER' || t.orderType === 'FULFILL_PREORDER';
          const btn = document.createElement('div');
          btn.className = `h-8.5 px-3 rounded flex items-center gap-1.5 text-xs font-semibold transition cursor-pointer shrink-0 ${
            isActive 
              ? (isPreorder ? 'bg-amber-500 text-white shadow-xs' : 'bg-white text-[#0b4d9c] shadow-xs') 
              : 'bg-white/15 text-white/80 hover:bg-white/25 hover:text-white'
          }`;

          const icon = isPreorder ? '📋' : (t.mode === 'delivery' ? '🚚' : '⚡');
          btn.innerHTML = `
            <span>${icon}</span>
            <span>${t.name}</span>
            ${tabs.length > 1 ? `<span class="close-tab-btn hover:text-red-500 font-bold ml-1 text-xs" data-id="${t.id}">✕</span>` : ''}
          `;

          btn.addEventListener('click', (e) => {
            if (e.target.classList.contains('close-tab-btn')) {
              e.stopPropagation();
              closeTab(t.id);
            } else {
              switchTab(t.id);
            }
          });

          container.appendChild(btn);
        });
      };

      const switchTab = (id) => {
        activeTabId = id;
        renderTabs();
        renderActiveTabContent();
      };

      const addNewTab = () => {
        const newId = (tabs[tabs.length - 1]?.id || 0) + 1;
        tabs.push({
          id: newId,
          name: `Hóa đơn ${newId}`,
          mode: 'quick',
          orderType: 'ORDER',
          items: [],
          customerId: null,
          customerCode: '',
          customerName: '',
          customerPhone: '',
          customerAddress: '',
          customerDebt: 0,
          discount: 0,
          paid: 0,
          paymentMethod: 'CASH',
          note: '',
          shipment: {
            partnerId: '',
            carrier: 'BUS',
            busStation: '',
            trackingCode: '',
            shippingFee: 0,
            payer: 'BUYER_PAYS',
            receiverName: '',
            receiverPhone: '',
            receiverAddress: '',
            weightGrams: 1500,
            dimensions: '40 x 20 x 12',
            codAmount: 0,
            orderType: 'ORDER',
          }
        });
        switchTab(newId);
      };

      const addNewPreorderTab = () => {
        const newId = (tabs[tabs.length - 1]?.id || 0) + 1;
        tabs.push({
          id: newId,
          name: `Đặt hàng ${newId}`,
          mode: 'quick',
          orderType: 'PREORDER',
          items: [],
          customerId: null,
          customerCode: '',
          customerName: '',
          customerPhone: '',
          customerAddress: '',
          customerDebt: 0,
          discount: 0,
          paid: 0,
          paymentMethod: 'CASH',
          note: '',
          shipment: {
            partnerId: '',
            carrier: 'BUS',
            busStation: '',
            trackingCode: '',
            shippingFee: 0,
            payer: 'BUYER_PAYS',
            receiverName: '',
            receiverPhone: '',
            receiverAddress: '',
            weightGrams: 1500,
            dimensions: '40 x 20 x 12',
            codAmount: 0,
            orderType: 'PREORDER',
          }
        });
        switchTab(newId);
        showToast('Đã mở tab Đặt hàng mới!', 'success');
      };

      const closeTab = (id) => {
        if (tabs.length <= 1) return;
        tabs = tabs.filter(t => t.id !== id);
        if (activeTabId === id) {
          activeTabId = tabs[0].id;
        }
        renderTabs();
        renderActiveTabContent();
      };

      document.getElementById('addNewTabBtn')?.addEventListener('click', addNewTab);

      // 2. RENDER NỘI DUNG GIỎ HÀNG CỦA TAB ĐANG MỞ
      const renderCartItems = () => {
        const tab = getActiveTab();
        const listEl = document.getElementById('cartItemsList');
        const emptyEl = document.getElementById('emptyCartView');

        if (!listEl || !emptyEl) return;

        if (tab.items.length === 0) {
          listEl.innerHTML = '';
          emptyEl.classList.remove('hidden');
          updateCartSummary(tab);
          return;
        }

        emptyEl.classList.add('hidden');
        listEl.innerHTML = '';

        tab.items.forEach((item, index) => {
          const row = document.createElement('div');
          row.className = 'px-3 py-2.5 flex items-center text-xs hover:bg-blue-50/40 transition group';
          
          const lineTotal = (item.quantity * item.unitPrice) - item.discount;
          const isGameProgram = !!item.programCode || item.hasSerial;

          row.innerHTML = `
            <div class="w-8 text-center text-gray-400 font-medium">${index + 1}</div>
            <div class="w-24">
              <span class="inline-block px-1.5 py-0.5 rounded bg-gray-100 font-bold text-gray-700 text-[11px] font-mono">
                ${item.productCode || 'SP'}
              </span>
            </div>
            <div class="flex-1 px-2">
              <div class="font-bold text-gray-900 flex items-center gap-1">
                <span>${item.productName || 'Hàng hóa'}</span>
                <span class="text-blue-500" title="Đã đồng bộ">✓</span>
              </div>
              <div class="text-[11px] text-gray-500 flex items-center gap-2 mt-0.5">
                <span>${item.typeName || 'Tiêu chuẩn'}</span>
                <button type="button" class="btn-toggle-condition px-1.5 py-0.5 rounded text-[10.5px] font-semibold cursor-pointer border ${item.condition === 'NEW' ? 'bg-emerald-50 text-emerald-700 border-emerald-200 hover:bg-emerald-100' : 'bg-amber-50 text-amber-700 border-amber-200 hover:bg-amber-100'}" data-idx="${index}" title="Bấm để đổi Mới ⇄ Cũ">
                  ${item.condition === 'NEW' ? 'Mới 100% ⇄' : 'Cũ QSD ⇄'}
                </button>
                ${item.programCode ? `
                  <span class="text-gray-300">&bull;</span>
                  <button type="button" class="btn-change-unit px-1.5 py-0.5 rounded bg-purple-100 hover:bg-purple-200 text-purple-800 font-mono font-bold text-[10.5px] cursor-pointer" data-idx="${index}" title="Bấm để đổi sang mã khác">
                    Mã bộ: ${item.programCode} ⇄
                  </button>
                ` : (item.hasSerial ? `
                  <span class="text-gray-300">&bull;</span>
                  <button type="button" class="btn-change-unit px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 font-medium text-[10.5px] border border-amber-200" data-idx="${index}">
                    Chọn mã khi giao
                  </button>
                ` : '')}
              </div>
            </div>
            <div class="w-28 flex items-center justify-center gap-1">
              ${isGameProgram && item.programCode ? `
                <span class="font-bold text-gray-700 px-2 text-xs">1</span>
              ` : `
                <button type="button" class="btn-qty-minus w-6 h-6 rounded bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold flex items-center justify-center cursor-pointer" data-idx="${index}">-</button>
                <input type="text" class="input-qty w-10 h-6 text-center border border-gray-300 rounded font-bold text-xs" data-idx="${index}" value="${item.quantity}" />
                <button type="button" class="btn-qty-plus w-6 h-6 rounded bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold flex items-center justify-center cursor-pointer" data-idx="${index}">+</button>
              `}
            </div>
            <div class="w-28 text-right pr-2">
              <input type="text" ${!authority.price ? 'disabled' : ''} class="input-price w-24 h-6 text-right px-1 border border-transparent hover:border-gray-300 focus:border-blue-400 rounded font-semibold text-gray-800 text-xs" data-idx="${index}" value="${formatNum(item.unitPrice)}" />
            </div>
            <div class="w-32 text-right pr-2 font-bold text-gray-900 tabular-nums text-[13px]">
              ${formatNum(lineTotal)}
            </div>
            <div class="w-8 text-center">
              <button type="button" class="btn-remove-item text-gray-400 hover:text-red-500 font-bold px-1.5 py-1 cursor-pointer" data-idx="${index}">
                🗑
              </button>
            </div>
          `;

          if (tab.orderType === 'FULFILL_PREORDER') {
            row.querySelectorAll('.btn-toggle-condition,.btn-qty-minus,.btn-qty-plus,.input-qty,.input-price,.btn-remove-item').forEach(control => { control.disabled = true; control.title = 'Giữ hàng, số lượng và giá đã đặt; chỉ chọn serial khi xuất bán.'; });
          }
          listEl.appendChild(row);
        });

        // Bắt sự kiện trên từng hàng
        listEl.querySelectorAll('.btn-qty-plus').forEach(b => {
          b.addEventListener('click', (e) => {
            const idx = Number(e.currentTarget.dataset.idx);
            tab.items[idx].quantity += 1;
            renderCartItems();
          });
        });

        listEl.querySelectorAll('.btn-qty-minus').forEach(b => {
          b.addEventListener('click', (e) => {
            const idx = Number(e.currentTarget.dataset.idx);
            if (tab.items[idx].quantity > 1) {
              tab.items[idx].quantity -= 1;
            } else {
              tab.items.splice(idx, 1);
            }
            renderCartItems();
          });
        });

        listEl.querySelectorAll('.input-qty').forEach(inp => {
          inp.addEventListener('change', (e) => {
            const idx = Number(e.currentTarget.dataset.idx);
            const val = parseNum(e.currentTarget.value);
            if (!Number.isSafeInteger(val) || val < 1) { showToast('Số lượng phải là số nguyên dương.', 'error'); renderCartItems(); return; }
            tab.items[idx].quantity = val;
            renderCartItems();
          });
        });

        listEl.querySelectorAll('.input-price').forEach(inp => {
          inp.addEventListener('change', (e) => {
            const idx = Number(e.currentTarget.dataset.idx);
            const val = parseNum(e.currentTarget.value);
            if (!Number.isSafeInteger(val)) { showToast('Đơn giá không hợp lệ.', 'error'); renderCartItems(); return; }
            tab.items[idx].unitPrice = val;
            renderCartItems();
          });
        });

        listEl.querySelectorAll('.btn-remove-item').forEach(b => {
          b.addEventListener('click', (e) => {
            const idx = Number(e.currentTarget.dataset.idx);
            tab.items.splice(idx, 1);
            renderCartItems();
          });
        });

        // Đổi mã bộ cho dòng hàng đã có trong giỏ
        listEl.querySelectorAll('.btn-change-unit').forEach(b => {
          b.addEventListener('click', (e) => {
            const idx = Number(e.currentTarget.dataset.idx);
            const it = tab.items[idx];
            const p = products.find(prod => prod.id === it.productId);
            if (p) {
              openUnitModal(p, (newUnit) => {
                it.productUnitId = newUnit.id;
                it.programCode = newUnit.program_code;
                if (tab.orderType !== 'FULFILL_PREORDER') it.condition = newUnit.condition || 'NEW';
                const typ = productTypes.find(t => t.id === newUnit.product_type_id);
                if (typ && tab.orderType !== 'FULFILL_PREORDER') {
                  it.productTypeId = typ.id;
                  it.typeName = typ.name;
                  it.unitPrice = catalogPrice(p,typ,it.condition);
                }
                renderCartItems();
                showToast(`Đã đổi sang mã bộ: ${newUnit.program_code}`);
              }, tab.orderType === 'FULFILL_PREORDER' ? it : null);
            }
          });
        });

        // Đổi tình trạng Mới <-> Cũ cho dòng hàng trong giỏ
        listEl.querySelectorAll('.btn-toggle-condition').forEach(b => {
          b.addEventListener('click', (e) => {
            const idx = Number(e.currentTarget.dataset.idx);
            const it = tab.items[idx];
            const p = products.find(prod => prod.id === it.productId);
            if (it.condition === 'NEW') {
              it.condition = 'QSD';
              if (p) {
                it.unitPrice = catalogPrice(p,productTypes.find(t=>t.id===it.productTypeId),it.condition);
              }
              showToast(`Đã chuyển sang Hàng Cũ (QSD)`, 'info');
            } else {
              it.condition = 'NEW';
              if (p) {
                it.unitPrice = catalogPrice(p,productTypes.find(t=>t.id===it.productTypeId),it.condition);
              }
              showToast(`Đã chuyển sang Hàng Mới 100%`, 'info');
            }
            renderCartItems();
          });
        });

        updateCartSummary(tab);
      };

      // TÍNH TOÁN VÀ CẬP NHẬT TỔNG TIỀN
      const updateCartSummary = (tab) => {
        let itemCount = 0;
        let grossAmount = 0;

        tab.items.forEach(it => {
          itemCount += it.quantity;
          grossAmount += (it.quantity * it.unitPrice) - (it.discount || 0);
        });

        const netAmount = tab.orderType === 'FULFILL_PREORDER' ? initialPreorderData.amount_total_cents : Math.max(0, grossAmount - tab.discount) + (tab.mode === 'delivery' ? parseNum(document.getElementById('shipFeeInput')?.value || 0) : 0);

        // Hiển thị ở thanh footer trái
        document.getElementById('summaryItemCount').innerText = itemCount;
        document.getElementById('summaryGrossAmount').innerText = formatNum(grossAmount);
        document.getElementById('summaryDiscountText').innerText = formatNum(tab.discount);
        document.getElementById('summaryNetAmount').innerText = formatNum(netAmount);

        // Hiển thị bên panel Bán nhanh
        document.getElementById('quickGrossAmount').innerText = formatNum(grossAmount);
        document.getElementById('quickNetAmount').innerText = formatNum(netAmount);
        
        // Xử lý hiển thị theo loại Tab (Bán hàng vs Đặt hàng vs Xử lý đặt hàng)
        const isPreorder = tab.orderType === 'PREORDER' || tab.shipment?.orderType === 'PREORDER';
        const isFulfill = tab.orderType === 'FULFILL_PREORDER';
        const depositPaid = tab.depositPaid || 0;
        const remainingToPay = Math.max(0, netAmount - depositPaid);

        // Khối hiển thị tiền cọc (chỉ hiện khi Xử lý đơn đặt hàng)
        const depRow = document.getElementById('preorderDepositRow');
        if (depRow) {
          if (isFulfill) {
            depRow.classList.remove('hidden');
            const depEl = document.getElementById('quickDepositAmount');
            if (depEl) depEl.innerText = formatNum(depositPaid);
            const remEl = document.getElementById('quickRemainingAmount');
            if (remEl) remEl.innerText = formatNum(remainingToPay);
          } else {
            depRow.classList.add('hidden');
          }
        }

        // Cập nhật số tiền khách thanh toán
        const paidInput = document.getElementById('quickPaidInput');
        if (paidInput) {
          if (isPreorder) {
            // Đặt hàng: Mặc định là 0 (chuẩn KiotViet)
            if (tab.paid === undefined || tab.paid === null) {
              tab.paid = 0;
            }
            paidInput.value = formatNum(tab.paid);
          } else if (isFulfill) {
            // Xử lý đặt hàng: Mặc định là số tiền còn lại
            if (tab.paid === undefined || tab.paid === null) {
              tab.paid = remainingToPay;
            }
            paidInput.value = formatNum(tab.paid);
          } else {
            // Bán hàng: Mặc định là đủ tiền netAmount
            if (!tab.paidTouched || tab.paid === undefined || tab.paid === null) {
              tab.paid = netAmount;
            }
            paidInput.value = formatNum(tab.paid);
          }
        }
        updateQuickChange(tab, netAmount);

        // Render gợi ý mệnh giá tiền mặt làm tròn thông minh chuẩn KiotViet
        const denomTarget = isFulfill ? remainingToPay : netAmount;
        renderDenominations(denomTarget);

        // Cập nhật bên panel Bán giao hàng
        const codInput = document.getElementById('shipCodAmountInput');
        const enableCod = document.getElementById('enableCodCheckbox')?.checked ?? true;
        if (codInput) {
          const prepaid = parseNum(document.getElementById('shipPrepaidAmountInput')?.value || 0);
          const autoCod = enableCod ? Math.max(0, netAmount - prepaid) : 0;
          codInput.value = formatNum(autoCod);
          tab.shipment.codAmount = autoCod;
        }
      };

      const updateQuickChange = (tab, netAmount) => {
        const changeEl = document.getElementById('quickChangeAmount');
        if (!changeEl) return;
        const isFulfill = tab.orderType === 'FULFILL_PREORDER';
        const needed = isFulfill ? Math.max(0, netAmount - (tab.depositPaid || 0)) : netAmount;
        const currentPaid = tab.paid ?? 0;
        const change = currentPaid - needed;
        if (change < 0) {
          changeEl.innerText = '- ' + formatNum(Math.abs(change));
          changeEl.className = 'font-bold text-gray-800 text-sm tabular-nums';
        } else {
          changeEl.innerText = formatNum(change);
          changeEl.className = 'font-bold text-emerald-600 text-sm tabular-nums';
        }
      };

      // GỢI Ý MỆNH GIÁ TIỀN MẶT (LÀM TRÒN THÔNG MINH THEO MỆNH GIÁ VNĐ CHUẨN KIOTVIET)
      const renderDenominations = (total) => {
        const container = document.getElementById('denominationSuggestions');
        if (!container) return;
        container.innerHTML = '';

        if (total <= 0) return;

        const suggestions = new Set([total]);
        if (total < 1000000) {
          suggestions.add(Math.ceil((total + 1) / 10000) * 10000);
          suggestions.add(Math.ceil((total + 1) / 50000) * 50000);
          suggestions.add(Math.ceil((total + 1) / 100000) * 100000);
          suggestions.add(Math.ceil((total + 1) / 500000) * 500000);
        } else {
          suggestions.add(Math.ceil((total + 1) / 100000) * 100000);
          suggestions.add(Math.ceil((total + 1) / 200000) * 200000);
          suggestions.add(Math.ceil((total + 1) / 500000) * 500000);
          suggestions.add(Math.ceil((total + 1) / 1000000) * 1000000);
        }

        Array.from(suggestions).filter(x => x >= total).sort((a, b) => a - b).slice(0, 4).forEach(amt => {
          const pill = document.createElement('button');
          pill.type = 'button';
          pill.className = 'px-2.5 py-1 rounded bg-gray-100 hover:bg-blue-100 text-gray-800 text-xs font-semibold tabular-nums border border-gray-200 transition cursor-pointer';
          pill.innerText = formatNum(amt);
          pill.addEventListener('click', () => {
            const tab = getActiveTab();
            tab.paidTouched = true;
            tab.paid = amt;
            const paidInp = document.getElementById('quickPaidInput');
            if (paidInp) paidInp.value = formatNum(amt);
            const netAmount = Math.max(0, tab.items.reduce((s, it) => s + (it.quantity * it.unitPrice) - (it.discount || 0), 0) - tab.discount);
            updateQuickChange(tab, netAmount);
          });
          container.appendChild(pill);
        });
      };

      // MODAL CHỌN MÃ BỘ / SERIAL (REQUIREMENT 1)
      const unitModal = document.getElementById('unitSelectionModal');
      const unitModalTitle = document.getElementById('unitModalProductTitle');
      const unitModalSubtitle = document.getElementById('unitModalProductSubtitle');
      const unitModalCount = document.getElementById('unitModalStockCount');
      const unitModalList = document.getElementById('unitModalList');
      const unitSearchInput = document.getElementById('unitSearchInput');
      let currentUnitSelectCallback = null;
      let currentModalProductUnits = [];

      function openUnitModal(product, onSelectUnit, constraint = null) {
        currentUnitSelectCallback = onSelectUnit;
        const tab = getActiveTab();
        const isPreorder = tab.orderType === 'PREORDER' || tab.shipment?.orderType === 'PREORDER';

        // Lọc tất cả mã bộ còn tồn kho của sản phẩm này (loại trừ các mã đã có trong giỏ hàng hiện tại)
        currentModalProductUnits = inStockUnits.filter(u => 
          u.product_id === product.id && (!constraint || (u.product_type_id === constraint.productTypeId && u.condition === constraint.condition)) && !tab.items.some(it => it.productUnitId === u.id)
        );

        if (currentModalProductUnits.length === 0) {
          if (isPreorder) {
            // Cho phép đặt hàng trước khi hết mã bộ trong kho
            const defaultType = productTypes.find(typ => typ.product_id === product.id);
            if (currentUnitSelectCallback) {
              currentUnitSelectCallback({
                product_type_id: defaultType?.id || null,
                id: null,
                program_code: null,
                condition: 'NEW'
              });
            }
            showToast(`Đã thêm đặt trước "${product.name}" (Sẽ gán mã bộ khi giao hàng)`, 'info');
            return;
          }
          showToast(`Sản phẩm "${product.name}" hiện không còn mã bộ nào trong kho (IN_STOCK)!`, 'error');
          alert(`Sản phẩm "${product.name}" hiện không còn mã bộ nào trong kho! Vui lòng chuyển sang chế độ "Đặt hàng" nếu muốn nhận đơn đặt trước.`);
          return;
        }

        if (unitModalTitle) unitModalTitle.innerText = `Chọn Mã Bộ: ${product.name}`;
        if (unitModalSubtitle) unitModalSubtitle.innerText = `Mã SP: ${product.product_code || 'CODE'} • Vui lòng chọn đúng mã bo mạch xuất kho`;
        if (unitSearchInput) unitSearchInput.value = '';

        renderUnitModalList(currentModalProductUnits, product);
        unitModal?.classList.remove('hidden');
        unitSearchInput?.focus();
      }

      function closeUnitModal() {
        unitModal?.classList.add('hidden');
        currentUnitSelectCallback = null;
        searchInput?.focus();
      }

      function renderUnitModalList(unitsList, product) {
        if (!unitModalList) return;
        if (unitModalCount) unitModalCount.innerText = unitsList.length;

        unitModalList.innerHTML = '';

        // Nếu đang ở tab Đặt hàng: Cho phép tùy chọn đặt hàng không chọn mã bộ cụ thể
        const tab = getActiveTab();
        const isPreorder = tab.orderType === 'PREORDER' || tab.shipment?.orderType === 'PREORDER';
        if (isPreorder) {
          const skipCard = document.createElement('div');
          skipCard.className = 'p-3 rounded-lg border-2 border-dashed border-amber-300 bg-amber-50/70 hover:bg-amber-100 transition cursor-pointer flex items-center justify-between mb-2 text-xs font-bold text-amber-900';
          skipCard.innerHTML = `
            <div class="flex items-center gap-2">
              <span class="text-base">📋</span>
              <span>Đặt trước không chỉ định mã bộ (Chờ hàng về gán sau)</span>
            </div>
            <span class="text-[11px] text-amber-700 underline font-semibold">Chọn tùy chọn này ➔</span>
          `;
          skipCard.addEventListener('click', () => {
            if (currentUnitSelectCallback) {
              const defaultType = productTypes.find(typ => typ.product_id === product.id);
              currentUnitSelectCallback({
                product_type_id: defaultType?.id || null,
                id: null,
                program_code: null,
                condition: 'NEW'
              });
            }
            closeUnitModal();
          });
          unitModalList.appendChild(skipCard);
        }

        if (unitsList.length === 0 && !isPreorder) {
          unitModalList.innerHTML = '<div class="p-6 text-center text-gray-400 text-xs">Không tìm thấy mã bộ phù hợp</div>';
          return;
        }

        unitModalList.innerHTML = '';
        unitsList.forEach(u => {
          const t = productTypes.find(typ => typ.id === u.product_type_id);
          const price = t?.sale_price_cents || product?.price_cents || 0;
          const card = document.createElement('div');
          card.className = 'p-3 rounded-lg border border-gray-200 hover:border-blue-500 hover:bg-blue-50/70 transition cursor-pointer flex items-center justify-between group';
          
          card.innerHTML = `
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded bg-purple-100 text-purple-800 font-mono font-bold text-xs">
                  ${u.program_code}
                </span>
                <span class="text-xs font-semibold text-gray-800">${t?.name || 'Tiêu chuẩn'}</span>
                <span class="px-1.5 py-0.2 text-[10.5px] rounded font-medium ${u.condition === 'NEW' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}">
                  ${u.condition === 'NEW' ? 'Mới 100%' : 'Cũ QSD'}
                </span>
              </div>
              <div class="text-[11px] text-gray-500">
                ${u.expiry_date ? `Hạn bảo hành: ${u.expiry_date}` : (u.expiry_days ? `Bảo hành: ${u.expiry_days} ngày` : 'Sẵn sàng bán')}
              </div>
            </div>
            <div class="text-right">
              <span class="font-bold text-blue-700 text-xs tabular-nums">${formatNum(price)} đ</span>
              <span class="block text-[11px] text-blue-600 font-medium group-hover:underline mt-0.5">Chọn mã này ➔</span>
            </div>
          `;

          card.addEventListener('click', () => {
            if (currentUnitSelectCallback) {
              currentUnitSelectCallback(u);
            }
            closeUnitModal();
          });

          unitModalList.appendChild(card);
        });
      }

      unitSearchInput?.addEventListener('input', (e) => {
        const q = e.target.value.trim().toLowerCase();
        const filtered = currentModalProductUnits.filter(u => 
          u.program_code && u.program_code.toLowerCase().includes(q)
        );
        renderUnitModalList(filtered);
      });

      document.getElementById('closeUnitModalBtn')?.addEventListener('click', closeUnitModal);
      document.getElementById('cancelUnitModalBtn')?.addEventListener('click', closeUnitModal);

      // Thêm sản phẩm vào giỏ hàng
      function addProductToCart(item) {
        const tab = getActiveTab();
        // Nếu là hàng có mã bộ (unit) cụ thể thì không gộp số lượng
        if (item.productUnitId) {
          const exists = tab.items.find(it => it.productUnitId === item.productUnitId);
          if (exists) {
            showToast('Mã bộ này đã có trong đơn hàng!', 'error');
            return;
          }
          tab.items.push(item);
        } else {
          // Hàng số lượng thông thường: gộp dòng nếu trùng ID và loại
          const existing = tab.items.find(it => it.productId === item.productId && it.productTypeId === item.productTypeId && it.condition === item.condition);
          if (existing) {
            existing.quantity += 1;
          } else {
            tab.items.push(item);
          }
        }
        renderCartItems();
      }

      // 3. TÌM KIẾM VÀ THÊM SẢN PHẨM VÀO HÓA ĐƠN
      const searchInput = document.getElementById('productSearchInput');
      const searchResults = document.getElementById('productSearchResults');
      const clearSearchBtn = document.getElementById('clearSearchBtn');

      searchInput?.addEventListener('input', (e) => {
        const qRaw = e.target.value.trim();
        const q = qRaw.toLowerCase();
        if (!q) {
          searchResults.classList.add('hidden');
          clearSearchBtn?.classList.add('hidden');
          return;
        }

        clearSearchBtn?.classList.remove('hidden');

        // Tìm sản phẩm thường và sản phẩm máy
        const matched = products.filter(p => 
          (p.name && p.name.toLowerCase().includes(q)) ||
          (p.product_code && p.product_code.toLowerCase().includes(q))
        ).slice(0, 8);

        // Tìm theo mã bộ (program_code / serial)
        const matchedUnits = inStockUnits.filter(u => 
          u.program_code && u.program_code.toLowerCase().includes(q)
        ).slice(0, 5);

        // Dòng tạo nhanh hàng hóa chuẩn KiotViet luôn xuất hiện dưới cùng
        const addNewDiv = document.createElement('div');
        addNewDiv.className = 'p-2.5 bg-blue-50 hover:bg-blue-100 text-blue-700 font-bold cursor-pointer text-xs flex items-center justify-between border-t border-blue-200 transition select-none';
        addNewDiv.innerHTML = `
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-blue-600 text-white flex items-center justify-center font-extrabold text-xs shadow-xs">+</span>
            <span>Thêm mới hàng hóa <strong class="text-blue-900">"${qRaw}"</strong></span>
          </div>
          <span class="text-[11px] text-blue-600 underline font-medium">Mở form KiotViet &rarr;</span>
        `;
        addNewDiv.addEventListener('click', () => {
          searchResults.classList.add('hidden');
          clearSearchBtn?.classList.add('hidden');
          if (typeof window.openQuickProductModal === 'function') {
            window.openQuickProductModal(qRaw);
          }
        });

        if (matched.length === 0 && matchedUnits.length === 0) {
          searchResults.innerHTML = `<div class="p-3 text-gray-500 text-center text-xs">Không tìm thấy hàng hóa nào phù hợp với từ khóa "<strong>${qRaw}</strong>"</div>`;
          searchResults.appendChild(addNewDiv);
          searchResults.classList.remove('hidden');
          return;
        }

        searchResults.innerHTML = '';

        // Hiển thị mã bộ trước (nếu người dùng gõ mã bộ cụ thể)
        matchedUnits.forEach(u => {
          const p = products.find(prod => prod.id === u.product_id);
          const t = productTypes.find(typ => typ.id === u.product_type_id);
          const itemDiv = document.createElement('div');
          itemDiv.className = 'p-2.5 hover:bg-blue-50 cursor-pointer flex items-center justify-between transition border-l-4 border-purple-500';
          itemDiv.innerHTML = `
            <div>
              <div class="font-bold text-gray-900 text-xs flex items-center gap-1.5">
                <span class="px-1.5 py-0.5 rounded bg-purple-100 text-purple-800 font-mono font-bold text-[10.5px]">MÃ BỘ: ${u.program_code}</span>
                <span>${p?.name || 'Máy Game'}</span>
              </div>
              <div class="text-[11px] text-gray-500 mt-0.5">
                ${t?.name || 'Tiêu chuẩn'} &bull; ${u.condition === 'NEW' ? 'Mới 100%' : 'Cũ QSD'}
              </div>
            </div>
            <div class="text-right">
              <span class="font-bold text-[#0070d2] text-xs">${formatNum(t?.sale_price_cents || p?.price_cents || 0)}</span>
            </div>
          `;
          itemDiv.addEventListener('click', () => {
            addProductToCart({
              productId: p?.id || u.product_id,
              productTypeId: u.product_type_id,
              productUnitId: u.id,
              programCode: u.program_code,
              productCode: p?.product_code || 'CODE',
              productName: p?.name || 'Máy Game',
              typeName: t?.name || 'Tiêu chuẩn',
              condition: u.condition || 'NEW',
              unitPrice: t?.sale_price_cents || p?.price_cents || 0,
              quantity: 1,
              discount: 0,
              hasSerial: true
            });
            searchInput.value = '';
            searchResults.classList.add('hidden');
            clearSearchBtn?.classList.add('hidden');
            searchInput.focus();
          });
          searchResults.appendChild(itemDiv);
        });

        // Hiển thị sản phẩm thông thường
        matched.forEach(p => {
          const itemDiv = document.createElement('div');
          itemDiv.className = 'p-2.5 hover:bg-blue-50 cursor-pointer flex items-center justify-between transition';
          const isUsedOnly = (p.price_used_cents > 0 && (!p.price_cents || p.price_cents === 0)) || (p.stock_used > 0 && (!p.stock_new || p.stock_new === 0));
          const hasDualPrice = p.price_cents > 0 && p.price_used_cents > 0;
          const displayPrice = isUsedOnly ? (p.price_used_cents || 0) : (p.price_cents || p.price_used_cents || 0);
          const defaultCondition = isUsedOnly ? 'QSD' : 'NEW';
          const defaultPrice = isUsedOnly ? (p.price_used_cents || 0) : (p.price_cents || p.price_used_cents || 0);
          const isCodeProduct = p.has_serial === 1 || p.tracking_mode === 'CODE';

          itemDiv.innerHTML = `
            <div>
              <div class="font-bold text-gray-900 text-xs flex items-center gap-1.5">
                <span class="font-mono text-gray-500 text-[11px]">${p.product_code || 'SP'}</span>
                <span>${p.name}</span>
                ${isCodeProduct ? '<span class="px-1.5 py-0.2 rounded bg-purple-50 text-purple-700 font-medium text-[10px] border border-purple-200">Quản lý theo mã bộ</span>' : ''}
                ${isUsedOnly ? '<span class="px-1.5 py-0.2 rounded bg-amber-100 text-amber-800 font-bold text-[10px]">Cũ (QSD)</span>' : ''}
              </div>
              <div class="text-[11px] text-gray-500 mt-0.5">
                ${isUsedOnly 
                  ? `Tồn cũ: <strong class="${(p.stock_used || 0) > 0 ? 'text-amber-700' : 'text-red-500'}">${p.stock_used ?? 0}</strong> ${p.unit_name || 'cái'}` 
                  : (p.stock_new > 0 && p.stock_used > 0)
                    ? `Tồn: <strong class="text-emerald-700">${p.stock_new} Mới</strong> • <strong class="text-amber-700">${p.stock_used} Cũ</strong>`
                    : `Tồn: <strong class="${(p.stock || 0) > 0 ? 'text-gray-700' : 'text-red-500'}">${p.stock ?? 0}</strong> ${p.unit_name || 'cái'}`
                }
                ${p.category_name ? `&bull; ${p.category_name}` : ''}
              </div>
            </div>
            <div class="text-right">
              ${hasDualPrice ? `
                <div class="font-bold text-[#0070d2] text-xs">${formatNum(p.price_cents)} <span class="text-[10px] text-gray-400 font-normal">Mới</span></div>
                <div class="font-bold text-amber-700 text-[11px]">${formatNum(p.price_used_cents)} <span class="text-[10px] text-amber-600 font-normal">Cũ</span></div>
              ` : isUsedOnly ? `
                <span class="font-bold text-amber-700 text-xs">${formatNum(displayPrice)}</span>
                <span class="text-[10px] text-amber-700 font-semibold block">Cũ</span>
              ` : `
                <span class="font-bold text-[#0070d2] text-xs">${formatNum(displayPrice)}</span>
              `}
            </div>
          `;

          // XỬ LÝ CHỌN HÀNG HÓA VÀO ĐƠN (HỖ TRỢ ĐẶT HÀNG KHI HẾT TỒN KHO)
          itemDiv.addEventListener('click', () => {
            const currentTab = getActiveTab();
            const isTabPreorder = currentTab.orderType === 'PREORDER' || currentTab.shipment?.orderType === 'PREORDER';

            if (isCodeProduct) {
              const availableUnits = inStockUnits.filter(u => u.product_id === p.id);
              if (isTabPreorder && availableUnits.length === 0) {
                // Đặt hàng trước máy game / linh kiện serial khi KHO HẾT MÃ BỘ
                const defaultType = productTypes.find(t => t.product_id === p.id);
                addProductToCart({
                  productId: p.id,
                  productTypeId: defaultType?.id || null,
                  productUnitId: null,
                  programCode: null,
                  productCode: p.product_code || 'CODE',
                  productName: p.name,
                  typeName: defaultType?.name || 'Tiêu chuẩn',
                  condition: defaultCondition,
                  unitPrice: catalogPrice(p,defaultType,isUsedOnly?'QSD':'NEW'),
                  quantity: 1,
                  discount: 0,
                  hasSerial: true
                });
                showToast(`Đã thêm đặt trước "${p.name}" (Chờ gán mã bộ khi giao hàng)`, 'info');
              } else {
                openUnitModal(p, (selectedUnit) => {
                  const t = productTypes.find(typ => typ.id === selectedUnit?.product_type_id);
                  const unitPrice = selectedUnit?.condition === 'QSD' ? (p.price_used_cents || t?.sale_price_cents || defaultPrice) : (t?.sale_price_cents || defaultPrice);
                  addProductToCart({
                    productId: p.id,
                    productTypeId: selectedUnit?.product_type_id || null,
                    productUnitId: selectedUnit?.id || null,
                    programCode: selectedUnit?.program_code || null,
                    productCode: p.product_code,
                    productName: p.name,
                    typeName: t?.name || 'Tiêu chuẩn',
                    condition: selectedUnit?.condition || defaultCondition,
                    unitPrice: unitPrice,
                    quantity: 1,
                    discount: 0,
                    hasSerial: true
                  });
                });
              }
            } else {
              // Hàng thông thường: cho phép đặt trước thoải mái kể cả khi tồn = 0
              const defaultType = productTypes.find(t => t.product_id === p.id);
              addProductToCart({
                productId: p.id,
                productTypeId: defaultType?.id || null,
                productUnitId: null,
                programCode: null,
                productCode: p.product_code,
                productName: p.name,
                typeName: defaultType?.name || 'Tiêu chuẩn',
                condition: defaultCondition,
                unitPrice: catalogPrice(p,defaultType,isUsedOnly?'QSD':'NEW'),
                quantity: 1,
                discount: 0,
                hasSerial: false
              });
            }

            searchInput.value = '';
            searchResults.classList.add('hidden');
            clearSearchBtn?.classList.add('hidden');
          });

          searchResults.appendChild(itemDiv);
        });

        // Luôn gắn dòng tạo mới sản phẩm chuẩn KiotViet ở đáy dropdown
        searchResults.appendChild(addNewDiv);
        searchResults.classList.remove('hidden');
      });

      clearSearchBtn?.addEventListener('click', () => {
        searchInput.value = '';
        searchResults.classList.add('hidden');
        clearSearchBtn.classList.add('hidden');
        searchInput.focus();
      });

      // 4. CHỌN KHÁCH HÀNG & TÌM KIẾM KHÁCH HÀNG THỐNG NHẤT (REQUIREMENT 3)
      const custSearchInput = document.getElementById('customerSearchInput');
      const custSearchResults = document.getElementById('customerSearchResults');
      const custSelectedBox = document.getElementById('customerSelectedBox');
      const custSearchWrapper = document.getElementById('customerSearchInputWrapper');

      custSearchInput?.addEventListener('input', (e) => {
        const q = e.target.value.trim().toLowerCase();
        if (!q) {
          custSearchResults.classList.add('hidden');
          return;
        }

        const matched = customers.filter(c => 
          (c.name && c.name.toLowerCase().includes(q)) ||
          (c.phone && c.phone.includes(q)) ||
          (c.customer_code && c.customer_code.toLowerCase().includes(q)) ||
          (c.province && c.province.toLowerCase().includes(q)) ||
          (c.ward && c.ward.toLowerCase().includes(q)) ||
          (c.address && c.address.toLowerCase().includes(q))
        ).slice(0, 8);

        if (matched.length === 0) {
          custSearchResults.innerHTML = '<div class="p-3 text-gray-400 text-center text-xs">Không tìm thấy khách hàng nào</div>';
          custSearchResults.classList.remove('hidden');
          return;
        }

        custSearchResults.innerHTML = '';
        matched.forEach(c => {
          const itemDiv = document.createElement('div');
          itemDiv.className = 'p-2.5 hover:bg-blue-50 cursor-pointer flex items-center justify-between transition text-xs';
          const debt = c.current_debt_cents || 0;
          const fullAddr = c.address || [c.address_detail, c.ward, c.province].filter(Boolean).join(', ');

          itemDiv.innerHTML = `
            <div class="space-y-0.5 truncate pr-2">
              <div class="flex items-center gap-1.5">
                <span class="font-mono text-[10.5px] font-bold text-blue-600">${c.customer_code || 'KH#' + c.id}</span>
                <span class="font-bold text-gray-900">${c.name}</span>
              </div>
              <div class="text-gray-500 text-[11px]">${c.phone || 'Chưa có SĐT'}</div>
              ${fullAddr ? `<div class="text-gray-400 text-[10.5px] truncate max-w-xs">📍 ${fullAddr}</div>` : ''}
            </div>
            <div class="text-right shrink-0">
              ${debt > 0 ? `<span class="px-1.5 py-0.5 rounded bg-red-100 text-red-700 font-bold text-[10.5px]">Nợ: ${formatNum(debt)}</span>` : '<span class="text-emerald-600 text-[11px]">Không nợ</span>'}
            </div>
          `;
          itemDiv.addEventListener('click', () => {
            selectCustomerForTab(c);
            custSearchResults.classList.add('hidden');
            custSearchInput.value = '';
          });
          custSearchResults.appendChild(itemDiv);
        });

        custSearchResults.classList.remove('hidden');
      });

      const selectCustomerForTab = (c) => {
        const tab = getActiveTab();
        tab.customerId = c.id;
        tab.customerCode = c.customer_code || `KH#${c.id}`;
        tab.customerName = c.name;
        tab.customerPhone = c.phone || '';
        const fullAddr = c.address || [c.address_detail, c.ward, c.province].filter(Boolean).join(', ');
        tab.customerAddress = fullAddr;
        tab.customerDebt = c.current_debt_cents || 0;
        tab.customerCredit = c.customer_credit_cents || 0;

        // Đồng bộ 100% sang thông tin nhận hàng của Bán giao hàng
        tab.shipment.receiverName = c.name;
        tab.shipment.receiverPhone = c.phone || '';
        tab.shipment.receiverAddress = fullAddr;

        renderCustomerView(tab);
      };

      const renderCustomerView = (tab) => {
        const creditLabel = document.querySelector('#lblMethodCredit span');
        if (creditLabel) creditLabel.innerText = `Số dư khách: ${formatNum(tab.customerCredit || 0)}`;
        if (tab.customerId) {
          custSearchWrapper.classList.add('hidden');
          custSelectedBox.classList.remove('hidden');

          document.getElementById('custBoxCode').innerText = tab.customerCode || 'KH';
          document.getElementById('custBoxName').innerText = tab.customerName;
          document.getElementById('custBoxPhone').innerText = tab.customerPhone ? `📞 ${tab.customerPhone}` : 'Chưa có SĐT';
          
          const debtBadge = document.getElementById('custBoxDebtBadge');
          if (tab.customerDebt > 0) {
            debtBadge.classList.remove('hidden');
            debtBadge.innerText = `Nợ: ${formatNum(tab.customerDebt)}`;
          } else {
            debtBadge.classList.add('hidden');
          }

          const addrRow = document.getElementById('custBoxAddressRow');
          const addrEl = document.getElementById('custBoxAddress');
          if (tab.customerAddress) {
            addrRow?.classList.remove('hidden');
            if (addrEl) addrEl.innerText = tab.customerAddress;
          } else {
            addrRow?.classList.add('hidden');
          }

          // Cập nhật trường giao hàng tự động
          document.getElementById('shipReceiverName').value = tab.customerName;
          document.getElementById('shipReceiverPhone').value = tab.customerPhone;
          document.getElementById('shipReceiverAddress').value = tab.customerAddress;
          
          const deliveryDebtText = document.getElementById('deliveryCustDebtText');
          if (deliveryDebtText) {
            deliveryDebtText.innerText = tab.customerDebt > 0 ? `(Nợ cũ: ${formatNum(tab.customerDebt)})` : '';
          }
        } else {
          custSearchWrapper.classList.remove('hidden');
          custSelectedBox.classList.add('hidden');
          document.getElementById('shipReceiverName').value = '';
          document.getElementById('shipReceiverPhone').value = '';
          document.getElementById('shipReceiverAddress').value = '';
          const deliveryDebtText = document.getElementById('deliveryCustDebtText');
          if (deliveryDebtText) deliveryDebtText.innerText = '';
        }
      };

      document.getElementById('removeCustomerBtn')?.addEventListener('click', () => {
        const tab = getActiveTab();
        tab.customerId = null;
        tab.customerCode = '';
        tab.customerName = '';
        tab.customerPhone = '';
        tab.customerAddress = '';
        tab.customerDebt = 0;
        tab.customerCredit = 0;
        renderCustomerView(tab);
      });

      // 5. CHUYỂN ĐỔI 2 CHẾ ĐỘ: ⚡ BÁN NHANH vs 🚚 BÁN GIAO HÀNG (NẰM PHÍA DƯỚI BÊN TRÁI)
      const quickPanel = document.getElementById('quickSalePanel');
      const deliveryPanel = document.getElementById('deliverySalePanel');
      const modeQuickBtn = document.getElementById('modeQuickSaleBtn');
      const modeDeliveryBtn = document.getElementById('modeDeliverySaleBtn');

      const setMode = (mode) => {
        const tab = getActiveTab();
        tab.mode = mode;

        if (mode === 'quick') {
          quickPanel.classList.remove('hidden');
          deliveryPanel.classList.add('hidden');
          modeQuickBtn.className = 'h-8 px-3 rounded-md flex items-center gap-1.5 text-xs font-bold transition bg-white text-[#0070d2] shadow-xs cursor-pointer';
          modeDeliveryBtn.className = 'h-8 px-3 rounded-md flex items-center gap-1.5 text-xs font-semibold text-gray-600 hover:text-gray-900 transition cursor-pointer';
        } else {
          quickPanel.classList.add('hidden');
          deliveryPanel.classList.remove('hidden');
          modeDeliveryBtn.className = 'h-8 px-3 rounded-md flex items-center gap-1.5 text-xs font-bold transition bg-white text-[#0070d2] shadow-xs cursor-pointer';
          modeQuickBtn.className = 'h-8 px-3 rounded-md flex items-center gap-1.5 text-xs font-semibold text-gray-600 hover:text-gray-900 transition cursor-pointer';
        }

        renderTabs();
        updateCartSummary(tab);
      };

      modeQuickBtn?.addEventListener('click', () => setMode('quick'));
      modeDeliveryBtn?.addEventListener('click', () => setMode('delivery'));

      // 6. GIAO HÀNG: CHUYỂN TAB TỰ GIAO / CHÀNH XE vs HÃNG VẬN CHUYỂN
      const tabShipSelfBtn = document.getElementById('tabShipSelfBtn');
      const tabShipIntegratedBtn = document.getElementById('tabShipIntegratedBtn');
      const shipSelfSec = document.getElementById('shipSelfSection');
      const shipIntegSec = document.getElementById('shipIntegratedSection');
      const switchToSelfShipBtn = document.getElementById('switchToSelfShipBtn');

      const setShippingTab = (type) => {
        if (type === 'self') {
          tabShipSelfBtn.className = 'flex-1 py-1.5 rounded-md bg-white text-[#0b4d9c] shadow-xs font-bold transition flex items-center justify-center gap-1.5 cursor-pointer';
          tabShipIntegratedBtn.className = 'flex-1 py-1.5 rounded-md text-gray-600 hover:text-gray-900 transition flex items-center justify-center gap-1.5 cursor-pointer';
          shipSelfSec.classList.remove('hidden');
          shipIntegSec.classList.add('hidden');
          getActiveTab().shipment.carrier = 'BUS';
        } else {
          tabShipIntegratedBtn.className = 'flex-1 py-1.5 rounded-md bg-white text-[#0b4d9c] shadow-xs font-bold transition flex items-center justify-center gap-1.5 cursor-pointer';
          tabShipSelfBtn.className = 'flex-1 py-1.5 rounded-md text-gray-600 hover:text-gray-900 transition flex items-center justify-center gap-1.5 cursor-pointer';
          shipIntegSec.classList.remove('hidden');
          shipSelfSec.classList.add('hidden');
        }
      };

      tabShipSelfBtn?.addEventListener('click', () => setShippingTab('self'));
      tabShipIntegratedBtn?.addEventListener('click', () => setShippingTab('integrated'));
      switchToSelfShipBtn?.addEventListener('click', () => setShippingTab('self'));

      // Bắt sự kiện đổi loại đơn: Xuất bán giao ngay / Đặt hàng
      document.querySelectorAll('input[name="deliveryOrderType"]').forEach(r => {
        r.addEventListener('change', (e) => {
          const type = e.target.value;
          getActiveTab().shipment.orderType = type;
          const submitText = document.getElementById('deliverySubmitText');
          if (submitText) {
            submitText.innerText = type === 'PREORDER' ? 'LƯU ĐẶT HÀNG (F9)' : 'TẠO ĐƠN & GIAO HÀNG (F9)';
          }
        });
      });

      // Bắt sự kiện đổi phương thức thanh toán bán nhanh
      document.querySelectorAll('input[name="quickPaymentMethod"]').forEach(r => {
        r.addEventListener('change', (e) => {
          const val = e.target.value;
          getActiveTab().paymentMethod = val;
          const cashLbl = document.getElementById('lblMethodCash');
          const bankLbl = document.getElementById('lblMethodBank');
          const cardLbl = document.getElementById('lblMethodCard');
          const creditLbl = document.getElementById('lblMethodCredit');

          [cashLbl, bankLbl, cardLbl, creditLbl].forEach(l => {
            l.className = 'flex items-center justify-center gap-1.5 p-2 rounded border border-gray-200 bg-white hover:bg-gray-50 text-gray-700 text-xs font-medium cursor-pointer transition';
          });

          if (val === 'CASH') cashLbl.className = 'flex items-center justify-center gap-1.5 p-2 rounded border border-blue-500 bg-blue-50 text-[#0b4d9c] text-xs font-bold cursor-pointer transition';
          if (val === 'BANK') bankLbl.className = 'flex items-center justify-center gap-1.5 p-2 rounded border border-blue-500 bg-blue-50 text-[#0b4d9c] text-xs font-bold cursor-pointer transition';
          if (val === 'CREDIT') creditLbl.className = 'flex items-center justify-center gap-1.5 p-2 rounded border border-blue-500 bg-blue-50 text-[#0b4d9c] text-xs font-bold cursor-pointer transition';
          if (val === 'CARD') cardLbl.className = 'flex items-center justify-center gap-1.5 p-2 rounded border border-blue-500 bg-blue-50 text-[#0b4d9c] text-xs font-bold cursor-pointer transition';
        });
      });

      // Bắt sự kiện nhập tiền giảm giá hóa đơn
      document.getElementById('quickDiscountInput')?.addEventListener('change', (e) => {
        const val = parseNum(e.target.value);
        if (!Number.isSafeInteger(val)) { showToast('Số tiền không hợp lệ.', 'error'); return; }
        const tab = getActiveTab();
        tab.discount = val;
        e.target.value = formatNum(val);
        updateCartSummary(tab);
      });

      // Bắt sự kiện khách thanh toán tiền mặt
      document.getElementById('quickPaidInput')?.addEventListener('change', (e) => {
        const val = parseNum(e.target.value);
        if (!Number.isSafeInteger(val)) { showToast('Số tiền không hợp lệ.', 'error'); return; }
        const tab = getActiveTab();
        if (!Number.isSafeInteger(val)) { showToast('Số tiền không hợp lệ.', 'error'); return; }
        tab.paidTouched = true;
        tab.paid = val;
        e.target.value = formatNum(val);
        const netAmount = Math.max(0, tab.items.reduce((s, it) => s + (it.quantity * it.unitPrice) - (it.discount || 0), 0) - tab.discount);
        updateQuickChange(tab, netAmount);
      });

      // Bắt sự kiện tiền trả trước bên giao hàng
      document.getElementById('shipPrepaidAmountInput')?.addEventListener('change', (e) => {
        const val = parseNum(e.target.value);
        if (!Number.isSafeInteger(val)) { showToast('Số tiền không hợp lệ.', 'error'); return; }
        e.target.value = formatNum(val);
        const tab = getActiveTab();
        tab.paid = val;
        updateCartSummary(tab);
      });

      document.getElementById('shipFeeInput')?.addEventListener('change', () => updateCartSummary(getActiveTab()));

      // Bật / tắt COD
      document.getElementById('enableCodCheckbox')?.addEventListener('change', (e) => {
        const tab = getActiveTab();
        updateCartSummary(tab);
      });

      // Render lại toàn bộ khi chuyển Tab
      const renderActiveTabContent = () => {
        const tab = getActiveTab();
        renderCartItems();
        renderCustomerView(tab);
        const creditLabel = document.querySelector('#lblMethodCredit span');
        if (creditLabel) creditLabel.innerText = `Số dư khách: ${formatNum(tab.customerCredit || 0)}`;
        setMode(tab.mode);
        document.querySelectorAll('input[name="quickPaymentMethod"]').forEach(r => {
          r.checked = r.value === (tab.paymentMethod || 'CASH');
          r.parentElement.className = r.checked ? 'flex items-center justify-center gap-1.5 p-2 rounded border border-blue-500 bg-blue-50 text-[#0b4d9c] text-xs font-bold cursor-pointer transition' : 'flex items-center justify-center gap-1.5 p-2 rounded border border-gray-200 bg-white text-gray-700 text-xs cursor-pointer transition';
        });
        document.getElementById('orderNoteInput').value = tab.note || '';
        document.getElementById('productSearchInput').disabled = tab.orderType === 'FULFILL_PREORDER';
        document.getElementById('quickDiscountInput').disabled = tab.orderType === 'FULFILL_PREORDER';
        if (tab.orderType === 'FULFILL_PREORDER') { const fee = document.getElementById('shipFeeInput'); if (fee) { fee.value = formatNum(initialPreorderData.shipping_cents || 0); fee.disabled = true; } }

        // Đồng bộ giao diện nút thanh toán theo loại tab (Hóa đơn vs Đặt hàng vs Xử lý đặt hàng)
        const isFulfill = tab.orderType === 'FULFILL_PREORDER';
        const isPreorder = tab.orderType === 'PREORDER' || tab.shipment?.orderType === 'PREORDER';
        const quickCheckoutBtn = document.getElementById('quickCheckoutBtn');
        if (quickCheckoutBtn) {
          quickCheckoutBtn.className = 'flex-1 h-11 bg-[#0070d2] hover:bg-[#005bb5] active:bg-[#004a94] text-white font-extrabold text-sm rounded shadow transition flex items-center justify-center gap-2 cursor-pointer';
          if (isPreorder) {
            quickCheckoutBtn.innerHTML = `
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
              </svg>
              ĐẶT HÀNG
            `;
          } else {
            quickCheckoutBtn.innerHTML = `
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
              </svg>
              THANH TOÁN (F9)
            `;
          }
        }

        // Cập nhật Badge và Nút chuyển đổi nhanh Bán hàng <-> Đặt hàng
        const currentOrderTypeBadge = document.getElementById('currentOrderTypeBadge');
        const toggleOrderTypeBtn = document.getElementById('toggleOrderTypeBtn');
        const toggleOrderTypeBtnText = document.getElementById('toggleOrderTypeBtnText');
        const quickPaidLabel = document.getElementById('quickPaidLabel');

        if (currentOrderTypeBadge && toggleOrderTypeBtn) {
          if (isFulfill) {
            currentOrderTypeBadge.className = 'px-2.5 py-0.5 rounded text-[11px] font-extrabold bg-purple-700 text-white tracking-wide';
            currentOrderTypeBadge.innerText = '⚡ XỬ LÝ ĐƠN ĐẶT';
            toggleOrderTypeBtn.classList.add('hidden');
            if (quickPaidLabel) quickPaidLabel.innerText = 'Khách thanh toán đợt này:';
          } else if (isPreorder) {
            currentOrderTypeBadge.className = 'px-2.5 py-0.5 rounded text-[11px] font-extrabold bg-amber-600 text-white tracking-wide';
            currentOrderTypeBadge.innerText = '📋 ĐẶT HÀNG';
            toggleOrderTypeBtn.classList.remove('hidden');
            if (toggleOrderTypeBtnText) toggleOrderTypeBtnText.innerText = '⇄ Chuyển sang Bán hàng';
            if (quickPaidLabel) quickPaidLabel.innerText = 'Khách đặt cọc:';
          } else {
            currentOrderTypeBadge.className = 'px-2.5 py-0.5 rounded text-[11px] font-extrabold bg-[#0b4d9c] text-white tracking-wide';
            currentOrderTypeBadge.innerText = '⚡ BÁN HÀNG';
            toggleOrderTypeBtn.classList.remove('hidden');
            if (toggleOrderTypeBtnText) toggleOrderTypeBtnText.innerText = '⇄ Chuyển sang Đặt hàng';
            if (quickPaidLabel) quickPaidLabel.innerText = 'Khách thanh toán:';
          }
        }

        // Cập nhật radio deliveryOrderType và deliverySubmitText
        document.querySelectorAll('input[name="deliveryOrderType"]').forEach(r => {
          r.checked = (r.value === (isPreorder ? 'PREORDER' : (tab.shipment?.orderType || 'ORDER')));
        });
        const deliverySubmitText = document.getElementById('deliverySubmitText');
        if (deliverySubmitText) {
          if (isFulfill) {
            deliverySubmitText.innerText = 'XUẤT BÁN & GIAO HÀNG (F9)';
          } else {
            deliverySubmitText.innerText = isPreorder ? 'ĐẶT HÀNG' : 'TẠO ĐƠN & GIAO HÀNG (F9)';
          }
        }
      };

      // Sự kiện chuyển nhanh Bán hàng ⇄ Đặt hàng (Giữ nguyên toàn bộ giỏ hàng & khách hàng)
      document.getElementById('toggleOrderTypeBtn')?.addEventListener('click', () => {
        const tab = getActiveTab();
        if (tab.orderType === 'FULFILL_PREORDER') return;

        if (tab.orderType === 'ORDER') {
          tab.orderType = 'PREORDER';
          if (tab.shipment) tab.shipment.orderType = 'PREORDER';
          tab.name = tab.name.replace(/^Hóa đơn/i, 'Đặt hàng').replace(/^Bán hàng/i, 'Đặt hàng');
          if (!tab.name.startsWith('Đặt hàng')) {
            tab.name = `Đặt hàng ${tab.id}`;
          }
          tab.paid = 0;
          showToast('Đã chuyển sang chế độ ĐẶT HÀNG (Giữ nguyên toàn bộ giỏ hàng)', 'info');
        } else {
          tab.orderType = 'ORDER';
          if (tab.shipment) tab.shipment.orderType = 'ORDER';
          tab.name = tab.name.replace(/^Đặt hàng/i, 'Hóa đơn');
          if (!tab.name.startsWith('Hóa đơn')) {
            tab.name = `Hóa đơn ${tab.id}`;
          }
          const net = Math.max(0, tab.items.reduce((s, it) => s + (it.quantity * it.unitPrice) - (it.discount || 0), 0) - tab.discount);
          tab.paid = net;
          showToast('Đã chuyển sang chế độ BÁN HÀNG (Giữ nguyên toàn bộ giỏ hàng)', 'info');
        }

        renderTabs();
        renderActiveTabContent();
        updateCartSummary(tab);
      });

      // Mở nhanh modal tạo hàng hóa mới từ nút [+] ô tìm kiếm
      document.getElementById('openNewProductBtn')?.addEventListener('click', () => {
        if (typeof window.openQuickProductModal === 'function') {
          window.openQuickProductModal(searchInput?.value?.trim() || '');
        }
      });

      // Bắt sự kiện tạo sản phẩm mới thành công -> Tự động nạp vào bộ nhớ POS & giỏ hàng
      window.addEventListener('product-created', (e) => {
        const pData = e.detail;
        if (!pData || !pData.id) return;

        const pItem = {
          id: pData.id,
          product_code: pData.product_code || `SP${pData.id}`,
          name: pData.name,
          tracking_mode: pData.has_serial ? 'CODE' : 'QUANTITY',
          has_serial: pData.has_serial ? 1 : 0,
          price_cents: pData.price_cents || 0,
          price_used_cents: pData.price_used_cents || 0,
          cost_price_cents: pData.cost_price_cents || 0,
          cost_price_used_cents: pData.cost_price_used_cents || 0,
          stock_new: pData.stock_new || 0,
          stock_used: pData.stock_used || 0,
          stock: (pData.stock_new || 0) + (pData.stock_used || 0),
          unit_name: pData.unit_name || 'Cái',
          category_name: 'Vừa tạo'
        };
        products.unshift(pItem);

        const isUsed = (pData.stock_used > 0 && !pData.stock_new) || (pData.price_used_cents > 0 && !pData.price_cents);
        const effectivePrice = isUsed ? (pData.price_used_cents || 0) : (pData.price_cents || pData.price_used_cents || 0);
        const cond = isUsed ? 'QSD' : 'NEW';

        productTypes.push({
          id: null,
          product_id: pData.id,
          name: 'Tiêu chuẩn',
          sale_price_cents: effectivePrice,
          cached_stock_new: pData.stock_new || 0,
          cached_stock_used: pData.stock_used || 0
        });

        // Nếu có serials tạo kèm thì bổ sung vào inStockUnits
        if (Array.isArray(pData.serials)) {
          pData.serials.forEach(s => {
            inStockUnits.push({
              id: s.id || Math.floor(Math.random() * 100000),
              product_type_id: null,
              program_code: s.code,
              condition: s.condition || cond,
              expiry_date: null,
              expiry_days: null,
              product_id: pData.id
            });
          });
        }

        // Tự động thêm sản phẩm vừa tạo vào giỏ hàng của tab đang mở
        addProductToCart({
          productId: pData.id,
          productTypeId: null,
          productUnitId: null,
          programCode: null,
          productCode: pData.product_code || 'SP',
          productName: pData.name,
          typeName: 'Tiêu chuẩn',
          condition: cond,
          unitPrice: effectivePrice,
          quantity: 1,
          discount: 0,
          hasSerial: !!pData.has_serial
        });

        showToast(`Đã tạo hàng hóa "${pData.name}" và tự động thêm vào giỏ hàng!`, 'success');
      });

      document.getElementById('orderNoteInput')?.addEventListener('change', (e) => {
        getActiveTab().note = e.target.value;
      });

      // 7. TIẾN HÀNH THANH TOÁN (CHECKOUT API)
      const performCheckout = async (isDelivery = false) => {
        const tab = getActiveTab();

        if (!tab.items || tab.items.length === 0) {
          showToast('Vui lòng chọn ít nhất 1 sản phẩm vào đơn hàng!', 'error');
          alert('Chưa có sản phẩm nào trong đơn hàng! Hãy tìm và chọn sản phẩm trước khi thanh toán.');
          return;
        }

        const netAmount = Math.max(0, tab.items.reduce((s, it) => s + (it.quantity * it.unitPrice) - (it.discount || 0), 0) - tab.discount);
        const shippingAmount = isDelivery ? parseNum(document.getElementById('shipFeeInput')?.value || 0) : 0;
        const invoiceTotal = tab.orderType === 'FULFILL_PREORDER' ? initialPreorderData.amount_total_cents : netAmount + shippingAmount;
        const seller = document.getElementById('quickSellerSelect')?.value || 'Admin Kgame';

        // Lấy chính xác số tiền khách thanh toán
        const isPreorder = tab.orderType === 'PREORDER' || tab.shipment?.orderType === 'PREORDER';
        const isFulfill = tab.orderType === 'FULFILL_PREORDER';
        const remainingToPay = Math.max(0, invoiceTotal - (tab.depositPaid || 0));

        let paidAmount = 0;
        if (isDelivery) {
          paidAmount = parseNum(document.getElementById('shipPrepaidAmountInput')?.value || 0);
        } else {
          const quickInput = document.getElementById('quickPaidInput');
          const rawStr = quickInput ? quickInput.value.trim() : '';
          if (rawStr !== '') {
            paidAmount = parseNum(rawStr);
          } else if (isPreorder) {
            paidAmount = 0;
          } else if (isFulfill) {
            paidAmount = remainingToPay;
          } else {
            paidAmount = invoiceTotal;
          }
        }

        if (!Number.isSafeInteger(paidAmount) || !Number.isSafeInteger(invoiceTotal) || !Number.isSafeInteger(shippingAmount)) { showToast('Số tiền không hợp lệ. Hãy nhập số nguyên không âm.', 'error'); return; }

        // RÀNG BUỘC CHUẨN KIOTVIET: Đơn hàng nợ lại bắt buộc phải có Khách Hàng
        const expectedTotal = isFulfill ? remainingToPay : invoiceTotal;
        if (paidAmount > expectedTotal) {
          if ((tab.paymentMethod || 'CASH') === 'CASH') paidAmount = expectedTotal;
          else { showToast('Tiền thanh toán vượt số còn phải thu.', 'error'); return; }
        }
        const receiverPhone = isDelivery ? document.getElementById('shipReceiverPhone')?.value.trim() : '';
        const hasCustomer = !!tab.customerId || !!tab.customerPhone || !!receiverPhone;
        if (paidAmount < expectedTotal && !hasCustomer) {
          alert('Đơn hàng có nợ lại! Vui lòng chọn hoặc nhập thông tin Khách Hàng (Tên / Số điện thoại) để ghi nhận công nợ.');
          return;
        }

        // XỬ LÝ XUẤT BÁN ĐƠN ĐẶT HÀNG (FULFILL_PREORDER)
        if (tab.orderType === 'FULFILL_PREORDER') {
          try {
            const submitBtn = isDelivery ? document.getElementById('deliverySubmitBtn') : document.getElementById('quickCheckoutBtn');
            if (submitBtn) {
              submitBtn.disabled = true;
              submitBtn.classList.add('opacity-50', 'pointer-events-none');
            }

            const resp = await fetch('/api/admin/orders', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'fulfill_preorder',
                request_id: requestIdFor({ action: 'fulfill_preorder', order_id: tab.preorderId, items: tab.items, amount_paid_cents: paidAmount, payment_method: tab.paymentMethod || 'CASH' }),
                order_id: tab.preorderId,
                items: tab.items.map(it => ({ order_line_id: it.orderLineId, product_id: it.productId, product_type_id: it.productTypeId, product_unit_id: it.productUnitId, condition: it.condition, quantity: it.quantity, unit_price_cents: it.unitPrice, discount_cents: it.discount || 0 })),
                payment: {
                  amount_paid_cents: paidAmount,
                  payment_method: tab.paymentMethod || 'CASH',
                  note: 'Thu tiền hoàn tất đơn hàng khi nhận hàng'
                }
              })
            });

            const result = await resp.json();
            if (!resp.ok || !result.success) {
              throw new Error(result.error || 'Lỗi khi xuất bán hoàn tất đặt hàng');
            }

            showToast(`Đã xuất kho và hoàn tất đơn ${tab.preorderCode}!`, 'success');

            if (confirm(`Đã xuất bán & hoàn tất ${tab.preorderCode} thành công!\nBạn có muốn in hóa đơn ngay không?`)) {
              window.open(`/admin/orders/${tab.preorderId}/print`, '_blank');
            }

            setTimeout(() => {
              window.location.href = '/admin/orders';
            }, 1000);
            return;
          } catch (err) {
            alert('Lỗi: ' + (err.message || 'Không thể xuất bán đơn'));
          } finally {
            const submitBtn = isDelivery ? document.getElementById('deliverySubmitBtn') : document.getElementById('quickCheckoutBtn');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.classList.remove('opacity-50', 'pointer-events-none');
            }
          }
          return;
        }

        // Chuẩn bị payload gửi lên server
        const payload = {
          action: 'create',
          created_by: seller,
          customer_id: tab.customerId || null,
          customer_name: isDelivery 
            ? (document.getElementById('shipReceiverName')?.value.trim() || tab.customerName || 'Khách giao hàng')
            : (tab.customerName || 'Khách lẻ'),
          customer_phone: isDelivery 
            ? (document.getElementById('shipReceiverPhone')?.value.trim() || tab.customerPhone || '')
            : (tab.customerPhone || ''),
          customer_address: isDelivery 
            ? (document.getElementById('shipReceiverAddress')?.value.trim() || tab.customerAddress || '')
            : (tab.customerAddress || ''),
          order_type: isDelivery ? (tab.shipment?.orderType || (tab.orderType || 'ORDER')) : (tab.orderType || 'ORDER'),
          discount_cents: tab.discount || 0,
          shipping_cents: isDelivery ? parseNum(document.getElementById('shipFeeInput')?.value || 0) : 0,
          note: document.getElementById('orderNoteInput')?.value.trim() || tab.note || '',
          items: tab.items.map(it => ({
            product_id: it.productId,
            product_type_id: it.productTypeId || null,
            product_unit_id: it.productUnitId || null,
            condition: it.condition || 'NEW',
            quantity: it.quantity || 1,
            unit_price_cents: it.unitPrice || 0,
            discount_cents: it.discount || 0
          })),
          payment: {
            amount_paid_cents: paidAmount,
            payment_method: tab.paymentMethod || 'CASH',
            note: isDelivery 
              ? (paidAmount > 0 ? 'Khách trả trước / cọc đơn giao hàng' : 'Đơn giao hàng chưa thanh toán')
              : (tab.orderType === 'PREORDER' ? (paidAmount > 0 ? 'Khách đặt cọc đơn hàng' : 'Đơn đặt hàng chưa thanh toán') : 'Thanh toán tại quầy')
          }
        };

        if (isDelivery) {
          const partnerSelect = document.getElementById('shipPartnerSelect');
          const partnerId = partnerSelect?.value ? Number(partnerSelect.value) : null;

          payload.shipment = {
            delivery_partner_id: partnerId,
            carrier: tab.shipment.carrier === 'BUS' ? 'BUS' : tab.shipment.carrier,
            bus_station: document.getElementById('shipBusStation')?.value.trim() || null,
            tracking_code: document.getElementById('shipTrackingCode')?.value.trim() || null,
            receiver_name: document.getElementById('shipReceiverName')?.value.trim() || tab.customerName || 'Người nhận',
            receiver_phone: document.getElementById('shipReceiverPhone')?.value.trim() || tab.customerPhone || '',
            receiver_address: document.getElementById('shipReceiverAddress')?.value.trim() || tab.customerAddress || '',
            shipping_fee_cents: parseNum(document.getElementById('shipFeeInput')?.value || 0),
            shipping_payer: document.getElementById('shipPayerSelect')?.value || 'BUYER_PAYS',
            weight_grams: Number(document.getElementById('shipWeightGram')?.value || 1500),
            dimensions: document.getElementById('shipDimensions')?.value.trim() || '40 x 20 x 12'
          };
        } else {
          payload.shipment = {
            carrier: 'PICKUP'
          };
        }

        try {
          const submitBtn = isDelivery ? document.getElementById('deliverySubmitBtn') : document.getElementById('quickCheckoutBtn');
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.classList.add('opacity-50', 'pointer-events-none');
          }

          payload.request_id = requestIdFor(payload);
          const resp = await fetch('/api/admin/orders', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          const result = await resp.json();

          if (!resp.ok || !result.success) {
            throw new Error(result.error || 'Lỗi khi tạo đơn hàng');
          }

          showToast(`Đã thanh toán thành công đơn hàng ${result.order_code}!`, 'success');

          if (tab.paymentMethod === 'CREDIT') {
            const customer = customers.find(c => c.id === tab.customerId);
            if (customer) customer.customer_credit_cents = Math.max(0, (customer.customer_credit_cents || 0) - paidAmount);
          }

          // Cập nhật loại bỏ mã bộ đã bán khỏi danh sách tồn kho trên client
          tab.items.forEach(it => {
            if (it.productUnitId) {
              const uIdx = inStockUnits.findIndex(u => u.id === it.productUnitId);
              if (uIdx !== -1) inStockUnits.splice(uIdx, 1);
            }
          });

          // Xóa tab hoặc làm mới tab
          if (tabs.length > 1) {
            closeTab(tab.id);
          } else {
            tab.operationSession = crypto.randomUUID();
            tab.items = [];
            tab.customerId = null;
            tab.customerCode = '';
            tab.customerName = '';
            tab.customerPhone = '';
            tab.customerAddress = '';
            tab.customerDebt = 0;
            tab.customerCredit = 0;
            tab.paymentMethod = 'CASH';
            tab.paidTouched = false;
            tab.discount = 0;
            tab.paid = 0;
            tab.note = '';
            renderActiveTabContent();
          }

          // Tùy chọn in hóa đơn
          setTimeout(() => {
            if (confirm(`Đơn hàng ${result.order_code} đã thanh toán thành công!\nBạn có muốn mở xem chi tiết hoặc in hóa đơn không?`)) {
              window.open(`/admin/orders/${result.id}`, '_blank');
            }
          }, 300);

        } catch (err) {
          console.error(err);
          showToast(err.message || 'Lỗi xử lý đơn hàng', 'error');
          alert('Lỗi tạo đơn hàng: ' + (err.message || 'Không thể lưu đơn hàng'));
        } finally {
          const submitBtn = isDelivery ? document.getElementById('deliverySubmitBtn') : document.getElementById('quickCheckoutBtn');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.classList.remove('opacity-50', 'pointer-events-none');
          }
        }
      };

      document.getElementById('quickCheckoutBtn')?.addEventListener('click', () => performCheckout(false));
      document.getElementById('deliverySubmitBtn')?.addEventListener('click', () => performCheckout(true));

      // Phím tắt KiotViet: F1 tạo đơn, F2 tìm khách, F3 tìm hàng, F4 ghi chú, F9 thanh toán
      window.addEventListener('keydown', (e) => {
        if (e.key === 'F2') {
          e.preventDefault();
          custSearchInput?.focus();
        } else if (e.key === 'F3') {
          e.preventDefault();
          searchInput?.focus();
        } else if (e.key === 'F4') {
          e.preventDefault();
          document.getElementById('orderNoteInput')?.focus();
        } else if (e.key === 'F9') {
          e.preventDefault();
          const tab = getActiveTab();
          performCheckout(tab.mode === 'delivery');
        } else if (e.key === 'F1') {
          e.preventDefault();
          addNewTab();
        }
      });

      // 8. TOAST NOTIFICATION
      const showToast = (msg, type = 'success') => {
        const toast = document.getElementById('toastNotification');
        const msgEl = document.getElementById('toastMessage');
        if (!toast || !msgEl) return;
        msgEl.innerText = msg;
        toast.className = `fixed bottom-16 left-1/2 -translate-x-1/2 px-4 py-2.5 rounded-lg text-white text-xs font-semibold shadow-2xl z-50 flex items-center gap-2 ${
          type === 'error' ? 'bg-red-600' : 'bg-gray-900'
        }`;
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 3500);
      };

      // 9. THÊM KHÁCH HÀNG MỚI MODAL CHUẨN 3 CẤP ĐỊA CHỈ (REQUIREMENT 3)
      const addCustModal = document.getElementById('newCustomerModal');
      const provInput = document.getElementById('modalNewCustProvince');
      const provSug = document.getElementById('modalProvSuggestions');
      const wardInput = document.getElementById('modalNewCustWard');
      const wardSug = document.getElementById('modalWardSuggestions');
      const detailInput = document.getElementById('modalNewCustAddressDetail');
      const parseBadge = document.getElementById('modalParseNoticeBadge');

      const openAddCustomerModal = () => {
        addCustModal?.classList.remove('hidden');
        document.getElementById('modalNewCustName').value = '';
        document.getElementById('modalNewCustPhone').value = '';
        if (provInput) provInput.value = '';
        if (wardInput) wardInput.value = '';
        if (detailInput) detailInput.value = '';
        document.getElementById('modalNewCustNote').value = '';
        document.getElementById('modalNewCustName')?.focus();
      };

      const closeAddCustomerModal = () => {
        addCustModal?.classList.add('hidden');
        provSug?.classList.add('hidden');
        wardSug?.classList.add('hidden');
        parseBadge?.classList.add('hidden');
      };

      document.getElementById('openAddCustomerModalBtn')?.addEventListener('click', openAddCustomerModal);
      document.getElementById('closeAddCustomerModalBtn')?.addEventListener('click', closeAddCustomerModal);
      document.getElementById('cancelAddCustomerBtn')?.addEventListener('click', closeAddCustomerModal);

      // Autocomplete Tỉnh/TP
      let geoTimer = null;
      async function searchProvinces(q) {
        if (!provSug) return;
        try {
          const res = await fetch(`/api/admin/geo?type=provinces&q=${encodeURIComponent(q)}`);
          const json = await res.json();
          if (json.success && json.data.length > 0) {
            provSug.innerHTML = json.data.map(p => `
              <div class="p-2 hover:bg-blue-50 cursor-pointer transition font-medium text-gray-800 prov-item" data-val="${p}">
                📍 ${p}
              </div>
            `).join('');
            provSug.classList.remove('hidden');

            provSug.querySelectorAll('.prov-item').forEach(item => {
              item.addEventListener('click', () => {
                if (provInput) provInput.value = item.getAttribute('data-val') || '';
                provSug.classList.add('hidden');
                if (wardInput) {
                  wardInput.focus();
                  searchWards('');
                }
              });
            });
          } else {
            provSug.classList.add('hidden');
          }
        } catch {
          provSug.classList.add('hidden');
        }
      }

      // Autocomplete Phường/Xã
      async function searchWards(q) {
        if (!wardSug) return;
        const provVal = provInput?.value.trim() || '';
        try {
          const res = await fetch(`/api/admin/geo?type=wards&province=${encodeURIComponent(provVal)}&q=${encodeURIComponent(q)}`);
          const json = await res.json();
          if (json.success && json.data.length > 0) {
            wardSug.innerHTML = json.data.map(w => `
              <div class="p-2 hover:bg-blue-50 cursor-pointer transition text-gray-800 ward-item" data-val="${w}">
                🏘️ ${w}
              </div>
            `).join('');
            wardSug.classList.remove('hidden');

            wardSug.querySelectorAll('.ward-item').forEach(item => {
              item.addEventListener('click', () => {
                if (wardInput) wardInput.value = item.getAttribute('data-val') || '';
                wardSug.classList.add('hidden');
                if (detailInput) detailInput.focus();
              });
            });
          } else {
            wardSug.classList.add('hidden');
          }
        } catch {
          wardSug.classList.add('hidden');
        }
      }

      provInput?.addEventListener('focus', () => searchProvinces(provInput.value.trim()));
      provInput?.addEventListener('input', () => {
        clearTimeout(geoTimer);
        geoTimer = setTimeout(() => searchProvinces(provInput.value.trim()), 100);
      });

      wardInput?.addEventListener('focus', () => searchWards(wardInput.value.trim()));
      wardInput?.addEventListener('input', () => {
        clearTimeout(geoTimer);
        geoTimer = setTimeout(() => searchWards(wardInput.value.trim()), 100);
      });

      // Tự động phân tích địa chỉ khi dán (Smart Address Parsing)
      async function autoParseAddress(fullText) {
        if (!fullText || fullText.trim().length < 5) return;
        try {
          const res = await fetch(`/api/admin/geo?type=parse&text=${encodeURIComponent(fullText.trim())}`);
          const json = await res.json();
          if (json.success && json.data) {
            const { province, ward, detail } = json.data;
            let changed = false;
            if (province && provInput) {
              provInput.value = province;
              changed = true;
            }
            if (ward && wardInput) {
              wardInput.value = ward;
              changed = true;
            }
            if (detail && detailInput && (province || ward)) {
              detailInput.value = detail;
              changed = true;
            }

            if (changed && parseBadge) {
              parseBadge.textContent = json.data.converted_from ? `✨ Quy đổi sáp nhập: ${json.data.converted_from}` : `✨ Đã tách: ${province || ''} ${ward ? '• ' + ward : ''}`;
              parseBadge.classList.remove('hidden');
              setTimeout(() => parseBadge.classList.add('hidden'), 5000);
            }
          }
        } catch (err) {
          console.error(err);
        }
      }

      detailInput?.addEventListener('paste', (e) => {
        const pastedData = e.clipboardData?.getData('text');
        if (pastedData && pastedData.trim().length > 5) {
          setTimeout(() => autoParseAddress(pastedData), 30);
        }
      });

      detailInput?.addEventListener('change', () => {
        const val = detailInput?.value.trim() || '';
        if (val.includes(',') || val.length > 15) {
          autoParseAddress(val);
        }
      });

      // Đóng gợi ý khi click ngoài
      document.addEventListener('click', (e) => {
        if (provInput && provSug && !provInput.contains(e.target) && !provSug.contains(e.target)) {
          provSug.classList.add('hidden');
        }
        if (wardInput && wardSug && !wardInput.contains(e.target) && !wardSug.contains(e.target)) {
          wardSug.classList.add('hidden');
        }
        if (custSearchInput && custSearchResults && !custSearchInput.contains(e.target) && !custSearchResults.contains(e.target)) {
          custSearchResults.classList.add('hidden');
        }
        if (searchInput && searchResults && !searchInput.contains(e.target) && !searchResults.contains(e.target)) {
          searchResults.classList.add('hidden');
        }
      });

      // Lưu khách hàng mới vào Database & tự động chọn vào đơn hàng
      document.getElementById('saveAddCustomerBtn')?.addEventListener('click', async () => {
        const name = document.getElementById('modalNewCustName')?.value.trim();
        const phone = document.getElementById('modalNewCustPhone')?.value.trim();
        const province = provInput?.value.trim() || null;
        const ward = wardInput?.value.trim() || null;
        const addressDetail = detailInput?.value.trim() || null;
        const note = document.getElementById('modalNewCustNote')?.value.trim() || null;

        if (!name || !phone) {
          alert('Vui lòng nhập họ tên và số điện thoại khách hàng!');
          return;
        }

        const saveBtn = document.getElementById('saveAddCustomerBtn');
        try {
          saveBtn.disabled = true;
          saveBtn.innerText = 'Đang lưu...';

          const res = await fetch('/api/admin/customers', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name,
              phone,
              province,
              ward,
              address_detail: addressDetail,
              note
            })
          });

          const result = await res.json();
          if (!res.ok || !result.success) {
            throw new Error(result.error || 'Lỗi khi lưu khách hàng');
          }

          const fullAddress = [addressDetail, ward, province].filter(Boolean).join(', ');
          const newCust = {
            id: result.id,
            customer_code: result.customer_code || `KH#${result.id}`,
            name,
            phone,
            province,
            ward,
            address_detail: addressDetail,
            address: fullAddress,
            note,
            current_debt_cents: 0
          };

          customers.unshift(newCust);
          selectCustomerForTab(newCust);
          closeAddCustomerModal();
          showToast(`Đã lưu và chọn khách hàng ${name} (${newCust.customer_code})`, 'success');
        } catch (err) {
          alert(err.message || 'Lỗi khi lưu khách hàng');
        } finally {
          saveBtn.disabled = false;
          saveBtn.innerText = 'Lưu Khách Hàng';
        }
      });

      // 10. XỬ LÝ DROPDOWN MENU CHỌN LOẠI TẠO MỚI (HÓA ĐƠN / ĐẶT HÀNG / SỬA CHỮA)
      const toggleNewMenuBtn = document.getElementById('toggleNewMenuBtn');
      const newTypeDropdownMenu = document.getElementById('newTypeDropdownMenu');

      toggleNewMenuBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        newTypeDropdownMenu?.classList.toggle('hidden');
      });

      document.addEventListener('click', (e) => {
        if (!newTypeDropdownMenu?.contains(e.target) && !toggleNewMenuBtn?.contains(e.target)) {
          newTypeDropdownMenu?.classList.add('hidden');
        }
      });

      document.getElementById('menuAddNewSaleTab')?.addEventListener('click', () => {
        newTypeDropdownMenu?.classList.add('hidden');
        addNewTab();
      });

      document.getElementById('menuAddNewPreorderTab')?.addEventListener('click', () => {
        newTypeDropdownMenu?.classList.add('hidden');
        addNewPreorderTab();
      });

      document.getElementById('menuAddNewRepairTab')?.addEventListener('click', () => {
        newTypeDropdownMenu?.classList.add('hidden');
        openQuickRepairModal();
      });

      // 11. XỬ LÝ TIẾP NHẬN SỬA CHỮA TẠI QUẦY (QUICK REPAIR MODAL)
      const quickRepairModal = document.getElementById('quickRepairModal');
      const closeQuickRepairModalBtn = document.getElementById('closeQuickRepairModalBtn');
      const cancelQuickRepairBtn = document.getElementById('cancelQuickRepairBtn');
      const saveQuickRepairBtn = document.getElementById('saveQuickRepairBtn');
      const repairFeeInput = document.getElementById('repairEstimatedFee');

      repairFeeInput?.addEventListener('input', (e) => {
        const val = parseNum(e.target.value);
        if (!Number.isSafeInteger(val)) { showToast('Số tiền không hợp lệ.', 'error'); return; }
        e.target.value = formatNum(val);
      });

      const openQuickRepairModal = () => {
        const tab = getActiveTab();
        // Tự động kế thừa thông tin khách hàng đang chọn ở quầy
        const custNameInput = document.getElementById('repairCustName');
        const custPhoneInput = document.getElementById('repairCustPhone');
        const custAddrInput = document.getElementById('repairCustAddress');
        const badge = document.getElementById('repairCustBadge');

        if (custNameInput) custNameInput.value = tab.customerName || '';
        if (custPhoneInput) custPhoneInput.value = tab.customerPhone || '';
        if (custAddrInput) custAddrInput.value = tab.customerAddress || '';
        if (badge) {
          badge.innerText = tab.customerName ? `Khách: ${tab.customerName}` : 'Khách lẻ tại quầy';
        }

        // Đặt mặc định thiết bị & lỗi
        document.getElementById('repairDeviceName').value = '';
        document.getElementById('repairAccessories').value = '';
        document.getElementById('repairProblem').value = '';
        if (repairFeeInput) repairFeeInput.value = '0';
        document.getElementById('repairNote').value = '';

        // Hẹn ngày mai lúc 17:00
        const tmr = new Date(Date.now() + 24 * 3600 * 1000);
        tmr.setHours(17, 0, 0, 0);
        const pad = (n) => String(n).padStart(2, '0');
        const dtStr = `${tmr.getFullYear()}-${pad(tmr.getMonth() + 1)}-${pad(tmr.getDate())}T${pad(tmr.getHours())}:${pad(tmr.getMinutes())}`;
        const dtInput = document.getElementById('repairExpectedDate');
        if (dtInput) dtInput.value = dtStr;

        quickRepairModal?.classList.remove('hidden');
        document.getElementById('repairDeviceName')?.focus();
      };

      const closeQuickRepairModal = () => {
        quickRepairModal?.classList.add('hidden');
      };

      closeQuickRepairModalBtn?.addEventListener('click', closeQuickRepairModal);
      cancelQuickRepairBtn?.addEventListener('click', closeQuickRepairModal);

      saveQuickRepairBtn?.addEventListener('click', async () => {
        const custName = document.getElementById('repairCustName')?.value.trim();
        const custPhone = document.getElementById('repairCustPhone')?.value.trim();
        const custAddress = document.getElementById('repairCustAddress')?.value.trim();
        const deviceName = document.getElementById('repairDeviceName')?.value.trim();
        const accessories = document.getElementById('repairAccessories')?.value.trim();
        const problem = document.getElementById('repairProblem')?.value.trim();
        const fee = parseNum(document.getElementById('repairEstimatedFee')?.value || 0);
        const expectedReturn = document.getElementById('repairExpectedDate')?.value;
        const assignedTo = document.getElementById('repairAssignedTo')?.value.trim() || 'Kỹ thuật xưởng';
        const note = document.getElementById('repairNote')?.value.trim();

        if (!deviceName) {
          alert('Vui lòng nhập tên máy / thiết bị tiếp nhận!');
          document.getElementById('repairDeviceName')?.focus();
          return;
        }

        if (!problem) {
          alert('Vui lòng nhập hiện tượng lỗi / yêu cầu sửa chữa!');
          document.getElementById('repairProblem')?.focus();
          return;
        }

        const tab = getActiveTab();
        const payload = {
          owner_type: 'CUSTOMER',
          customer_id: tab.customerId || null,
          customer_name: custName || 'Khách lẻ',
          customer_phone: custPhone || '',
          customer_address: custAddress || '',
          unidentified_product_name: deviceName,
          problem_reported: problem,
          accessories_received: accessories || null,
          repair_price_cents: fee,
          expected_return_at: expectedReturn || null,
          assigned_to: assignedTo,
          note: note || null,
          created_by: 'Kiệt (Quầy POS)'
        };

        try {
          saveQuickRepairBtn.disabled = true;
          saveQuickRepairBtn.innerText = 'Đang lưu phiếu...';

          const resp = await fetch('/api/admin/repairs', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          const result = await resp.json();
          if (!resp.ok || !result.success) {
            throw new Error(result.error || 'Lỗi khi tạo phiếu sửa chữa');
          }

          closeQuickRepairModal();
          showToast(`Đã tạo phiếu sửa chữa ${result.ticket_code}!`, 'success');

          if (confirm(`Đã tiếp nhận sửa chữa mã ${result.ticket_code} thành công!\nBạn có muốn in phiếu tiếp nhận ngay không?`)) {
            window.open(`/admin/repairs/${result.id}/print`, '_blank');
          }
        } catch (err) {
          alert('Lỗi: ' + (err.message || 'Không thể lưu phiếu sửa chữa'));
        } finally {
          saveQuickRepairBtn.disabled = false;
          saveQuickRepairBtn.innerHTML = '<span>Lưu tiếp nhận sửa chữa</span>';
        }
      });

      // Khởi chạy ban đầu
      renderTabs();
      renderActiveTabContent();
    });
  </script>
</body>
</html>

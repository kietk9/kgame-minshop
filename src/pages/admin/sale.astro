---
import { hasPermission,withoutCosts,posAuthority } from '../../features/auth/permissions';
import { env } from 'cloudflare:workers';
import { listKgameCustomers, getPosOrderById } from '../../features/kgame/db';
import QuickProductModal from '../../components/admin/QuickProductModal.astro';

export const prerender = false;
const principal = Astro.locals.adminPrincipal;
const authority=posAuthority(principal);
const isStaff = principal?.role !== 'OWNER';

// 1. Lấy danh sách sản phẩm đang kinh doanh
const { results: rawProducts } = await env.DB.prepare(`
  SELECT 
    p.id, p.product_code, p.name, p.tracking_mode, p.has_serial,
    p.price_cents, p.price_used_cents, p.cost_price_cents, p.cost_price_used_cents,
    p.stock_new, p.stock_used, p.stock, p.unit_name,
    c.name AS category_name
  FROM products p
  LEFT JOIN categories c ON p.category_id = c.id
  WHERE p.active = 1
  ORDER BY p.name ASC
`).all<any>();

const canViewCost=hasPermission(principal,'cost.view');
const products = canViewCost ? rawProducts ?? [] : withoutCosts(rawProducts ?? []);

// 2. Lấy danh sách phiên bản / loại sản phẩm
const { results: rawTypes } = await env.DB.prepare(`
  SELECT t.id, t.product_id, t.name, t.tracking_mode, t.sale_price_cents, t.cached_stock_new, t.cached_stock_used
  FROM product_types t
  WHERE t.is_active = 1
  ORDER BY t.sort_order ASC, t.id ASC
`).all<any>();

const productTypes = rawTypes ?? [];

// 3. Lấy tất cả mã bộ đang IN_STOCK (đối với dòng máy Game quản lý theo mã bo mạch / serial)
const { results: rawUnits } = await env.DB.prepare(`
  SELECT u.id, u.product_type_id, u.program_code, u.condition, u.expiry_date, u.expiry_days, t.product_id
  FROM product_units u
  JOIN product_types t ON u.product_type_id = t.id
  WHERE u.availability = 'IN_STOCK' AND u.owner_type = 'KGAME'
  ORDER BY u.program_code ASC
`).all<any>();

const inStockUnits = rawUnits ?? [];

// 4. Lấy danh sách khách hàng kèm số nợ thực tế và địa chỉ 3 cấp chuẩn
const { customers } = await listKgameCustomers(env.DB, { limit: 300 });

// 5. Lấy danh sách Đối tác Giao hàng (Chành xe & Shipper)
const { results: rawPartners } = await env.DB.prepare(`
  SELECT id, partner_code, name, partner_type, phone, address, contact_person
  FROM delivery_partners
  WHERE status = 'ACTIVE'
  ORDER BY partner_type DESC, name ASC
`).all<any>();

const deliveryPartners = rawPartners ?? [];

// Cấu hình xưởng gửi Kgame
const senderInfo = {
  name: 'Xưởng Kgame Minshop',
  phone: '0903000111',
  address: 'Kho số 5, 5 Đường số 16, P. Bình Hưng Hòa, Q. Bình Tân, TP. Hồ Chí Minh'
};

const nowStr = new Date().toLocaleString('vi-VN', {
  day: '2-digit', month: '2-digit', year: 'numeric',
  hour: '2-digit', minute: '2-digit'
});

// Kiểm tra nếu nạp đơn đặt hàng từ trang quản trị để xử lý xuất bán
const loadPreorderId = Astro.url.searchParams.get('load_preorder');
let initialPreorderData: any = null;
if (loadPreorderId) {
  const pId = Number(loadPreorderId);
  if (pId > 0) {
    initialPreorderData = await getPosOrderById(env.DB, pId);
    if(!canViewCost)initialPreorderData=withoutCosts(initialPreorderData);
    if (!initialPreorderData || initialPreorderData.order_type !== 'PREORDER' || ['CANCELLED', 'COMPLETED'].includes(initialPreorderData.order_status)) return Astro.redirect('/admin/orders');
  }
}
---

<!DOCTYPE html>
<html lang="vi" class="h-full bg-[#f0f2f5]">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bán hàng & Đặt hàng - Kgame Minshop</title>
  <link rel="stylesheet" href="/src/styles/admin.css" />
  <style>
    /* Ẩn scrollbar phụ để tạo cảm giác POS mượt mà */
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .pos-number { font-variant-numeric: tabular-nums; }
  </style>
</head>
<body class="h-full flex flex-col font-sans text-gray-900 select-none overflow-hidden bg-[#eef1f5]">

  <!-- TOP HEADER POS (CHUẨN KIOTVIET) -->
  <header class="h-12 bg-[#0b4d9c] text-white flex items-center justify-between px-3 shrink-0 shadow-sm z-30">
    <!-- KHU VỰC TÌM KIẾM SẢN PHẨM & TABS HÓA ĐƠN -->
    <div class="flex items-center gap-3 flex-1 max-w-4xl">
      <!-- Ô TÌM KIẾM NHANH SẢN PHẨM (F3) -->
      <div class="relative w-72 sm:w-84">
        <div class="relative flex items-center">
          <input
            type="text"
            id="productSearchInput"
            placeholder="Tìm mặt hàng / Mã bộ (F3)..."
            autocomplete="off"
            class="w-full h-8.5 pl-8 pr-16 text-[13px] bg-white text-gray-900 rounded border-0 focus:ring-2 focus:ring-sky-400 focus:outline-none shadow-inner"
          />
          <svg class="w-4 h-4 text-gray-400 absolute left-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <button type="button" id="clearSearchBtn" class="hidden absolute right-8 text-gray-400 hover:text-gray-600 text-xs font-bold">✕</button>
          <button
            type="button"
            id="openNewProductBtn" disabled={isStaff} title={isStaff ? 'Chỉ chủ cửa hàng được dùng chức năng này' : undefined}
            title="Tạo nhanh hàng hóa mới (F4)"
            class="absolute right-1 w-6 h-6 rounded bg-sky-500 hover:bg-sky-600 text-white flex items-center justify-center text-xs font-extrabold transition shadow-xs cursor-pointer"
          >
            +
          </button>
        </div>

        <!-- DROPDOWN KẾT QUẢ TÌM KIẾM SẢN PHẨM -->
        <div id="productSearchResults" class="hidden absolute top-full left-0 right-0 mt-1 bg-white rounded-md shadow-2xl border border-gray-200 max-h-96 overflow-y-auto z-50 divide-y divide-gray-100">
          <!-- Render động qua JS -->
        </div>
      </div>

      <!-- DANH SÁCH TABS HÓA ĐƠN (HÓA ĐƠN 1, 2, 3...) -->
      <div class="flex items-center gap-1 overflow-x-auto no-scrollbar" id="orderTabsContainer">
        <!-- Render động qua JS -->
      </div>

      <!-- NÚT THÊM HÓA ĐƠN MỚI (+) VÀ MENU ĐẶT HÀNG / SỬA CHỮA (CHUẨN KIOTVIET) -->
      <div class="relative inline-flex items-center rounded bg-white/15 hover:bg-white/20 text-white transition text-xs font-semibold shadow-xs shrink-0">
        <button
          type="button"
          id="addNewTabBtn"
          title="Mở thêm hóa đơn mới (F1)"
          class="h-8.5 px-2.5 flex items-center justify-center hover:bg-white/15 rounded-l text-sm font-bold cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
          </svg>
        </button>
        <div class="w-px h-5 bg-white/25"></div>
        <button
          type="button"
          id="toggleNewMenuBtn"
          title="Mở menu Thêm mới đặt hàng / sửa chữa"
          class="h-8.5 px-2 flex items-center justify-center hover:bg-white/15 rounded-r cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>

        <!-- Dropdown Popup chọn loại tạo mới -->
        <div id="newTypeDropdownMenu" class="hidden absolute top-full left-0 mt-1.5 w-56 bg-white rounded-lg shadow-2xl border border-gray-200 py-1 z-50 text-gray-800 text-xs font-medium divide-y divide-gray-100">
          <div class="py-1">
            <button
              type="button"
              id="menuAddNewSaleTab"
              class="w-full px-3 py-2 text-left hover:bg-blue-50 hover:text-blue-700 flex items-center gap-2.5 transition cursor-pointer"
            >
              <span class="w-6 h-6 rounded bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-xs shrink-0">⚡</span>
              <div>
                <div class="font-bold text-gray-900">Bán hàng</div>
                <div class="text-[10.5px] text-gray-500">Bán nhanh / Giao hàng</div>
              </div>
            </button>
            <button
              type="button"
              id="menuAddNewPreorderTab"
              class="w-full px-3 py-2 text-left hover:bg-amber-50 hover:text-amber-700 flex items-center gap-2.5 transition cursor-pointer"
            >
              <span class="w-6 h-6 rounded bg-amber-100 text-amber-600 flex items-center justify-center font-bold text-xs shrink-0">📋</span>
              <div>
                <div class="font-bold text-gray-900">Đặt hàng</div>
                <div class="text-[10.5px] text-gray-500">Đặt cọc / Hẹn lấy linh kiện</div>
              </div>
            </button>
          </div>
          <div class="py-1">
            <button
              type="button"
              id="menuAddNewRepairTab" disabled={isStaff} title={isStaff ? 'Chỉ chủ cửa hàng được dùng chức năng này' : undefined}
              class="w-full px-3 py-2 text-left hover:bg-emerald-50 hover:text-emerald-700 flex items-center gap-2.5 transition cursor-pointer"
            >
              <span class="w-6 h-6 rounded bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold text-xs shrink-0">🔧</span>
              <div>
                <div class="font-bold text-gray-900">Thêm mới sửa chữa</div>
                <div class="text-[10.5px] text-gray-500">Tiếp nhận máy sửa / bảo hành</div>
              </div>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- KHU VỰC PHẢI: ĐỒNG HỒ, NHÂN VIÊN & VỀ QUẢN TRỊ -->
    <div class="flex items-center gap-3 text-xs">
      <div class="hidden md:flex items-center gap-1.5 text-white/80 tabular-nums">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span id="liveClock">{nowStr}</span>
      </div>

      <div class="h-4 w-px bg-white/20 hidden md:block"></div>

      <!-- Thông tin nhân viên & kho -->
      <div class="flex items-center gap-1.5 text-white font-medium">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span id="activeCashierName">Kiệt (Kho số 5)</span>
      </div>

      <!-- Nút thoát về Quản trị -->
      <a
        href="/admin"
        title="Quay lại trang quản lý chính"
        class="flex items-center gap-1 px-2.5 py-1 rounded bg-white/10 hover:bg-white/20 text-white transition font-medium text-xs ml-1"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        <span class="hidden sm:inline">Quản lý</span>
      </a>
    </div>
  </header>

  <!-- NỘI DUNG CHÍNH (FULL SCREEN SPLIT 2 CỘT) -->
  <main class="flex-1 flex overflow-hidden">
    
    <!-- CỘT TRÁI: GIỎ HÀNG SẢN PHẨM & FOOTER ĐIỀU KHIỂN (BÁN NHANH / GIAO HÀNG PHÍA DƯỚI BÊN TRÁI) -->
    <section class="flex-1 flex flex-col bg-white border-r border-gray-300 overflow-hidden">
      
      <!-- TIÊU ĐỀ BẢNG MẶT HÀNG -->
      <div class="h-9 bg-[#f4f6f8] border-b border-gray-200 px-3 flex items-center text-[11.5px] font-bold text-gray-500 uppercase tracking-wider shrink-0 select-none">
        <div class="w-8 text-center">STT</div>
        <div class="w-24">Mã hàng</div>
        <div class="flex-1 px-2">Tên sản phẩm / Quy cách &amp; Mã bộ</div>
        <div class="w-28 text-center">Số lượng</div>
        <div class="w-28 text-right pr-2">Đơn giá</div>
        <div class="w-32 text-right pr-2">Thành tiền</div>
        <div class="w-8 text-center"></div>
      </div>

      <!-- VÙNG DANH SÁCH SẢN PHẨM CUỘN -->
      <div id="cartItemsList" class="flex-1 overflow-y-auto divide-y divide-gray-100">
        <!-- Render động giỏ hàng qua JS -->
      </div>

      <!-- VÙNG TRỐNG KHI CHƯA CHỌN SẢN PHẨM -->
      <div id="emptyCartView" class="hidden flex-1 flex flex-col items-center justify-center text-gray-400 p-8">
        <svg class="w-16 h-16 text-gray-300 stroke-1 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
        </svg>
        <p class="text-sm font-medium text-gray-500">Chưa có sản phẩm nào trong đơn</p>
        <p class="text-xs text-gray-400 mt-1">Gõ mã hoặc tên vào ô tìm kiếm (F3) ở góc trên để thêm hàng</p>
      </div>

      <!-- FOOTER CỘT TRÁI: 2 NÚT BÁN NHANH / GIAO HÀNG (PHÍA DƯỚI BÊN TRÁI), GHI CHÚ & TỔNG TIỀN -->
      <div class="border-t border-gray-200 bg-[#f9fafb] p-2.5 shrink-0 flex items-center justify-between gap-4 select-none">
        <!-- PHÍA DƯỚI BÊN TRÁI: 2 CHẾ ĐỘ BÁN HÀNG + GHI CHÚ ĐƠN HÀNG (F4) -->
        <div class="flex items-center gap-3">
          <!-- 2 Nút chuyển chế độ bán hàng -->
          <div class="flex items-center bg-gray-200/90 p-0.5 rounded-lg border border-gray-300 shadow-inner">
            <!-- 1. Bán nhanh -->
            <button
              type="button"
              id="modeQuickSaleBtn"
              class="h-8 px-3 rounded-md flex items-center gap-1.5 text-xs font-bold transition bg-white text-[#0070d2] shadow-xs cursor-pointer"
            >
              <span class="text-amber-500">⚡</span>
              <span>Bán nhanh</span>
            </button>

            <!-- 2. Bán giao hàng -->
            <button
              type="button"
              id="modeDeliverySaleBtn"
              class="h-8 px-3 rounded-md flex items-center gap-1.5 text-xs font-semibold text-gray-600 hover:text-gray-900 transition cursor-pointer"
            >
              <span class="text-blue-500">🚚</span>
              <span>Bán giao hàng</span>
            </button>
          </div>

          <!-- Ghi chú đơn hàng (F4) -->
          <div class="relative w-52 sm:w-64">
            <input
              type="text"
              id="orderNoteInput"
              placeholder="Ghi chú đơn hàng (F4)..."
              class="w-full text-xs h-8 pl-7 pr-2.5 bg-white border border-gray-300 rounded focus:border-[#00a2ff] focus:outline-none"
            />
            <span class="absolute left-2 top-2 text-gray-400 text-xs">✏</span>
          </div>
        </div>

        <!-- PHÍA PHẢI CỦA CỘT TRÁI: TỔNG KẾT TIỀN HÀNG -->
        <div class="flex items-center gap-5 text-xs tabular-nums">
          <div class="text-right">
            <span class="text-[11px] text-gray-500 block">Tổng tiền hàng (<span id="summaryItemCount" class="font-bold text-gray-700">0</span> món)</span>
            <span id="summaryGrossAmount" class="font-bold text-gray-800 text-sm">0</span>
          </div>
          <div class="text-right">
            <span class="text-[11px] text-gray-500 block">Giảm giá</span>
            <span id="summaryDiscountText" class="font-semibold text-gray-700 text-sm">0</span>
          </div>
          <div class="text-right pl-3 border-l border-gray-200">
            <span class="text-[11px] font-semibold text-gray-600 uppercase block">Khách cần trả</span>
            <span id="summaryNetAmount" class="font-extrabold text-[#0070d2] text-lg">0</span>
          </div>
        </div>
      </div>
    </section>

    <!-- CỘT PHẢI: CHI TIẾT KHÁCH HÀNG (THỐNG NHẤT 100%) & THANH TOÁN / GIAO HÀNG THOÁNG ĐÃNG -->
    <aside id="rightPanel" class="w-[420px] xl:w-[480px] bg-white flex flex-col overflow-hidden shrink-0 shadow-lg z-10">
      
      <!-- TOP CỦA RIGHT PANEL: THÔNG TIN NHÂN VIÊN & KHỐI KHÁCH HÀNG THỐNG NHẤT -->
      <div class="p-3.5 pb-2.5 border-b border-gray-100 shrink-0 space-y-2.5 bg-white">
        <!-- Hàng nhân viên & giờ -->
        <div class="flex items-center justify-between text-xs text-gray-500">
          <div class="flex items-center gap-1 text-gray-700 font-medium">
            <span>Người bán:</span>
            <select disabled id="quickSellerSelect" class="bg-transparent font-bold text-gray-900 border-0 focus:outline-none cursor-pointer">
<option value={principal?.username}>{principal?.name}</option>
            </select>
          </div>
          <div class="text-gray-400 tabular-nums">{nowStr}</div>
        </div>

        <!-- CHUYỂN NHANH BÁN HÀNG <-> ĐẶT HÀNG (CHUẨN KIOTVIET) -->
        <div class="flex items-center justify-between bg-blue-50/70 p-2 rounded-lg border border-blue-200 shadow-2xs">
          <div class="flex items-center gap-1.5">
            <span class="text-xs font-semibold text-gray-600">Chế độ:</span>
            <span id="currentOrderTypeBadge" class="px-2.5 py-0.5 rounded text-[11px] font-extrabold bg-[#0b4d9c] text-white tracking-wide">
              ⚡ BÁN HÀNG
            </span>
          </div>
          <button
            type="button"
            id="toggleOrderTypeBtn"
            class="px-2.5 py-1 rounded bg-white hover:bg-amber-50 text-amber-800 border border-amber-300 text-xs font-bold transition flex items-center gap-1 shadow-2xs cursor-pointer"
            title="Bấm để chuyển đổi nhanh Bán hàng ⇄ Đặt hàng (Giữ nguyên toàn bộ giỏ hàng & thông tin)"
          >
            <span id="toggleOrderTypeBtnText">⇄ Đổi sang Đặt hàng</span>
          </button>
        </div>

        <!-- KHỐI CHỌN KHÁCH HÀNG THỐNG NHẤT (DÙNG CHUNG CẢ BÁN NHANH & BÁN GIAO HÀNG) -->
        <div class="relative">
          <!-- HỘP HIỂN THỊ KHÁCH HÀNG ĐÃ CHỌN (CHUẨN FORM KHÁCH HÀNG KIOTVIET) -->
          <div id="customerSelectedBox" class="hidden p-2.5 rounded-lg bg-blue-50/90 border border-blue-200 text-xs relative shadow-xs">
            <button type="button" id="removeCustomerBtn" class="absolute top-2 right-2 text-gray-400 hover:text-red-500 font-bold p-1 cursor-pointer" title="Bỏ chọn khách hàng">✕</button>
            <div class="flex items-center gap-2 pr-6">
              <span class="px-1.5 py-0.5 rounded bg-blue-100 text-blue-800 font-mono font-bold text-[11px]" id="custBoxCode">KH0001</span>
              <span class="font-bold text-gray-900 text-sm truncate" id="custBoxName">Anh Tuấn</span>
            </div>
            <div class="flex items-center gap-3 text-gray-600 mt-1 text-[11.5px]">
              <span id="custBoxPhone">📞 0988776655</span>
              <span id="custBoxDebtBadge" class="inline-block px-1.5 py-0.5 rounded bg-red-100 text-red-700 font-bold text-[11px] tabular-nums">
                Nợ: 0
              </span>
            </div>
            <div id="custBoxAddressRow" class="text-[11.5px] text-gray-500 mt-1 flex items-start gap-1">
              <span>📍</span>
              <span class="truncate" id="custBoxAddress">Địa chỉ...</span>
            </div>
          </div>

          <!-- Ô TÌM KIẾM KHÁCH HÀNG CHUẨN (F2) -->
          <div id="customerSearchInputWrapper" class="relative">
            <input
              type="text"
              id="customerSearchInput"
              placeholder="Tìm khách hàng (F2 hoặc Tên, SĐT, Mã KH)..."
              autocomplete="off"
              class="w-full h-9 pl-8 pr-16 bg-white border border-gray-300 rounded text-xs focus:border-[#00a2ff] focus:outline-none shadow-xs"
            />
            <svg class="w-4 h-4 text-gray-400 absolute left-2.5 top-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            <button
              type="button"
              id="openAddCustomerModalBtn" disabled={isStaff} title={isStaff ? 'Chỉ chủ cửa hàng được dùng chức năng này' : undefined}

              class="absolute right-1 top-1 px-2.5 py-1 bg-blue-600 hover:bg-blue-700 text-white rounded text-xs font-bold transition flex items-center gap-1 cursor-pointer"
            >
              <span>+ Mới</span>
            </button>
          </div>

          <!-- DROPDOWN KẾT QUẢ TÌM KIẾM KHÁCH HÀNG -->
          <div id="customerSearchResults" class="hidden absolute top-full left-0 right-0 mt-1 bg-white rounded-md shadow-2xl border border-gray-200 max-h-72 overflow-y-auto z-50 divide-y divide-gray-100">
            <!-- Render động qua JS -->
          </div>
        </div>
      </div>

      <!-- PHẦN 1: CHẾ ĐỘ ⚡ BÁN NHANH (KHÁCH TRƯỚC MẶT BÁN LUÔN - NO SHIPPING) -->
      <div id="quickSalePanel" class="flex-1 flex flex-col justify-between p-3.5 overflow-y-auto">
        <div class="space-y-3.5">
          
          <!-- BẢNG TÍNH TIỀN CHI TIẾT BÁN NHANH -->
          <div class="space-y-2.5 pt-1 text-xs">
            <div class="flex items-center justify-between text-gray-600">
              <span>Tổng tiền hàng:</span>
              <span id="quickGrossAmount" class="font-bold text-gray-900 text-sm tabular-nums">0</span>
            </div>

            <div class="flex items-center justify-between text-gray-600">
              <span>Giảm giá hóa đơn:</span>
              <div class="w-32">
                <input
                  type="text"
                  id="quickDiscountInput" disabled={!authority.discount}
                  value="0"
                  class="w-full h-7 px-2 text-right bg-white border border-gray-300 rounded text-xs font-medium focus:border-[#00a2ff] focus:outline-none tabular-nums"
                />
              </div>
            </div>

            <div class="flex items-center justify-between text-gray-900 font-bold pt-2 border-t border-dashed border-gray-200">
              <span class="text-sm">Khách cần trả:</span>
              <span id="quickNetAmount" class="text-lg text-[#0070d2] font-extrabold tabular-nums">0</span>
            </div>

            <!-- Dòng hiển thị tiền cọc nếu đang ở chế độ Xử lý đơn đặt hàng -->
            <div id="preorderDepositRow" class="hidden text-xs rounded-md bg-amber-50 border border-amber-200 p-2 space-y-1 text-amber-900">
              <div class="flex items-center justify-between">
                <span>Tiền đã cọc trước:</span>
                <span id="quickDepositAmount" class="font-bold tabular-nums text-emerald-700">0</span>
              </div>
              <div class="flex items-center justify-between font-bold text-amber-950 pt-1 border-t border-amber-200">
                <span>Còn lại cần thanh toán:</span>
                <span id="quickRemainingAmount" class="text-blue-700 tabular-nums">0</span>
              </div>
            </div>

            <div class="flex items-center justify-between text-gray-900 font-medium pt-1">
              <span id="quickPaidLabel">Khách thanh toán:</span>
              <div class="w-36">
                <input
                  type="text"
                  id="quickPaidInput"
                  value="0"
                  class="w-full h-8 px-2 text-right bg-white border-2 border-blue-400 rounded text-sm font-bold text-gray-900 focus:outline-none tabular-nums"
                />
              </div>
            </div>

            <div class="flex items-center justify-between text-gray-500 pt-1 text-xs">
              <span>Tiền thừa trả khách:</span>
              <span id="quickChangeAmount" class="font-bold text-emerald-600 text-sm tabular-nums">0</span>
            </div>
          </div>

          <!-- PHƯƠNG THỨC THANH TOÁN (TIỀN MẶT, CHUYỂN KHOẢN, THẺ) -->
          <div class="pt-3 border-t border-gray-100">
            <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-2">Phương thức thanh toán</label>
            <div class="grid grid-cols-2 gap-2">
              <label class="flex items-center justify-center gap-1.5 p-2 rounded border border-blue-500 bg-blue-50 text-[#0b4d9c] text-xs font-bold cursor-pointer transition" id="lblMethodCash">
                <input type="radio" name="quickPaymentMethod" value="CASH" checked class="hidden" />
                <span>💵 Tiền mặt</span>
              </label>
              <label class="flex items-center justify-center gap-1.5 p-2 rounded border border-gray-200 bg-white hover:bg-gray-50 text-gray-700 text-xs font-medium cursor-pointer transition" id="lblMethodBank">
                <input type="radio" name="quickPaymentMethod" value="BANK" class="hidden" />
                <span>💳 Chuyển khoản</span>
              </label>
              <label class="flex items-center justify-center gap-1.5 p-2 rounded border border-gray-200 bg-white hover:bg-gray-50 text-gray-700 text-xs font-medium cursor-pointer transition" id="lblMethodCard">
                <input type="radio" name="quickPaymentMethod" value="CARD" class="hidden" />
                <span>🏧 Quẹt thẻ</span>
              </label>
              <label class="flex items-center justify-center gap-1.5 p-2 rounded border border-gray-200 bg-white text-gray-700 text-xs cursor-pointer transition" id="lblMethodCredit">
                <input type="radio" name="quickPaymentMethod" value="CREDIT" disabled={!authority.credit} class="hidden" />
                <span>Số dư khách</span>
              </label>
            </div>
          </div>

          <!-- GỢI Ý MỆNH GIÁ TIỀN MẶT -->
          <div class="pt-2">
            <label class="block text-[11px] font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Gợi ý tiền khách đưa</label>
            <div class="flex flex-wrap gap-1.5" id="denominationSuggestions">
              <!-- Render động qua JS -->
            </div>
          </div>
        </div>

        <!-- CÁC NÚT HÀNH ĐỘNG BÁN NHANH DƯỚI CÙNG -->
        <div class="pt-4 border-t border-gray-200 flex items-center gap-2">
          <button
            type="button"
            id="quickPrintTempBtn"
            class="w-24 h-11 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold rounded text-xs transition flex items-center justify-center gap-1 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
            </svg>
            In (F8)
          </button>

          <button
            type="button"
            id="quickCheckoutBtn"
            class="flex-1 h-11 bg-[#0070d2] hover:bg-[#005bb5] active:bg-[#004a94] text-white font-extrabold text-sm rounded shadow transition flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
            </svg>
            THANH TOÁN (F9)
          </button>
        </div>
      </div>

      <!-- PHẦN 2: CHẾ ĐỘ 🚚 BÁN GIAO HÀNG & ĐẶT HÀNG (FULL CHIỀU CAO THOÁNG ĐÃNG) -->
      <div id="deliverySalePanel" class="hidden flex-1 flex flex-col justify-between p-3.5 overflow-y-auto">
        <div class="space-y-3">
          
          <!-- KHỐI CHỌN ĐỐI TƯỢNG VẬN CHUYỂN: 2 TABS (TỰ GIAO HÀNG / CHÀNH XE vs CỔNG TÍCH HỢP) -->
          <div class="flex rounded-lg border border-gray-200 p-1 bg-gray-50 text-xs font-semibold">
            <button
              type="button"
              id="tabShipSelfBtn"
              class="flex-1 py-1.5 rounded-md bg-white text-[#0b4d9c] shadow-xs font-bold transition flex items-center justify-center gap-1.5 cursor-pointer"
            >
              <span>🛵 Tự giao / Chành xe</span>
            </button>
            <button
              type="button"
              id="tabShipIntegratedBtn"
              class="flex-1 py-1.5 rounded-md text-gray-600 hover:text-gray-900 transition flex items-center justify-center gap-1.5 cursor-pointer"
            >
              <span>🚚 Hãng vận chuyển (GHN/J&T)</span>
            </button>
          </div>

          <!-- KHỐI ĐỊA CHỈ NHẬN HÀNG CỦA KHÁCH (TỰ ĐIỀN TỪ KHÁCH HÀNG ĐÃ CHỌN) -->
          <div class="bg-gray-50 p-2.5 rounded-lg border border-gray-200 space-y-2 text-xs">
            <div class="flex items-center justify-between font-bold text-gray-700">
              <span class="flex items-center gap-1">📍 Thông tin người nhận hàng</span>
              <span id="deliveryCustDebtText" class="text-red-600 font-bold text-[11px]"></span>
            </div>

            <div class="grid grid-cols-2 gap-2">
              <input
                type="text"
                id="shipReceiverName"
                placeholder="Tên người nhận *"
                class="w-full h-7.5 px-2 bg-white border border-gray-300 rounded text-xs focus:border-[#00a2ff] focus:outline-none"
              />
              <input
                type="text"
                id="shipReceiverPhone"
                placeholder="SĐT người nhận *"
                class="w-full h-7.5 px-2 bg-white border border-gray-300 rounded text-xs focus:border-[#00a2ff] focus:outline-none"
              />
            </div>

            <input
              type="text"
              id="shipReceiverAddress"
              placeholder="Địa chỉ giao hàng (Số nhà, đường, xã, huyện, tỉnh)..."
              class="w-full h-7.5 px-2 bg-white border border-gray-300 rounded text-xs focus:border-[#00a2ff] focus:outline-none"
            />
          </div>

          <!-- THÔNG SỐ KIỆN HÀNG (TRỌNG LƯỢNG & KÍCH THƯỚC) -->
          <div class="bg-gray-50 p-2.5 rounded-lg border border-gray-200 space-y-2 text-xs">
            <div class="flex items-center justify-between font-bold text-gray-700">
              <span>📦 Kiện hàng (Máy / Linh kiện)</span>
              <span class="text-gray-400 font-normal">1 kiện</span>
            </div>
            <div class="grid grid-cols-3 gap-2">
              <div>
                <label class="block text-[10.5px] text-gray-500 mb-0.5">Khối lượng (gram)</label>
                <input
                  type="number"
                  id="shipWeightGram"
                  value="1500"
                  class="w-full h-7 px-2 bg-white border border-gray-300 rounded text-xs font-semibold focus:outline-none tabular-nums"
                />
              </div>
              <div class="col-span-2">
                <label class="block text-[10.5px] text-gray-500 mb-0.5">Kích thước D x R x C (cm)</label>
                <input
                  type="text"
                  id="shipDimensions"
                  value="40 x 20 x 12"
                  class="w-full h-7 px-2 bg-white border border-gray-300 rounded text-xs focus:outline-none tabular-nums"
                />
              </div>
            </div>
          </div>

          <!-- VÙNG CẤU HÌNH VẬN CHUYỂN THEO TAB -->
          
          <!-- TAB 1: TỰ GIAO HÀNG / CHÀNH XE (HOẠT ĐỘNG THỰC TẾ XƯỞNG KGAME) -->
          <div id="shipSelfSection" class="space-y-2 text-xs">
            <div>
              <label class="block text-[11px] font-bold text-gray-600 mb-1">Chọn đối tác / Chành xe gửi:</label>
              <select id="shipPartnerSelect" class="w-full h-8 px-2 bg-white border border-gray-300 rounded text-xs font-medium focus:border-[#00a2ff] focus:outline-none">
                <option value="">-- Chọn chành xe hoặc shipper --</option>
                {deliveryPartners.map((dp: any) => (
                  <option value={dp.id} data-name={dp.name} data-type={dp.partner_type}>
                    {dp.name} ({dp.partner_type === 'BUS' ? 'Chành xe' : dp.partner_type === 'INTEGRATED' ? 'Hãng' : 'Shipper riêng'})
                  </option>
                ))}
              </select>
            </div>

            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-[10.5px] text-gray-500 mb-0.5">Bến xe / Bãi nhận</label>
                <input
                  type="text"
                  id="shipBusStation"
                  placeholder="VD: Trạm Tô Châu Bến Tre"
                  class="w-full h-7 px-2 bg-white border border-gray-300 rounded text-xs focus:outline-none"
                />
              </div>
              <div>
                <label class="block text-[10.5px] text-gray-500 mb-0.5">Mã vận đơn / Số xe</label>
                <input
                  type="text"
                  id="shipTrackingCode"
                  placeholder="Số biên nhận nhà xe"
                  class="w-full h-7 px-2 bg-white border border-gray-300 rounded text-xs focus:outline-none"
                />
              </div>
            </div>

            <div class="grid grid-cols-2 gap-2 pt-0.5">
              <div>
                <label class="block text-[10.5px] text-gray-500 mb-0.5">Phí cước nhà xe</label>
                <input
                  type="text"
                  id="shipFeeInput"
                  value="0"
                  class="w-full h-7 px-2 text-right bg-white border border-gray-300 rounded text-xs font-semibold focus:outline-none tabular-nums"
                />
              </div>
              <div>
                <label class="block text-[10.5px] text-gray-500 mb-0.5">Ai trả cước xe?</label>
                <select id="shipPayerSelect" class="w-full h-7 px-2 bg-white border border-gray-300 rounded text-xs focus:outline-none">
                  <option value="BUYER_PAYS" selected>Khách trả tại trạm</option>
                  <option value="SHOP_PAYS">Xưởng Kgame trả trước</option>
                </select>
              </div>
            </div>
          </div>

          <!-- TAB 2: HÃNG VẬN CHUYỂN API (CHỈ HIỂN THỊ KHI ĐÃ KẾT NỐI API, CHƯA KẾT NỐI THÌ THÔNG BÁO) -->
          <div id="shipIntegratedSection" class="hidden space-y-2.5 text-xs">
            <div class="p-3.5 rounded-lg bg-amber-50 border border-amber-200 text-amber-900 space-y-2">
              <div class="flex items-center gap-2 font-bold text-amber-800">
                <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                <span>Chưa kết nối API đơn vị vận chuyển</span>
              </div>
              <p class="text-[11.5px] text-amber-700 leading-relaxed">
                Hệ thống chưa kết nối API với các cổng vận chuyển (GHN, J&T Express, Viettel Post). Thông tin đơn hàng và cước phí tự động chỉ hiển thị khi đã kết nối API thành công.
              </p>
              <div class="pt-1 flex items-center gap-2">
                <button type="button" id="switchToSelfShipBtn" class="px-2.5 py-1 rounded bg-amber-200 hover:bg-amber-300 font-bold text-amber-900 transition text-[11px] cursor-pointer">
                  👉 Chuyển sang "Tự giao / Chành xe"
                </button>
                <a href="/admin/delivery-partners" target="_blank" class="text-blue-600 hover:underline text-[11px]">
                  Cấu hình đối tác &rsaquo;
                </a>
              </div>
            </div>
          </div>

          <!-- TỔNG TIỀN COD & ĐẶT CỌC -->
          <div class="pt-2 border-t border-gray-200 space-y-2 text-xs">
            <div class="flex items-center justify-between">
              <label class="flex items-center gap-1.5 font-bold text-gray-700 cursor-pointer">
                <input type="checkbox" id="enableCodCheckbox" checked class="rounded text-blue-600 focus:ring-0" />
                <span>Thu tiền hộ COD khi giao</span>
              </label>
              <div class="w-36">
                <input
                  type="text"
                  id="shipCodAmountInput"
                  value="0"
                  class="w-full h-7 px-2 text-right bg-white border border-gray-300 rounded text-xs font-bold text-[#0070d2] focus:outline-none tabular-nums"
                />
              </div>
            </div>

            <div class="flex items-center justify-between text-gray-600">
              <span>Khách trả trước / Cọc trước:</span>
              <div class="w-36">
                <input
                  type="text"
                  id="shipPrepaidAmountInput"
                  value="0"
                  class="w-full h-7 px-2 text-right bg-white border border-gray-300 rounded text-xs font-medium focus:outline-none tabular-nums"
                />
              </div>
            </div>

            <div class="flex items-center justify-between pt-1 font-bold text-gray-900 border-t border-dashed border-gray-200">
              <span>Loại phiếu tạo:</span>
              <div class="flex items-center gap-3">
                <label class="flex items-center gap-1 cursor-pointer font-semibold text-blue-700">
                  <input type="radio" name="deliveryOrderType" value="ORDER" checked />
                  <span>⚡ Bán hàng</span>
                </label>
                <label class="flex items-center gap-1 cursor-pointer font-semibold text-amber-700">
                  <input type="radio" name="deliveryOrderType" value="PREORDER" />
                  <span>📋 Đặt hàng</span>
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- CÁC NÚT HÀNH ĐỘNG GIAO HÀNG -->
        <div class="pt-3 border-t border-gray-200 flex items-center gap-2">
          <button
            type="button"
            id="deliveryPrintWaybillBtn"
            class="w-28 h-11 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold rounded text-xs transition flex items-center justify-center gap-1 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
            </svg>
            In phiếu xe
          </button>

          <button
            type="button"
            id="deliverySubmitBtn"
            class="flex-1 h-11 bg-[#0070d2] hover:bg-[#005bb5] active:bg-[#004a94] text-white font-extrabold text-sm rounded shadow transition flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span id="deliverySubmitText">TẠO ĐƠN & GIAO HÀNG</span>
          </button>
        </div>
      </div>
    </aside>
  </main>

  <!-- MODAL 1: CHỌN MÃ BỘ / SERIAL KHI BÁN HÀNG CÓ MÃ CODE -->
  <div id="unitSelectionModal" class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-2xl border border-gray-200 w-full max-w-lg overflow-hidden flex flex-col max-h-[85vh]">
      <div class="p-3.5 bg-[#0b4d9c] text-white flex items-center justify-between">
        <div>
          <h3 class="font-bold text-sm flex items-center gap-2">
            <span>🎮</span>
            <span id="unitModalProductTitle">Chọn Mã Bộ / Serial Máy Game</span>
          </h3>
          <p class="text-[11px] text-blue-200 mt-0.5" id="unitModalProductSubtitle">Vui lòng chọn đúng mã bo mạch / máy thực tế bán ra</p>
        </div>
        <button type="button" id="closeUnitModalBtn" class="text-white/80 hover:text-white font-bold text-base px-1 cursor-pointer">✕</button>
      </div>

      <!-- Ô TÌM NHANH MÃ BỘ -->
      <div class="p-3 border-b border-gray-100 bg-gray-50 flex items-center gap-2">
        <div class="relative flex-1">
          <input
            type="text"
            id="unitSearchInput"
            placeholder="Lọc mã bộ (VD: BC-001, G01...)"
            class="w-full h-8 pl-8 pr-3 text-xs bg-white border border-gray-300 rounded focus:border-[#00a2ff] focus:outline-none"
          />
          <svg class="w-3.5 h-3.5 text-gray-400 absolute left-2.5 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
        <div class="text-[11px] text-gray-500 shrink-0">
          Còn trong kho: <strong id="unitModalStockCount" class="text-blue-600 font-bold">0</strong> mã
        </div>
      </div>

      <!-- DANH SÁCH CÁC MÃ BỘ CÒN TRONG KHO (IN_STOCK) -->
      <div id="unitModalList" class="flex-1 overflow-y-auto p-3 space-y-2 divide-y divide-gray-100">
        <!-- Render động qua JS -->
      </div>

      <div class="p-3 bg-gray-50 border-t border-gray-200 flex items-center justify-between text-xs">
        <span class="text-gray-500 text-[11px]">Bấm vào mã bộ để chọn đưa vào đơn hàng</span>
        <button type="button" id="cancelUnitModalBtn" class="px-3 py-1.5 rounded bg-gray-200 hover:bg-gray-300 font-medium text-gray-700 cursor-pointer">Đóng</button>
      </div>
    </div>
  </div>

  <!-- MODAL 2: THÊM KHÁCH HÀNG MỚI (ĐỒNG BỘ 100% CẤU TRÚC 3 CẤP ĐỊA CHỈ NHƯ TRANG KHÁCH HÀNG) -->
  <div id="newCustomerModal" class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4">
    <div class="w-full max-w-lg bg-white rounded-2xl border border-gray-200 shadow-2xl overflow-hidden animate-in fade-in zoom-in duration-150">
      <div class="p-3.5 bg-[#0b4d9c] text-white flex items-center justify-between">
        <h3 class="font-bold text-sm flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          Thêm Khách Hàng Mới (Chuẩn 3 cấp KiotViet)
        </h3>
        <button type="button" id="closeAddCustomerModalBtn" class="text-white/80 hover:text-white font-bold text-base px-1 cursor-pointer">✕</button>
      </div>

      <div class="p-4 space-y-3 text-xs">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <div>
            <label class="block text-gray-700 font-medium mb-1">Tên khách hàng <span class="text-red-500">*</span></label>
            <input
              type="text"
              id="modalNewCustName"
              placeholder="VD: Anh Tuấn Biên Hòa"
              class="w-full h-8 px-2.5 bg-white border border-gray-300 rounded text-xs focus:border-[#00a2ff] focus:outline-none"
            />
          </div>


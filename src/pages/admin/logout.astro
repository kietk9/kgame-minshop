---
export const prerender = false;
import { env } from 'cloudflare:workers';
import { logoutStaff } from '../../features/auth/staff';
await logoutStaff(env.DB,Astro.cookies.get('staff_session')?.value);
Astro.cookies.delete('staff_session',{path:'/'});
// Clears the admin session cookie and returns to the login form. Reached only
// when already authenticated (it's under the protected /admin/* path).
Astro.cookies.delete('admin_session', { path: '/' });
return Astro.redirect('/admin/login', 303);
---

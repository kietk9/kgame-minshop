---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';

// 1. Lấy danh sách thành phẩm cần sản xuất (loại quản lý theo CODE)
const { results: outputProducts } = await env.DB.prepare(`
  SELECT p.id, p.name, p.product_code, p.default_manufacturer
  FROM products p
  WHERE p.tracking_mode = 'CODE'
  ORDER BY p.id DESC
`).all<any>();

// 2. Lấy danh sách phân loại của các thành phẩm đó
const { results: outputTypes } = await env.DB.prepare(`
  SELECT pt.id, pt.product_id, pt.name, pt.sale_price_cents, pt.cost_price_cents
  FROM product_types pt
  JOIN products p ON pt.product_id = p.id
  WHERE p.tracking_mode = 'CODE'
  ORDER BY pt.sort_order ASC, pt.id ASC
`).all<any>();

// 3. Lấy danh sách linh kiện đầu vào (BOM components)
const { results: components } = await env.DB.prepare(`
  SELECT p.id, p.name, p.product_code, p.stock, pt.id AS type_id, pt.name AS type_name, pt.cost_price_cents
  FROM products p
  LEFT JOIN product_types pt ON pt.product_id = p.id
  WHERE p.category_id = 12 OR p.tracking_mode = 'QUANTITY'
  ORDER BY p.name ASC
`).all<any>();

const error = Astro.url.searchParams.get('error');

function formatNumber(cents: number) {
  if (!cents || isNaN(cents)) return '0';
  return new Intl.NumberFormat('en-US').format(cents);
}
const formatVnd = formatNumber;

const inputClass =
  'mt-1 w-full rounded-md border border-line bg-white px-3 py-2 text-sm text-gray-900 focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none';
---

<AdminLayout title="Tạo Lệnh Sản Xuất Mới" active="production">
  <div class="mb-6">
    <a href="/admin/production" class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-brand transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      Quay lại danh sách lệnh sản xuất
    </a>
    <h1 class="mt-2 text-2xl font-bold text-gray-900">Tạo Lệnh Sản Xuất / Ráp Máy Mới</h1>
    <p class="text-sm text-gray-500 mt-1">
      Khấu trừ linh kiện kho thực tế, lắp ráp và sinh mã Program Code kèm cấu hình hạn ẩn USB key.
    </p>
  </div>

  {
    error && (
      <div class="mb-6 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700 flex items-center gap-2">
        <svg class="w-5 h-5 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span>{error}</span>
      </div>
    )
  }

  <form method="POST" action="/api/admin/production" class="max-w-3xl space-y-6">
    <!-- 1. CHỌN THÀNH PHẨM ĐẦU RA -->
    <div class="rounded-xl border border-line bg-surface p-5 space-y-4 shadow-sm">
      <h2 class="text-base font-semibold text-gray-900 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-brand"></span>
        1. Thành phẩm cần lắp ráp
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-800" for="output_product_id">
            Mặt hàng sản xuất <span class="text-red-500">*</span>
          </label>
          <select id="output_product_id" name="output_product_id" required class={inputClass}>
            <option value="">-- Chọn mặt hàng --</option>
            {outputProducts?.map((p: any) => (
              <option value={p.id} data-mfr={p.default_manufacturer}>
                {p.name} ({p.product_code ?? 'Chưa có SKU'})
              </option>
            ))}
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-800" for="output_product_type_id">
            Phiên bản / Phân loại <span class="text-red-500">*</span>
          </label>
          <select id="output_product_type_id" name="output_product_type_id" required class={inputClass}>
            <option value="">-- Chọn phiên bản --</option>
          </select>
        </div>
      </div>
    </div>

    <!-- 2. ĐỊNH MỨC LINH KIỆN ĐẦU VÀO (BOM) -->
    <div class="rounded-xl border border-line bg-surface p-5 space-y-4 shadow-sm">
      <div class="flex items-center justify-between border-b border-line pb-3">
        <div>
          <h2 class="text-base font-semibold text-gray-900 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-brand"></span>
            2. Linh kiện đầu vào (Khấu trừ sổ kho)
          </h2>
          <p class="text-xs text-gray-500 mt-0.5">
            Linh kiện được chọn sẽ được xuất kho tự động (loại PRODUCTION_USE) ngay khi bấm hoàn tất.
          </p>
        </div>
        <button
          type="button"
          id="btnAddBomItem"
          class="inline-flex items-center gap-1 text-xs font-bold text-brand bg-brand/10 hover:bg-brand hover:text-white px-3 py-1.5 rounded-lg transition"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          <span>+ Thêm linh kiện</span>
        </button>
      </div>

      <div id="bomList" class="space-y-3">
        <!-- Dòng linh kiện mẫu 1: Chip USB Key -->
        <div class="bom-row grid grid-cols-12 gap-3 items-end p-3 rounded-lg border border-line bg-white">
          <div class="col-span-7">
            <label class="block text-xs font-medium text-gray-700">Linh kiện lấy từ kho</label>
            <select name="input_product_id[]" required class={inputClass}>
              <option value="">-- Chọn linh kiện --</option>
              {components?.map((c: any) => (
                <option value={c.id} data-stock={c.stock} selected={c.name.includes('Chip USB')}>
                  {c.name} ({c.product_code}) — Tồn kho: {c.stock} cái
                </option>
              ))}
            </select>
          </div>
          <div class="col-span-3">
            <label class="block text-xs font-medium text-gray-700">Số lượng cần dùng</label>
            <input
              name="input_quantity[]"
              type="number"
              min="1"
              value="1"
              required
              class={inputClass}
            />
          </div>
          <div class="col-span-2 flex justify-center pb-1">
            <button
              type="button"
              class="btn-remove-bom text-gray-400 hover:text-red-500 p-1 rounded transition"
              title="Bỏ linh kiện này"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>
        </div>

        <!-- Dòng linh kiện mẫu 2: Mainboard -->
        <div class="bom-row grid grid-cols-12 gap-3 items-end p-3 rounded-lg border border-line bg-white">
          <div class="col-span-7">
            <label class="block text-xs font-medium text-gray-700">Linh kiện lấy từ kho</label>
            <select name="input_product_id[]" required class={inputClass}>
              <option value="">-- Chọn linh kiện --</option>
              {components?.map((c: any) => (
                <option value={c.id} data-stock={c.stock} selected={c.name.includes('Mainboard')}>
                  {c.name} ({c.product_code}) — Tồn kho: {c.stock} cái
                </option>
              ))}
            </select>
          </div>
          <div class="col-span-3">
            <label class="block text-xs font-medium text-gray-700">Số lượng cần dùng</label>
            <input
              name="input_quantity[]"
              type="number"
              min="1"
              value="1"
              required
              class={inputClass}
            />
          </div>
          <div class="col-span-2 flex justify-center pb-1">
            <button
              type="button"
              class="btn-remove-bom text-gray-400 hover:text-red-500 p-1 rounded transition"
              title="Bỏ linh kiện này"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. CẤP MÃ BỘ & CẤU HÌNH THỜI HẠN ẨN USB -->
    <div class="rounded-xl border border-indigo-200 bg-indigo-50/50 p-5 space-y-4 shadow-sm">
      <div class="flex items-center justify-between border-b border-indigo-100 pb-3">
        <h2 class="text-base font-semibold text-indigo-950 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-indigo-600"></span>
          3. Cấp Mã bộ & Cấu hình Thời hạn ẩn USB Key
        </h2>
        <span class="text-xs px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 font-medium">
          🔒 Chỉ người sản xuất / Admin thấy
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-gray-800" for="program_code">
            Mã bộ xuất xưởng (Program Code) <span class="text-red-500">*</span>
          </label>
          <input
            id="program_code"
            name="program_code"
            type="text"
            required
            placeholder="VD: 777-62028888"
            class={inputClass}
          />
          <p class="mt-1 text-xs text-gray-500">Mã định danh duy nhất cho bộ máy vừa ráp xong.</p>
        </div>

        <div id="expiryWrapper">
          <label class="block text-xs font-semibold text-gray-800" for="expiry_days">
            Thời hạn ẩn USB Key (Gói ngày)
          </label>
          <select id="expiry_days" name="expiry_days" class={inputClass}>
            <option value="400" selected>400 ngày (~13 tháng - Tiêu chuẩn)</option>
            <option value="200">200 ngày (~6.5 tháng)</option>
            <option value="100">100 ngày (~3.3 tháng)</option>
            <option value="60">60 ngày (~2 tháng)</option>
            <option value="30">30 ngày (~1 tháng)</option>
          </select>
          <p class="mt-1 text-xs text-gray-500">Tự động cộng từ ngày sản xuất hôm nay.</p>
        </div>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-700" for="note">
          Ghi chú sản xuất / thợ lắp ráp
        </label>
        <input
          id="note"
          name="note"
          type="text"
          placeholder="VD: Ráp main mới test chuẩn, đã nạp key 400 ngày"
          class={inputClass}
        />
      </div>
    </div>

    <!-- NÚT HOÀN TẤT -->
    <div class="flex items-center gap-3 pt-2">
      <button
        type="submit"
        class="rounded-lg bg-brand px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-hover transition-colors"
      >
        Xác nhận & Hoàn tất Sản xuất
      </button>
      <a
        href="/admin/production"
        class="rounded-lg border border-line px-5 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-100 transition-colors"
      >
        Hủy bỏ
      </a>
    </div>
  </form>
</AdminLayout>

<script define:vars={{ outputTypes, components }}>
  function setupProductionForm() {
    const productSelect = document.getElementById('output_product_id');
    const typeSelect = document.getElementById('output_product_type_id');
    const btnAddBom = document.getElementById('btnAddBomItem');
    const bomList = document.getElementById('bomList');
    const expiryWrapper = document.getElementById('expiryWrapper');

    function updateVersions() {
      if (!productSelect || !typeSelect) return;
      const selectedProductId = Number(productSelect.value);
      const filteredTypes = outputTypes.filter((t) => t.product_id === selectedProductId);

      typeSelect.innerHTML = '';
      if (filteredTypes.length === 0) {
        typeSelect.innerHTML = '<option value="">-- Chưa có phiên bản nào --</option>';
        return;
      }

      filteredTypes.forEach((t) => {
        const opt = document.createElement('option');
        opt.value = String(t.id);
        opt.textContent = `Bản ${t.name}`;
        typeSelect.appendChild(opt);
      });

      // Check manufacturer of selected product:
      const selectedOption = productSelect.options[productSelect.selectedIndex];
      const mfr = selectedOption ? selectedOption.getAttribute('data-mfr') : '';
      if (expiryWrapper) {
        const isSelf = !mfr || mfr === 'Tôi sản xuất';
        expiryWrapper.style.display = isSelf ? 'block' : 'none';
      }
    }

    productSelect?.addEventListener('change', updateVersions);
    updateVersions();

    // Add BOM item
    btnAddBom?.addEventListener('click', () => {
      if (!bomList) return;
      const row = document.createElement('div');
      row.className = 'bom-row grid grid-cols-12 gap-3 items-end p-3 rounded-lg border border-line bg-white';
      
      let optionsHtml = '<option value="">-- Chọn linh kiện --</option>';
      components.forEach((c) => {
        optionsHtml += `<option value="${c.id}" data-stock="${c.stock}">${c.name} (${c.product_code}) — Tồn kho: ${c.stock} cái</option>`;
      });

      row.innerHTML = `
        <div class="col-span-7">
          <label class="block text-xs font-medium text-gray-700">Linh kiện lấy từ kho</label>
          <select name="input_product_id[]" required class="mt-1 w-full rounded-md border border-line bg-white px-3 py-2 text-sm text-gray-900 focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none">
            ${optionsHtml}
          </select>
        </div>
        <div class="col-span-3">
          <label class="block text-xs font-medium text-gray-700">Số lượng cần dùng</label>
          <input
            name="input_quantity[]"
            type="number"
            min="1"
            value="1"
            required
            class="mt-1 w-full rounded-md border border-line bg-white px-3 py-2 text-sm text-gray-900 focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none"
          />
        </div>
        <div class="col-span-2 flex justify-center pb-1">
          <button
            type="button"
            class="btn-remove-bom text-gray-400 hover:text-red-500 p-1 rounded transition"
            title="Bỏ linh kiện này"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          </button>
        </div>
      `;

      bomList.appendChild(row);
      const btnRemove = row.querySelector('.btn-remove-bom');
      btnRemove?.addEventListener('click', () => row.remove());
    });

    // Remove buttons on initial rows
    document.querySelectorAll('.btn-remove-bom').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const row = e.target instanceof Element ? e.target.closest('.bom-row') : null;
        row?.remove();
      });
    });
  }

  setupProductionForm();
  document.addEventListener('astro:page-load', setupProductionForm);
</script>

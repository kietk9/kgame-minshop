---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';

// Lấy danh sách lệnh sản xuất
const { results: orders } = await env.DB.prepare(`
  SELECT 
    po.*,
    p.name AS output_product_name,
    p.product_code AS output_product_code,
    pt.name AS output_version_name,
    pou.product_unit_id,
    pu.program_code,
    pou.expiry_days,
    pou.expiry_date
  FROM production_orders po
  JOIN products p ON po.output_product_id = p.id
  JOIN product_types pt ON po.output_product_type_id = pt.id
  LEFT JOIN production_outputs pou ON pou.production_order_id = po.id
  LEFT JOIN product_units pu ON pou.product_unit_id = pu.id
  ORDER BY po.id DESC
  LIMIT 50
`).all<any>();

const orderList = orders ?? [];
---

<AdminLayout title="Lắp ráp & Đóng gói combo" active="production">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Lắp ráp &amp; Đóng gói combo</h1>
      <p class="mt-1 text-sm text-gray-500">
        Quy trình lắp ráp bộ máy hoàn chỉnh từ linh kiện: Trừ kho linh kiện rời, đóng gói thành phẩm và sinh mã Serial/Program Code.
      </p>
    </div>
    <a
      href="/admin/production/new"
      class="inline-flex items-center gap-1.5 rounded-lg bg-brand px-4 py-2.5 text-xs font-semibold uppercase tracking-wider text-white shadow-sm transition hover:bg-brand-hover hover:shadow"
    >
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Tạo đợt lắp ráp mới
    </a>
  </div>

  <div class="rounded-xl border border-line bg-white shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-[14.5px]">
        <thead class="bg-[#f8f9fa] border-b border-line text-[14px] text-gray-700 font-semibold select-none">
          <tr>
            <th class="px-5 py-3.5">Mã đợt ráp</th>
            <th class="px-5 py-3.5">Thành phẩm lắp ráp</th>
            <th class="px-4 py-3.5">Phiên bản</th>
            <th class="px-5 py-3.5">Mã bộ sinh ra (Program Code)</th>
            <th class="px-4 py-3.5">Thời hạn ẩn USB</th>
            <th class="px-4 py-3.5 text-center">Trạng thái</th>
            <th class="px-5 py-3.5 text-right">Ngày hoàn tất</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {
            orderList.map((ord: any) => (
              <tr class="hover:bg-blue-50/40 transition">
                <td class="px-5 py-4 text-[14px] text-blue-600 font-normal whitespace-nowrap">
                  {ord.production_code}
                </td>
                <td class="px-5 py-4">
                  <div class="font-normal text-gray-900 text-[14.5px]">{ord.output_product_name}</div>
                  <span class="text-[12px] text-gray-400">{ord.output_product_code}</span>
                </td>
                <td class="px-4 py-4 whitespace-nowrap">
                  <span class="font-medium text-gray-700 bg-gray-100 px-2 py-0.5 rounded text-[12px]">
                    Bản {ord.output_version_name}
                  </span>
                </td>
                <td class="px-5 py-4 whitespace-nowrap tabular-nums text-[13.5px]">
                  {ord.program_code ? (
                    <a
                      href={`/admin/units/lookup?code=${encodeURIComponent(ord.program_code)}`}
                      class="text-blue-600 font-normal hover:underline inline-flex items-center gap-1"
                      title="Xem lý lịch 360°"
                    >
                      <span>{ord.program_code}</span>
                      <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    </a>
                  ) : (
                    <span class="text-gray-400 italic">--</span>
                  )}
                </td>
                <td class="px-4 py-4 whitespace-nowrap text-[13px]">
                  {ord.expiry_days ? (
                    <div>
                      <span class="font-medium text-amber-800">{ord.expiry_days} ngày</span>
                      <span class="text-gray-400 block text-[12px]">{ord.expiry_date}</span>
                    </div>
                  ) : (
                    <span class="text-gray-400 italic">--</span>
                  )}
                </td>
                <td class="px-4 py-4 text-center whitespace-nowrap">
                  <span class="rounded px-2.5 py-0.5 text-[12px] font-medium bg-emerald-100 text-emerald-800 border border-emerald-200">
                    Hoàn tất
                  </span>
                </td>
                <td class="px-5 py-4 text-right text-[13px] text-gray-500 whitespace-nowrap">
                  {ord.created_at}
                </td>
              </tr>
            ))
          }
          {
            orderList.length === 0 && (
              <tr>
                <td colspan="7" class="px-6 py-12 text-center text-gray-400 text-sm">
                  Chưa có lệnh sản xuất nào. Hãy bấm "Tạo lệnh sản xuất mới" để ráp máy đầu tiên.
                </td>
              </tr>
            )
          }
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ReportSidebar from '../../../components/admin/ReportSidebar.astro';
import { parseDatePreset } from '../../../features/reports/date-utils';

if (!Astro.locals.settings?.setupComplete) return Astro.redirect('/admin/setup', 302);

const url = new URL(Astro.request.url);
const view = url.searchParams.get('view') || 'chart';
const preset = url.searchParams.get('preset') || 'this_month';
const customFrom = url.searchParams.get('from');
const customTo = url.searchParams.get('to');
const q = url.searchParams.get('q')?.trim() || '';
const categoryId = url.searchParams.get('category') || '';
const condition = url.searchParams.get('condition') || '';

const dateRange = parseDatePreset(preset, customFrom, customTo);

// Lấy danh sách nhóm hàng để lọc
const { results: categories } = await env.DB.prepare(`
  SELECT id, name FROM categories ORDER BY name ASC
`).all<{ id: number; name: string }>();

// Truy vấn tổng kết & chi tiết bán hàng theo từng mặt hàng
let sql = `
  SELECT 
    ol.product_id,
    COALESCE(p.product_code, 'SP' || printf('%06d', ol.product_id)) as product_code,
    ol.product_name_snapshot as name,
    p.public_id,
    p.category_id,
    ol.condition,
    SUM(ol.quantity) as sold_qty,
    SUM(ol.line_total_cents) as gross_revenue,
    0 as return_qty,
    0 as return_amount,
    SUM(ol.line_total_cents) as net_revenue
  FROM order_lines ol
  JOIN orders o ON ol.order_id = o.id
  LEFT JOIN products p ON ol.product_id = p.id
  WHERE DATE(o.created_at) >= ? AND DATE(o.created_at) <= ?
    AND (o.order_status IS NULL OR o.order_status != 'CANCELLED')
`;

const params: any[] = [dateRange.startDate, dateRange.endDate];

if (q) {
  sql += ` AND (ol.product_name_snapshot LIKE ? OR p.product_code LIKE ?)`;
  params.push(`%${q}%`, `%${q}%`);
}

if (categoryId) {
  sql += ` AND p.category_id = ?`;
  params.push(Number(categoryId));
}

if (condition) {
  sql += ` AND ol.condition = ?`;
  params.push(condition);
}

sql += ` GROUP BY ol.product_id, ol.product_name_snapshot ORDER BY net_revenue DESC`;

const { results: rawRows } = await env.DB.prepare(sql).bind(...params).all<{
  product_id: number;
  product_code: string;
  name: string;
  public_id: string | null;
  category_id: number | null;
  condition: string;
  sold_qty: number;
  gross_revenue: number;
  return_qty: number;
  return_amount: number;
  net_revenue: number;
}>();

const rows = rawRows ?? [];

// Tính tổng cộng
const totalItemCount = rows.length;
const totalSoldQty = rows.reduce((s, r) => s + (r.sold_qty || 0), 0);
const totalGrossRevenue = rows.reduce((s, r) => s + (r.gross_revenue || 0), 0);
const totalReturnQty = rows.reduce((s, r) => s + (r.return_qty || 0), 0);
const totalReturnAmount = rows.reduce((s, r) => s + (r.return_amount || 0), 0);
const totalNetRevenue = rows.reduce((s, r) => s + (r.net_revenue || 0), 0);

// Top 10 cho biểu đồ
const top10ByRevenue = [...rows].sort((a, b) => b.net_revenue - a.net_revenue).slice(0, 10);
const maxRevenue = Math.max(1, ...(top10ByRevenue.map(r => r.net_revenue)));

const top10ByQty = [...rows].sort((a, b) => b.sold_qty - a.sold_qty).slice(0, 10);
const maxQty = Math.max(1, ...(top10ByQty.map(r => r.sold_qty)));

function getNiceTicks(maxVal: number, count: number = 6) {
  if (maxVal <= 0) maxVal = 10;
  const roughStep = maxVal / count;
  const magnitude = Math.pow(10, Math.floor(Math.log10(roughStep)) || 0) || 1;
  const normalized = roughStep / magnitude;
  let niceStep = 1;
  if (normalized > 5) niceStep = 10;
  else if (normalized > 2) niceStep = 5;
  else if (normalized > 1) niceStep = 2;
  
  const step = Math.max(1, niceStep * magnitude);
  const maxTick = Math.max(step * count, Math.ceil(maxVal / step) * step);
  const ticks: number[] = [];
  for (let v = 0; v <= maxTick + (step * 0.01); v += step) {
    ticks.push(Math.round(v));
  }
  return { maxTick, ticks };
}

function formatAxisTick(val: number) {
  if (val === 0) return '0';
  if (val >= 1_000_000_000) {
    const num = val / 1_000_000_000;
    return `${Number.isInteger(num) ? num : num.toFixed(1)} tỷ`;
  }
  if (val >= 1_000_000) {
    const num = val / 1_000_000;
    return `${Number.isInteger(num) ? num : num.toFixed(1)} tr`;
  }
  if (val >= 1_000) {
    const num = val / 1_000;
    return `${Number.isInteger(num) ? num : num.toFixed(1)} k`;
  }
  return String(val);
}

const revenueTicks = getNiceTicks(maxRevenue, 6);
const qtyTicks = getNiceTicks(maxQty, 5);

function formatNum(cents: number) {
  if (!cents || isNaN(cents)) return '0';
  return new Intl.NumberFormat('en-US').format(cents);
}

const nowStr = new Date().toLocaleString('vi-VN', {
  day: '2-digit', month: '2-digit', year: 'numeric',
  hour: '2-digit', minute: '2-digit'
});
---

<AdminLayout title="Báo cáo hàng hóa" active="reports-products">
  <div class="flex flex-col lg:flex-row gap-4 items-start relative">
    <!-- CỘT TRÁI: BỘ LỌC ĐỒNG BỘ CHUẨN HÀNG HÓA -->
    <ReportSidebar
      actionUrl="/admin/reports/products"
      activeView={view as any}
      showViewToggle={true}
      preset={preset}
      startDate={dateRange.startDate}
      endDate={dateRange.endDate}
      dateLabel={dateRange.label}
    >
      <!-- Tìm theo tên / mã hàng -->
      <div>
        <label class="block text-[12px] font-bold text-gray-500 uppercase tracking-wider mb-1">
          Hàng hóa
        </label>
        <input
          type="text"
          name="q"
          value={q}
          placeholder="Theo mã, tên hàng..."
          class="w-full h-[34px] px-2.5 bg-white border border-gray-300 rounded-lg text-[13.5px] text-gray-800 focus:border-[#00a2ff] focus:outline-none"
        />
      </div>

      <!-- Lọc Nhóm hàng -->
      <div>
        <label class="block text-[12px] font-bold text-gray-500 uppercase tracking-wider mb-1">
          Nhóm hàng
        </label>
        <select
          name="category"
          class="w-full h-[34px] px-2 bg-white border border-gray-300 rounded-lg text-[13.5px] text-gray-800 focus:border-[#00a2ff] focus:outline-none"
        >
          <option value="">-- Tất cả nhóm hàng --</option>
          {(categories ?? []).map(cat => (
            <option value={String(cat.id)} selected={String(cat.id) === categoryId}>
              {cat.name}
            </option>
          ))}
        </select>
      </div>

      <!-- Tình trạng Mới / Cũ -->
      <div>
        <label class="block text-[12px] font-bold text-gray-500 uppercase tracking-wider mb-1">
          Tình trạng
        </label>
        <select
          name="condition"
          class="w-full h-[34px] px-2 bg-white border border-gray-300 rounded-lg text-[13.5px] text-gray-800 focus:border-[#00a2ff] focus:outline-none"
        >
          <option value="">-- Tất cả tình trạng --</option>
          <option value="NEW" selected={condition === 'NEW'}>Mới 100%</option>
          <option value="QSD" selected={condition === 'QSD'}>Cũ qua sử dụng</option>
        </select>
      </div>
    </ReportSidebar>

    <!-- KHU VỰC NỘI DUNG CHÍNH -->
    <main class="flex-1 w-full bg-white rounded-xl border border-gray-200 shadow-xs overflow-hidden">
      <!-- HEADER BÁO CÁO -->
      <div class="p-5 border-b border-gray-100 bg-white">
        <div class="flex items-center justify-between text-xs text-gray-500 mb-2">
          <span>Ngày lập: {nowStr}</span>
          <div class="flex items-center gap-2">
            <button
              type="button"
              onclick="window.print()"
              class="inline-flex items-center gap-1 px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-md text-xs transition"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
              </svg>
              In báo cáo
            </button>
          </div>
        </div>

        <div class="text-center py-2">
          <h1 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">
            Báo cáo bán hàng theo hàng hóa
          </h1>
          <p class="text-[13.5px] text-gray-600 mt-1">
            Từ ngày <strong class="text-gray-900">{dateRange.startDate}</strong> đến ngày <strong class="text-gray-900">{dateRange.endDate}</strong>
          </p>
          <p class="text-xs text-gray-400 mt-0.5">Chi nhánh: Kho số 5 &bull; Bảng giá: Tất cả</p>
        </div>
      </div>

      {view === 'chart' && (
        <div class="p-6 space-y-12">
          <div>
            <h2 class="text-center text-[13.5px] font-semibold text-gray-700 mb-6 uppercase tracking-wider">
              Top 10 sản phẩm doanh thu cao nhất (đã trừ trả hàng)
            </h2>

            {top10ByRevenue.length > 0 ? (
              <div class="max-w-4xl mx-auto">
                <div class="flex">
                  <div class="w-48 sm:w-64 shrink-0 pr-3 space-y-3 pt-0.5">
                    {top10ByRevenue.map(item => (
                      <div class="h-6 flex items-center justify-end text-[12px] text-gray-700 font-normal truncate text-right hover:text-[#0070d2]" title={item.name}>
                        {item.name}
                      </div>
                    ))}
                  </div>

                  <div class="flex-1 relative pb-1" style="min-height: 160px; border-left: 1px solid #9ca3af; border-bottom: 1px solid #9ca3af;">
                    {revenueTicks.ticks.map(t => {
                      const leftPct = (t / revenueTicks.maxTick) * 100;
                      return (
                        <div
                          class="absolute top-0 bottom-0 pointer-events-none"
                          style={`left: ${leftPct}%; border-right: 1px solid #e5e7eb;`}
                        ></div>
                      );
                    })}

                    <div class="space-y-3 relative z-10 pt-0.5">
                      {top10ByRevenue.map(item => {
                        const widthPct = Math.min(100, Math.max(0.5, (item.net_revenue / revenueTicks.maxTick) * 100));
                        return (
                          <div class="h-6 flex items-center relative group">
                            <div
                              class="hover:brightness-95 transition-all duration-300 cursor-pointer relative"
                              style={`width: ${widthPct}%; height: 16px; background-color: #0070d2; display: block; min-width: 4px;`}
                            >
                              <div class="opacity-0 group-hover:opacity-100 transition-opacity absolute left-1/2 -top-8 -translate-x-1/2 text-white text-[11px] font-medium px-2.5 py-1 rounded shadow-lg whitespace-nowrap z-30 pointer-events-none flex items-center gap-1" style="background-color: #0070d2;">
                                <span>{formatNum(item.net_revenue)} - {item.name}</span>
                              </div>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                </div>

                <div class="flex text-xs text-gray-500 tabular-nums mt-1">
                  <div class="w-48 sm:w-64 shrink-0"></div>
                  <div class="flex-1 relative h-6">
                    {revenueTicks.ticks.map(t => {
                      const leftPct = (t / revenueTicks.maxTick) * 100;
                      return (
                        <div
                          class="absolute -translate-x-1/2 text-[11px] text-gray-500 font-normal select-none"
                          style={`left: ${leftPct}%`}
                        >
                          {formatAxisTick(t)}
                        </div>
                      );
                    })}
                  </div>
                </div>
              </div>
            ) : (
              <div class="py-12 text-center text-gray-400 text-sm">
                Chưa có dữ liệu bán hàng trong khoảng thời gian này.
              </div>
            )}
          </div>

          <div class="pt-8 border-t border-gray-100">
            <h2 class="text-center text-[13.5px] font-semibold text-gray-700 mb-6 uppercase tracking-wider">
              Top 10 sản phẩm bán chạy theo số lượng (đã trừ trả hàng)
            </h2>

            {top10ByQty.length > 0 ? (
              <div class="max-w-4xl mx-auto">
                <div class="flex">
                  <div class="w-48 sm:w-64 shrink-0 pr-3 space-y-3 pt-0.5">
                    {top10ByQty.map(item => (
                      <div class="h-6 flex items-center justify-end text-[12px] text-gray-700 font-normal truncate text-right hover:text-[#0070d2]" title={item.name}>
                        {item.name}
                      </div>
                    ))}
                  </div>

                  <div class="flex-1 relative pb-1" style="min-height: 160px; border-left: 1px solid #9ca3af; border-bottom: 1px solid #9ca3af;">
                    {qtyTicks.ticks.map(t => {
                      const leftPct = (t / qtyTicks.maxTick) * 100;
                      return (
                        <div
                          class="absolute top-0 bottom-0 pointer-events-none"
                          style={`left: ${leftPct}%; border-right: 1px solid #e5e7eb;`}
                        ></div>
                      );
                    })}

                    <div class="space-y-3 relative z-10 pt-0.5">
                      {top10ByQty.map(item => {
                        const widthPct = Math.min(100, Math.max(0.5, (item.sold_qty / qtyTicks.maxTick) * 100));
                        return (
                          <div class="h-6 flex items-center relative group">
                            <div
                              class="hover:brightness-95 transition-all duration-300 cursor-pointer relative"
                              style={`width: ${widthPct}%; height: 16px; background-color: #0070d2; display: block; min-width: 4px;`}
                            >
                              <div class="opacity-0 group-hover:opacity-100 transition-opacity absolute left-1/2 -top-8 -translate-x-1/2 text-white text-[11px] font-medium px-2.5 py-1 rounded shadow-lg whitespace-nowrap z-30 pointer-events-none flex items-center gap-1" style="background-color: #0070d2;">
                                <span>{item.sold_qty} cái/bộ - {item.name}</span>
                              </div>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                </div>

                <div class="flex text-xs text-gray-500 tabular-nums mt-1">
                  <div class="w-48 sm:w-64 shrink-0"></div>
                  <div class="flex-1 relative h-6">
                    {qtyTicks.ticks.map(t => {
                      const leftPct = (t / qtyTicks.maxTick) * 100;
                      return (
                        <div
                          class="absolute -translate-x-1/2 text-[11px] text-gray-500 font-normal select-none"
                          style={`left: ${leftPct}%`}
                        >
                          {t}
                        </div>
                      );
                    })}
                  </div>
                </div>
              </div>
            ) : (
              <div class="py-12 text-center text-gray-400 text-sm">
                Chưa có dữ liệu bán hàng trong khoảng thời gian này.
              </div>
            )}
          </div>
        </div>
      )}

      <!-- CHẾ ĐỘ 2: BẢNG BÁO CÁO CHI TIẾT (ẢNH 1 KIOTVIET) -->
      {view === 'table' && (
        <div class="overflow-x-auto">
          <table class="w-full text-left text-[14.5px] text-gray-800">
            <thead>
              <!-- HEADER CỘT -->
              <tr class="bg-[#dcf0fb] border-b border-[#bce2f7] text-[#006ca8] font-bold text-[14px]">
                <th class="py-3 px-4">Mã hàng</th>
                <th class="py-3 px-4">Tên hàng</th>
                <th class="py-3 px-4 text-center">Tình trạng</th>
                <th class="py-3 px-4 text-right tabular-nums">SL Bán</th>
                <th class="py-3 px-4 text-right tabular-nums">Doanh thu</th>
                <th class="py-3 px-4 text-right tabular-nums">SL Trả</th>
                <th class="py-3 px-4 text-right tabular-nums">Giá trị trả</th>
                <th class="py-3 px-4 text-right tabular-nums text-blue-700">Doanh thu thuần</th>
              </tr>

              <!-- DÒNG TỔNG KẾT NỔI BẬT CHUẨN KIOTVIET -->
              <tr class="bg-gray-50 border-b-2 border-gray-200 font-bold text-[14px] text-gray-900">
                <td colspan="3" class="py-3 px-4">
                  SL mặt hàng: <span class="text-blue-700 tabular-nums">{totalItemCount}</span>
                </td>
                <td class="py-3 px-4 text-right tabular-nums">{formatNum(totalSoldQty)}</td>
                <td class="py-3 px-4 text-right tabular-nums">{formatNum(totalGrossRevenue)}</td>
                <td class="py-3 px-4 text-right tabular-nums">{formatNum(totalReturnQty)}</td>
                <td class="py-3 px-4 text-right tabular-nums text-red-600">{totalReturnAmount > 0 ? `-${formatNum(totalReturnAmount)}` : '0'}</td>
                <td class="py-3 px-4 text-right tabular-nums text-blue-700 text-base">{formatNum(totalNetRevenue)}</td>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {rows.map(r => (
                <tr class="hover:bg-blue-50/40 transition">
                  <td class="py-3 px-4">
                    <a
                      href={r.public_id ? `/admin/products/${r.public_id}/edit` : '#'}
                      class="text-[#00a2ff] hover:underline font-normal tabular-nums"
                    >
                      {r.product_code}
                    </a>
                  </td>
                  <td class="py-3 px-4 font-normal text-gray-900 max-w-[280px] truncate" title={r.name}>
                    {r.name}
                  </td>
                  <td class="py-3 px-4 text-center">
                    <span class={`inline-block px-2 py-0.5 rounded text-[11.5px] font-medium ${
                      r.condition === 'NEW' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-amber-50 text-amber-800 border border-amber-200'
                    }`}>
                      {r.condition === 'NEW' ? 'Mới' : 'Cũ QSD'}
                    </span>
                  </td>
                  <td class="py-3 px-4 text-right tabular-nums font-normal">{formatNum(r.sold_qty)}</td>
                  <td class="py-3 px-4 text-right tabular-nums font-normal">{formatNum(r.gross_revenue)}</td>
                  <td class="py-3 px-4 text-right tabular-nums font-normal text-gray-500">{r.return_qty}</td>
                  <td class="py-3 px-4 text-right tabular-nums font-normal text-gray-500">{r.return_amount ? `-${formatNum(r.return_amount)}` : '0'}</td>
                  <td class="py-3 px-4 text-right tabular-nums font-semibold text-gray-900">{formatNum(r.net_revenue)}</td>
                </tr>
              ))}

              {rows.length === 0 && (
                <tr>
                  <td colspan="8" class="py-12 text-center text-gray-400 text-sm">
                    Không tìm thấy sản phẩm nào trong khoảng thời gian đã chọn.
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      )}
    </main>
  </div>
</AdminLayout>

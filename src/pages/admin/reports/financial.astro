---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ReportSidebar from '../../../components/admin/ReportSidebar.astro';
import { getPosFinancialReport } from '../../../features/reports/financial.ts';
import { parseDatePreset } from '../../../features/reports/date-utils';

if (!Astro.locals.settings?.setupComplete) return Astro.redirect('/admin/setup', 302);

const url = new URL(Astro.request.url);
const preset = url.searchParams.get('preset') || 'this_month';
const customFrom = url.searchParams.get('from');
const customTo = url.searchParams.get('to');

const vietnamToday = new Intl.DateTimeFormat('en-CA', {timeZone:'Asia/Ho_Chi_Minh',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
const dateRange = parseDatePreset(preset, customFrom, customTo, new Date(vietnamToday+'T12:00:00'));

const report = await getPosFinancialReport(env.DB,dateRange.startDate,dateRange.endDate);
const {operationalExpenses,grossSales,discount,refunds,deductions,netRevenue,cogs,grossProfit,shippingCost,totalExpenses,netProfit}=report;

function formatNum(cents: number) {
  if (!cents || isNaN(cents)) return '0';
  return new Intl.NumberFormat('en-US').format(cents);
}

const nowStr = new Date().toLocaleString('vi-VN', {
  timeZone: 'Asia/Ho_Chi_Minh', day: '2-digit', month: '2-digit', year: 'numeric',
  hour: '2-digit', minute: '2-digit'
});
---

<AdminLayout title="Báo cáo tài chính" active="reports-financial">
  <div class="flex flex-col lg:flex-row gap-4 items-start relative">
    <!-- CỘT TRÁI: BỘ LỌC CHUẨN ĐỒNG BỘ -->
    <ReportSidebar
      actionUrl="/admin/reports/financial"
      activeView="table"
      showViewToggle={false}
      preset={preset}
      startDate={dateRange.startDate}
      endDate={dateRange.endDate}
      dateLabel={dateRange.label}
    >
      <div>
        <label class="block text-[12px] font-bold text-gray-500 uppercase tracking-wider mb-1.5">
          Chi nhánh / Kho
        </label>
        <select class="w-full h-[34px] px-2.5 bg-white border border-gray-300 rounded-lg text-[13.5px] text-gray-800 focus:border-[#00a2ff] focus:outline-none">
          <option value="ALL">Toàn hệ thống (Kho số 5)</option>
        </select>
      </div>
    </ReportSidebar>

    <!-- KHU VỰC NỘI DUNG CHÍNH (TỜ BÁO CÁO KẾT QUẢ KINH DOANH CHUẨN KIOTVIET) -->
    <main class="flex-1 w-full bg-white rounded-xl border border-gray-200 shadow-xs overflow-hidden">
      <!-- HEADER BÁO CÁO -->
      <div class="p-6 border-b border-gray-100 bg-white">
        <div class="flex items-center justify-between text-xs text-gray-500 mb-2">
          <span>Ngày lập: {nowStr}</span>
          <div class="flex items-center gap-2">
            <button
              type="button"
              onclick="window.print()"
              class="inline-flex items-center gap-1 px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-md text-xs transition"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
              </svg>
              In báo cáo
            </button>
          </div>
        </div>

        <div class="text-center py-2">
          <h1 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">
            Kết quả bán hàng POS tạm tính
          </h1>
          <p class="text-[13.5px] text-gray-600 mt-1">
            Từ ngày <strong class="text-gray-900">{dateRange.startDate}</strong> đến ngày <strong class="text-gray-900">{dateRange.endDate}</strong>
          </p>
          <p class="text-xs text-gray-400 mt-0.5">Phạm vi: một cửa hàng, một kho</p>
        </div>
      </div>

      <p class="m-4 rounded border bg-amber-50 p-3 text-sm">Phạm vi: đơn bán POS trong kỳ (giờ Việt Nam), không gồm đặt trước chưa giao hoặc đơn web chưa đối chiếu. Tiền hoàn hiển thị theo các đơn bán trong kỳ; chi phí theo ngày thực chi. Kết quả tạm tính, chưa bao gồm đầy đủ luồng khách trả hàng và chi phí chưa thanh toán.</p>
      {report.incomplete > 0 && <p role="alert" class="m-4 text-red-700">Có đơn thiếu giá vốn/dòng hàng hoặc hàng trả chờ kiểm tra. Cần đối chiếu trước khi sử dụng lợi nhuận.</p>}
      <!-- BẢNG BÁO CÁO TÀI CHÍNH P&L -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-[14.5px] text-gray-800">
          <thead>
            <tr class="bg-[#dcf0fb] border-y border-[#bce2f7] text-[#006ca8] font-bold text-[14px]">
              <th class="py-3 px-6">Chỉ tiêu</th>
              <th class="py-3 px-6 text-right tabular-nums">Tổng giá trị</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <!-- 1. Doanh thu bán hàng -->
            <tr class="hover:bg-blue-50/40 font-medium">
              <td class="py-3 px-6 text-gray-900">Doanh thu bán hàng (1)</td>
              <td class="py-3 px-6 text-right tabular-nums text-blue-600 font-semibold">{formatNum(grossSales)}</td>
            </tr>

            <!-- 2. Giảm trừ doanh thu -->
            <tr class="hover:bg-blue-50/40 font-medium">
              <td class="py-3 px-6 text-gray-900">Giảm trừ Doanh thu (2 = 2.1 + 2.2)</td>
              <td class="py-3 px-6 text-right tabular-nums text-gray-700">{formatNum(deductions)}</td>
            </tr>
            <tr class="text-[13.5px] text-gray-500 bg-gray-50/50">
              <td class="py-2 px-10">Chiết khấu dòng hàng và hóa đơn (2.1)</td>
              <td class="py-2 px-6 text-right tabular-nums">{formatNum(discount)}</td>
            </tr>
            <tr class="text-[13.5px] text-gray-500 bg-gray-50/50">
              <td class="py-2 px-10">Trả hàng / tiền hoàn của các đơn trong kỳ (2.2)</td>
              <td class="py-2 px-6 text-right tabular-nums">{formatNum(refunds)}</td>
            </tr>

            <!-- 3. Doanh thu thuần -->
            <tr class="hover:bg-blue-50/40 bg-blue-50/20 font-bold">
              <td class="py-3.5 px-6 text-gray-900">Doanh thu thuần (3 = 1 - 2)</td>
              <td class="py-3.5 px-6 text-right tabular-nums text-blue-700 text-base">{formatNum(netRevenue)}</td>
            </tr>

            <!-- 4. Giá vốn hàng bán -->
            <tr class="hover:bg-blue-50/40 font-medium">
              <td class="py-3 px-6 text-gray-900">Giá vốn hàng bán (4)</td>
              <td class="py-3 px-6 text-right tabular-nums text-amber-700">{report.incomplete ? 'Chưa đủ dữ liệu' : formatNum(cogs)}</td>
            </tr>

            <!-- 5. Lợi nhuận gộp về bán hàng -->
            <tr class="hover:bg-blue-50/40 bg-emerald-50/30 font-bold">
              <td class="py-3.5 px-6 text-gray-900">Lợi nhuận gộp về bán hàng (5 = 3 - 4)</td>
              <td class="py-3.5 px-6 text-right tabular-nums text-emerald-700 text-base">{report.incomplete ? 'Chưa đủ dữ liệu' : formatNum(grossProfit)}</td>
            </tr>

            <!-- 6. Chi phí -->
            <tr class="hover:bg-blue-50/40 font-medium">
              <td class="py-3 px-6 text-gray-900">Chi phí hoạt động (6)</td>
              <td class="py-3 px-6 text-right tabular-nums text-red-600">{formatNum(totalExpenses)}</td>
            </tr>
            <tr class="text-[13.5px] text-gray-500 bg-gray-50/50">
              <td class="py-2 px-10">Phí vận chuyển / Trả ĐTGH</td>
              <td class="py-2 px-6 text-right tabular-nums">{formatNum(shippingCost)}</td>
            </tr>
            <tr class="text-[13.5px] text-gray-500 bg-gray-50/50">
              <td class="py-2 px-10">Chi phí hoạt động đã chi</td>
              <td class="py-2 px-6 text-right tabular-nums">{formatNum(operationalExpenses)}</td>
            </tr>

            <!-- 7. Lợi nhuận thuần -->
            <tr class="bg-[#eef7fc] border-t-2 border-[#bce2f7] font-extrabold text-[15px]">
              <td class="py-4 px-6 text-[#006ca8] uppercase tracking-wide">
                Lợi nhuận POS tạm tính (7 = 5 - 6)
              </td>
              <td class={`py-4 px-6 text-right tabular-nums text-lg ${netProfit >= 0 ? 'text-emerald-700' : 'text-red-600'}`}>
                {report.incomplete ? 'Chưa đủ dữ liệu' : formatNum(netProfit)}
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- FOOTER NOTE -->
      <div class="p-4 bg-gray-50/60 border-t border-gray-100 text-xs text-gray-400 flex items-center justify-between">
        <span>Kgame Minshop &bull; Hệ thống quản trị xưởng và bán lẻ máy game</span>
        <span>Tổng số đơn trong phạm vi báo cáo: <strong class="text-gray-700 font-semibold">{report.totalOrders}</strong> đơn</span>
      </div>
    </main>
  </div>
</AdminLayout>

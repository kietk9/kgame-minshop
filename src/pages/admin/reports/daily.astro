---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ReportSidebar from '../../../components/admin/ReportSidebar.astro';
import { parseDatePreset } from '../../../features/reports/date-utils';

if (!Astro.locals.settings?.setupComplete) return Astro.redirect('/admin/setup', 302);

const url = new URL(Astro.request.url);
const preset = url.searchParams.get('preset') || 'today';
const customFrom = url.searchParams.get('from');
const customTo = url.searchParams.get('to');
const tab = url.searchParams.get('tab') || 'orders'; // 'orders', 'cash', 'products'

const dateRange = parseDatePreset(preset, customFrom, customTo);

// 1. Thống kê hóa đơn bán hàng trong ngày
const { results: dailyOrders } = await env.DB.prepare(`
  SELECT 
    o.id,
    o.public_id,
    o.order_code,
    o.created_at,
    o.amount_total_cents,
    o.paid_amount_cents,
    o.order_status,
    o.payment_status,
    c.name as customer_name,
    c.phone as customer_phone
  FROM orders o
  LEFT JOIN customers c ON o.customer_id = c.id
  WHERE DATE(o.created_at) >= ? AND DATE(o.created_at) <= ?
    AND (o.order_status IS NULL OR o.order_status != 'CANCELLED')
  ORDER BY o.id DESC
`).bind(dateRange.startDate, dateRange.endDate).all<{
  id: number;
  public_id: string | null;
  order_code: string | null;
  created_at: string;
  amount_total_cents: number;
  paid_amount_cents: number;
  order_status: string | null;
  payment_status: string | null;
  customer_name: string | null;
  customer_phone: string | null;
}>();

const orders = dailyOrders ?? [];
const totalOrderCount = orders.length;
const totalOrderRevenue = orders.reduce((s, o) => s + (o.amount_total_cents || 0), 0);
const totalOrderPaid = orders.reduce((s, o) => s + (o.paid_amount_cents || 0), 0);

// 2. Thống kê thu chi sổ quỹ trong ngày
const { results: dailyCash } = await env.DB.prepare(`
  SELECT 
    id,
    transaction_code,
    flow_type,
    category,
    amount_cents,
    reference_type,
    reference_id,
    note,
    created_at
  FROM cash_transactions
  WHERE DATE(created_at) >= ? AND DATE(created_at) <= ?
    AND (status IS NULL OR status != 'CANCELLED')
  ORDER BY id DESC
`).bind(dateRange.startDate, dateRange.endDate).all<{
  id: number;
  transaction_code: string;
  flow_type: 'IN' | 'OUT';
  category: string;
  amount_cents: number;
  reference_type: string | null;
  reference_id: number | null;
  note: string | null;
  created_at: string;
}>();

const cashList = dailyCash ?? [];
const totalCashIn = cashList.filter(c => c.flow_type === 'IN').reduce((s, c) => s + c.amount_cents, 0);
const totalCashOut = cashList.filter(c => c.flow_type === 'OUT').reduce((s, c) => s + c.amount_cents, 0);
const netCashFlow = totalCashIn - totalCashOut;

// 3. Thống kê sản phẩm bán ra trong ngày
const { results: dailyLines } = await env.DB.prepare(`
  SELECT 
    ol.product_name_snapshot as name,
    ol.condition,
    SUM(ol.quantity) as total_qty,
    SUM(ol.line_total_cents) as total_amount
  FROM order_lines ol
  JOIN orders o ON ol.order_id = o.id
  WHERE DATE(o.created_at) >= ? AND DATE(o.created_at) <= ?
    AND (o.order_status IS NULL OR o.order_status != 'CANCELLED')
  GROUP BY ol.product_name_snapshot, ol.condition
  ORDER BY total_amount DESC
`).bind(dateRange.startDate, dateRange.endDate).all<{
  name: string;
  condition: string;
  total_qty: number;
  total_amount: number;
}>();

const lineItems = dailyLines ?? [];

function formatNum(cents: number) {
  if (!cents || isNaN(cents)) return '0';
  return new Intl.NumberFormat('en-US').format(cents);
}

function formatTime(isoStr: string) {
  try {
    const d = new Date(isoStr);
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${pad(d.getHours())}:${pad(d.getMinutes())}`;
  } catch {
    return isoStr;
  }
}

const nowStr = new Date().toLocaleString('vi-VN', {
  day: '2-digit', month: '2-digit', year: 'numeric',
  hour: '2-digit', minute: '2-digit'
});
---

<AdminLayout title="Báo cáo cuối ngày" active="reports-daily">
  <div class="flex flex-col lg:flex-row gap-4 items-start relative">
    <!-- CỘT TRÁI: BỘ LỌC ĐỒNG BỘ -->
    <ReportSidebar
      actionUrl="/admin/reports/daily"
      activeView="table"
      showViewToggle={false}
      preset={preset}
      startDate={dateRange.startDate}
      endDate={dateRange.endDate}
      dateLabel={dateRange.label}
    >
      <input type="hidden" name="tab" value={tab} />
      
      <div>
        <label class="block text-[12px] font-bold text-gray-500 uppercase tracking-wider mb-1">
          Thu ngân / Ca làm việc
        </label>
        <select class="w-full h-[34px] px-2.5 bg-white border border-gray-300 rounded-lg text-[13.5px] text-gray-800 focus:border-[#00a2ff] focus:outline-none">
          <option value="ALL">Tất cả nhân viên / Thu ngân</option>
        </select>
      </div>
    </ReportSidebar>

    <!-- KHU VỰC NỘI DUNG CHÍNH -->
    <main class="flex-1 w-full bg-white rounded-xl border border-gray-200 shadow-xs overflow-hidden">
      <!-- HEADER BÁO CÁO -->
      <div class="p-5 border-b border-gray-100 bg-white">
        <div class="flex items-center justify-between text-xs text-gray-500 mb-2">
          <span>Ngày lập: {nowStr}</span>
          <div class="flex items-center gap-2">
            <button
              type="button"
              onclick="window.print()"
              class="inline-flex items-center gap-1 px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-md text-xs transition"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
              </svg>
              In báo cáo cuối ngày
            </button>
          </div>
        </div>

        <div class="text-center py-2">
          <h1 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">
            Báo cáo tổng kết cuối ngày
          </h1>
          <p class="text-[13.5px] text-gray-600 mt-1">
            Thời gian: <strong class="text-gray-900">{dateRange.startDate}</strong> {dateRange.startDate !== dateRange.endDate ? `đến ${dateRange.endDate}` : ''}
          </p>
        </div>

        <!-- 4 THẺ TỔNG KẾT TÀI CHÍNH CUỐI NGÀY -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-4 pt-4 border-t border-gray-100 text-center">
          <div class="p-3 bg-blue-50/50 rounded-lg border border-blue-100">
            <span class="text-[11.5px] font-bold uppercase tracking-wider text-blue-600">Hóa đơn bán hàng</span>
            <p class="text-xl font-bold text-blue-900 mt-1 tabular-nums">{totalOrderCount} <span class="text-xs font-normal">đơn</span></p>
            <p class="text-xs text-blue-700 tabular-nums font-medium mt-0.5">{formatNum(totalOrderRevenue)}</p>
          </div>

          <div class="p-3 bg-emerald-50/50 rounded-lg border border-emerald-100">
            <span class="text-[11.5px] font-bold uppercase tracking-wider text-emerald-600">Tổng tiền thực thu</span>
            <p class="text-xl font-bold text-emerald-900 mt-1 tabular-nums">{formatNum(totalCashIn)}</p>
            <p class="text-xs text-emerald-700 font-medium mt-0.5">{cashList.filter(c => c.flow_type === 'IN').length} phiếu thu</p>
          </div>

          <div class="p-3 bg-red-50/50 rounded-lg border border-red-100">
            <span class="text-[11.5px] font-bold uppercase tracking-wider text-red-600">Tổng tiền thực chi</span>
            <p class="text-xl font-bold text-red-900 mt-1 tabular-nums">{formatNum(totalCashOut)}</p>
            <p class="text-xs text-red-700 font-medium mt-0.5">{cashList.filter(c => c.flow_type === 'OUT').length} phiếu chi</p>
          </div>

          <div class={`p-3 rounded-lg border ${netCashFlow >= 0 ? 'bg-emerald-50/70 border-emerald-200' : 'bg-amber-50/70 border-amber-200'}`}>
            <span class="text-[11.5px] font-bold uppercase tracking-wider text-gray-700">Chênh lệch Thu - Chi</span>
            <p class={`text-xl font-bold mt-1 tabular-nums ${netCashFlow >= 0 ? 'text-emerald-800' : 'text-amber-800'}`}>
              {netCashFlow >= 0 ? `+${formatNum(netCashFlow)}` : formatNum(netCashFlow)}
            </p>
            <p class="text-xs text-gray-500 font-medium mt-0.5">Tồn quỹ thay đổi</p>
          </div>
        </div>

        <!-- 3 TAB ĐIỀU HƯỚNG CHI TIẾT -->
        <div class="flex items-center gap-2 mt-5 border-b border-gray-200 text-sm">
          <a
            href={`/admin/reports/daily?preset=${preset}&from=${dateRange.startDate}&to=${dateRange.endDate}&tab=orders`}
            class={`px-4 py-2.5 font-medium border-b-2 transition ${
              tab === 'orders'
                ? 'border-[#00a2ff] text-[#00a2ff] font-semibold'
                : 'border-transparent text-gray-500 hover:text-gray-900'
            }`}
          >
            Hóa đơn bán hàng ({orders.length})
          </a>
          <a
            href={`/admin/reports/daily?preset=${preset}&from=${dateRange.startDate}&to=${dateRange.endDate}&tab=cash`}
            class={`px-4 py-2.5 font-medium border-b-2 transition ${
              tab === 'cash'
                ? 'border-[#00a2ff] text-[#00a2ff] font-semibold'
                : 'border-transparent text-gray-500 hover:text-gray-900'
            }`}
          >
            Thu - Chi Sổ quỹ ({cashList.length})
          </a>
          <a
            href={`/admin/reports/daily?preset=${preset}&from=${dateRange.startDate}&to=${dateRange.endDate}&tab=products`}
            class={`px-4 py-2.5 font-medium border-b-2 transition ${
              tab === 'products'
                ? 'border-[#00a2ff] text-[#00a2ff] font-semibold'
                : 'border-transparent text-gray-500 hover:text-gray-900'
            }`}
          >
            Hàng hóa bán ra ({lineItems.length})
          </a>
        </div>
      </div>

      <!-- NỘI DUNG THEO TAB -->
      <!-- TAB 1: HÓA ĐƠN BÁN HÀNG -->
      {tab === 'orders' && (
        <div class="overflow-x-auto">
          <table class="w-full text-left text-[14.5px] text-gray-800">
            <thead>
              <tr class="bg-[#f8f9fa] border-b border-gray-200 text-gray-700 font-semibold text-[14px]">
                <th class="py-3 px-5">Mã đơn</th>
                <th class="py-3 px-5">Thời gian</th>
                <th class="py-3 px-5">Khách hàng</th>
                <th class="py-3 px-5 text-right tabular-nums">Tổng tiền</th>
                <th class="py-3 px-5 text-right tabular-nums">Đã thu</th>
                <th class="py-3 px-5 text-center">Trạng thái</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {orders.map(o => (
                <tr class="hover:bg-blue-50/40 transition">
                  <td class="py-3 px-5">
                    <a href={`/admin/orders/${o.public_id || o.id}`} class="text-[#00a2ff] hover:underline font-normal tabular-nums">
                      #{o.order_code || `HD${o.id}`}
                    </a>
                  </td>
                  <td class="py-3 px-5 text-gray-500 tabular-nums text-[13.5px]">{formatTime(o.created_at)}</td>
                  <td class="py-3 px-5 font-normal text-gray-900">{o.customer_name || 'Khách lẻ tại xưởng'}</td>
                  <td class="py-3 px-5 text-right tabular-nums font-semibold text-gray-900">{formatNum(o.amount_total_cents)}</td>
                  <td class="py-3 px-5 text-right tabular-nums text-emerald-700">{formatNum(o.paid_amount_cents)}</td>
                  <td class="py-3 px-5 text-center">
                    <span class="inline-block px-2 py-0.5 rounded text-[11.5px] font-medium bg-blue-50 text-blue-700 border border-blue-200">
                      {o.order_status || 'Hoàn tất'}
                    </span>
                  </td>
                </tr>
              ))}
              {orders.length === 0 && (
                <tr>
                  <td colspan="6" class="py-12 text-center text-gray-400 text-sm">Chưa có hóa đơn nào phát sinh.</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      )}

      <!-- TAB 2: THU - CHI SỔ QUỸ -->
      {tab === 'cash' && (
        <div class="overflow-x-auto">
          <table class="w-full text-left text-[14.5px] text-gray-800">
            <thead>
              <tr class="bg-[#f8f9fa] border-b border-gray-200 text-gray-700 font-semibold text-[14px]">
                <th class="py-3 px-5">Mã phiếu</th>
                <th class="py-3 px-5">Thời gian</th>
                <th class="py-3 px-5">Loại</th>
                <th class="py-3 px-5">Hạng mục / Lý do</th>
                <th class="py-3 px-5 text-right tabular-nums">Số tiền</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {cashList.map(c => (
                <tr class="hover:bg-blue-50/40 transition">
                  <td class="py-3 px-5 font-normal tabular-nums text-gray-900">{c.transaction_code}</td>
                  <td class="py-3 px-5 text-gray-500 tabular-nums text-[13.5px]">{formatTime(c.created_at)}</td>
                  <td class="py-3 px-5">
                    <span class={`inline-block px-2 py-0.5 rounded text-[11.5px] font-semibold ${
                      c.flow_type === 'IN' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-red-50 text-red-700 border border-red-200'
                    }`}>
                      {c.flow_type === 'IN' ? 'Thu' : 'Chi'}
                    </span>
                  </td>
                  <td class="py-3 px-5 font-normal text-gray-800">{c.note || c.category}</td>
                  <td class={`py-3 px-5 text-right tabular-nums font-semibold ${
                    c.flow_type === 'IN' ? 'text-emerald-700' : 'text-red-600'
                  }`}>
                    {c.flow_type === 'IN' ? `+${formatNum(c.amount_cents)}` : `-${formatNum(c.amount_cents)}`}
                  </td>
                </tr>
              ))}
              {cashList.length === 0 && (
                <tr>
                  <td colspan="5" class="py-12 text-center text-gray-400 text-sm">Chưa có giao dịch thu chi nào.</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      )}

      <!-- TAB 3: HÀNG HÓA BÁN RA -->
      {tab === 'products' && (
        <div class="overflow-x-auto">
          <table class="w-full text-left text-[14.5px] text-gray-800">
            <thead>
              <tr class="bg-[#f8f9fa] border-b border-gray-200 text-gray-700 font-semibold text-[14px]">
                <th class="py-3 px-5">Tên sản phẩm</th>
                <th class="py-3 px-5 text-center">Tình trạng</th>
                <th class="py-3 px-5 text-right tabular-nums">Số lượng</th>
                <th class="py-3 px-5 text-right tabular-nums">Thành tiền</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {lineItems.map(l => (
                <tr class="hover:bg-blue-50/40 transition">
                  <td class="py-3 px-5 font-normal text-gray-900">{l.name}</td>
                  <td class="py-3 px-5 text-center">
                    <span class={`inline-block px-2 py-0.5 rounded text-[11.5px] font-medium ${
                      l.condition === 'NEW' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-amber-50 text-amber-800 border border-amber-200'
                    }`}>
                      {l.condition === 'NEW' ? 'Mới' : 'Cũ QSD'}
                    </span>
                  </td>
                  <td class="py-3 px-5 text-right tabular-nums font-semibold text-gray-900">{l.total_qty}</td>
                  <td class="py-3 px-5 text-right tabular-nums font-semibold text-blue-700">{formatNum(l.total_amount)}</td>
                </tr>
              ))}
              {lineItems.length === 0 && (
                <tr>
                  <td colspan="4" class="py-12 text-center text-gray-400 text-sm">Chưa có mặt hàng nào bán ra trong ngày.</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      )}
    </main>
  </div>
</AdminLayout>

---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';
import { listCashTransactions, getCashbookSummary } from '../../../features/kgame/db';

export const prerender = false;

const search = Astro.url.searchParams.get('search') ?? '';
const accountType = Astro.url.searchParams.get('account_type') ?? 'ALL';
const flowType = Astro.url.searchParams.get('flow_type') ?? 'ALL';
const category = Astro.url.searchParams.get('category') ?? 'ALL';

const [{ transactions, total }, summary] = await Promise.all([
  listCashTransactions(env.DB, {
    accountType,
    flowType,
    category,
    search,
    limit: 50,
  }),
  getCashbookSummary(env.DB),
]);

const success = Astro.url.searchParams.get('success');
const error = Astro.url.searchParams.get('error');

const formatNumber = (cents: number) => {
  if (!cents || isNaN(cents)) return '0';
  return new Intl.NumberFormat('en-US').format(cents);
};
const formatVND = formatNumber;

const formatDateTime = (dStr?: string | null) => {
  if (!dStr) return '---';
  try {
    const d = new Date(dStr);
    return isNaN(d.getTime()) ? dStr : d.toLocaleString('vi-VN');
  } catch {
    return dStr;
  }
};

const getCategoryBadge = (cat: string, referenceType: string | null) => {
  switch (cat) {
    case 'REPAIR_FEE':
      return { label: 'Sửa chữa / Bảo hành', bg: 'bg-amber-100 text-amber-800 border-amber-300' };
    case 'ORDER_PAYMENT':
      return { label: 'Bán hàng / Đơn hàng', bg: 'bg-blue-100 text-blue-800 border-blue-300' };
    case 'PURCHASE':
      return { label: 'Nhập linh kiện kho', bg: 'bg-indigo-100 text-indigo-800 border-indigo-300' };
    case 'BUYBACK':
      return { label: 'Thu mua máy cũ', bg: 'bg-purple-100 text-purple-800 border-purple-300' };
    case 'DEPOSIT':
      return { label: 'Đặt cọc nhập hàng', bg: 'bg-indigo-100 text-indigo-800 border-indigo-300' };
    case 'EXPENSE':
      return { label: ['purchase_receipt', 'purchase_receipt_other_fee'].includes(referenceType?.toLowerCase() ?? '') ? 'Chi phí nhập hàng' : 'Chi phí vận hành', bg: 'bg-zinc-100 text-zinc-700 border-zinc-300' };
    case 'REFUND':
      return { label: 'Hoàn tiền', bg: 'bg-purple-100 text-purple-800 border-purple-300' };
    case 'COD_SETTLEMENT':
    case 'THU TIỀN COD ĐỐI TÁC GIAO HÀNG':
      return { label: 'Thu COD từ đối tác giao hàng', bg: 'bg-blue-100 text-blue-800 border-blue-300' };
    case 'SHIPPING_FEE':
    case 'CHI PHÍ VẬN CHUYỂN GIAO HÀNG':
      return { label: 'Chi phí giao hàng', bg: 'bg-amber-100 text-amber-800 border-amber-300' };
    case 'OTHER':
    default:
      return { label: 'Thu chi khác', bg: 'bg-zinc-100 text-zinc-700 border-zinc-300' };
  }
};
---

<AdminLayout title="Sổ Quỹ Tiền Mặt & Ngân Hàng" active="cash">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">Sổ Quỹ (Thu / Chi)</h1>
        <p class="mt-1 text-sm text-zinc-500">
          Quản lý dòng tiền vào ra từ dịch vụ sửa chữa, bán máy, thu mua và các chi phí vận hành tiệm KGAME.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          onclick="openCashModal('IN')"
          class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2.5 text-xs font-bold text-white shadow-sm hover:bg-emerald-700 focus:outline-none"
        >
          + Lập Phiếu Thu
        </button>
        <button
          type="button"
          onclick="openCashModal('OUT')"
          class="inline-flex items-center gap-1.5 rounded-lg bg-rose-600 px-4 py-2.5 text-xs font-bold text-white shadow-sm hover:bg-rose-700 focus:outline-none"
        >
          - Lập Phiếu Chi
        </button>
      </div>
    </div>

    {success && (
      <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-medium text-emerald-800">
        ✓ Đã ghi nhận giao dịch sổ quỹ thành công!
      </div>
    )}

    {error && (
      <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-medium text-red-800">
        ⚠️ {error}
      </div>
    )}

    <!-- 4 KPI Cards: Tiền mặt, Ngân hàng, Tổng thu, Tổng chi -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- 1. Quỹ tiền mặt -->
      <div class="rounded-xl border border-emerald-200 bg-gradient-to-br from-emerald-50/50 to-white p-5 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold uppercase tracking-wider text-emerald-800">💵 Quỹ Tiền Mặt (Két tiệm)</span>
          <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[11px] font-medium text-emerald-700">Tại quầy</span>
        </div>
        <div class="mt-3 tabular-nums text-2xl font-semibold text-emerald-700">
          {formatVND(summary.cash_balance)}
        </div>
        <div class="mt-1 text-xs text-zinc-500">Tiền mặt thực tế đang giữ trong két</div>
      </div>

      <!-- 2. Quỹ ngân hàng -->
      <div class="rounded-xl border border-blue-200 bg-gradient-to-br from-blue-50/50 to-white p-5 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-800">🏦 Tài Khoản Ngân Hàng</span>
          <span class="rounded-full bg-blue-100 px-2 py-0.5 text-[11px] font-medium text-blue-700">Chuyển khoản</span>
        </div>
        <div class="mt-3 tabular-nums text-2xl font-semibold text-blue-700">
          {formatVND(summary.bank_balance)}
        </div>
        <div class="mt-1 text-xs text-zinc-500">Số dư khả dụng trong các tài khoản</div>
      </div>

      <!-- 3. Thu trong tháng -->
      <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm">
        <span class="text-xs font-semibold uppercase tracking-wider text-zinc-500">📈 Tổng Thu Tháng Này</span>
        <div class="mt-3 tabular-nums text-2xl font-semibold text-emerald-600">
          + {formatVND(summary.total_income_month)}
        </div>
        <div class="mt-1 text-xs text-zinc-400">Từ sửa chữa, bán máy & thu khác</div>
      </div>

      <!-- 4. Chi trong tháng -->
      <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm">
        <span class="text-xs font-semibold uppercase tracking-wider text-zinc-500">📉 Tổng Chi Tháng Này</span>
        <div class="mt-3 tabular-nums text-2xl font-semibold text-rose-600">
          - {formatVND(summary.total_expense_month)}
        </div>
        <div class="mt-1 text-xs text-zinc-400">Chi đối tác, linh kiện & vận hành</div>
      </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="rounded-xl border border-zinc-200 bg-white p-4 shadow-sm">
      <form method="GET" class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between text-[13.5px]">
        <div class="flex flex-wrap items-center gap-3 flex-1">
          <!-- Search input -->
          <div class="relative min-w-[240px] flex-1 max-w-md">
            <input
              type="text"
              name="search"
              value={search}
              placeholder="Tìm mã PT/PC, tên người nộp/nhận, nội dung..."
              class="w-full rounded-lg border border-zinc-300 py-2 pl-9 pr-3 text-[13.5px] focus:border-zinc-900 focus:outline-none"
            />
            <svg class="absolute left-3 top-2.5 h-4 w-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>

          <!-- Loại quỹ -->
          <select
            name="account_type"
            class="rounded-lg border border-zinc-300 py-2 px-3 text-[13.5px] focus:border-zinc-900 focus:outline-none"
            onchange="this.form.submit()"
          >
            <option value="ALL" selected={accountType === 'ALL'}>-- Tất cả loại quỹ --</option>
            <option value="CASH" selected={accountType === 'CASH'}>💵 Tiền mặt (Két)</option>
            <option value="BANK" selected={accountType === 'BANK'}>🏦 Tài khoản Ngân hàng</option>
          </select>

          <!-- Chiều dòng tiền -->
          <select
            name="flow_type"
            class="rounded-lg border border-zinc-300 py-2 px-3 text-[13.5px] focus:border-zinc-900 focus:outline-none"
            onchange="this.form.submit()"
          >
            <option value="ALL" selected={flowType === 'ALL'}>-- Thu & Chi --</option>
            <option value="IN" selected={flowType === 'IN'}>⬇ Thu tiền vào</option>
            <option value="OUT" selected={flowType === 'OUT'}>⬆ Chi tiền ra</option>
          </select>

          <!-- Khoản mục -->
          <select
            name="category"
            class="rounded-lg border border-zinc-300 py-2 px-3 text-[13.5px] focus:border-zinc-900 focus:outline-none"
            onchange="this.form.submit()"
          >
            <option value="ALL" selected={category === 'ALL'}>-- Tất cả khoản mục --</option>
            <option value="REPAIR_FEE" selected={category === 'REPAIR_FEE'}>Tiền Sửa chữa / Bảo hành</option>
            <option value="ORDER_PAYMENT" selected={category === 'ORDER_PAYMENT'}>Tiền Bán hàng / Đơn máy</option>
            <option value="PURCHASE" selected={category === 'PURCHASE'}>Chi Nhập linh kiện</option>
            <option value="BUYBACK" selected={category === 'BUYBACK'}>Chi Thu mua máy cũ</option>
            <option value="OTHER" selected={category === 'OTHER'}>Thu chi khác</option>
          </select>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="submit"
            class="rounded-lg bg-zinc-900 px-4 py-2 text-[13.5px] font-medium text-white hover:bg-zinc-800"
          >
            Lọc sổ quỹ
          </button>
          {(search || accountType !== 'ALL' || flowType !== 'ALL' || category !== 'ALL') && (
            <a
              href="/admin/cash"
              class="rounded-lg border border-zinc-300 px-3 py-2 text-[13.5px] text-zinc-600 hover:bg-zinc-50"
            >
              Đặt lại
            </a>
          )}
        </div>
      </form>
    </div>

    <!-- Table Sao kê sổ quỹ -->
    <div class="overflow-hidden rounded-xl border border-zinc-200 bg-white shadow-sm">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-zinc-200 text-left text-[14.5px]">
          <thead class="bg-[#f8f9fa] text-[14px] font-semibold text-gray-700 border-b border-line select-none">
            <tr>
              <th class="px-4 py-3">Mã phiếu</th>
              <th class="px-4 py-3">Thời gian</th>
              <th class="px-4 py-3">Loại quỹ</th>
              <th class="px-4 py-3">Khoản mục</th>
              <th class="px-4 py-3">Người nộp / nhận</th>
              <th class="px-4 py-3">Diễn giải / Chứng từ</th>
              <th class="px-4 py-3 text-right">Số tiền</th>
              <th class="px-4 py-3 text-center">Người lập</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100">
            {transactions.length === 0 ? (
              <tr>
                <td colspan="8" class="px-4 py-12 text-center text-zinc-500">
                  <div class="mx-auto max-w-sm">
                    <p class="font-medium text-zinc-700">Chưa có giao dịch nào trong sổ quỹ</p>
                    <p class="mt-1 text-xs text-zinc-500">Khi bạn hoàn tất thu tiền sửa chữa hoặc lập phiếu thu/chi, các dòng tiền sẽ tự động ghi sổ tại đây.</p>
                  </div>
                </td>
              </tr>
            ) : (
              transactions.map((tx: any) => {
                const catBadge = getCategoryBadge(tx.category, tx.reference_type);
                const isIncome = tx.flow_type === 'IN';

                return (
                  <tr class="transition-colors hover:bg-blue-50/40">
                    <td class="px-4 py-3.5 whitespace-nowrap text-[14px]">
                      <span class={`inline-block rounded px-2 py-0.5 text-[12.5px] font-medium ${isIncome ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-rose-50 text-rose-700 border border-rose-200'}`}>
                        {tx.transaction_code}
                      </span>
                    </td>
                    <td class="px-4 py-3.5 whitespace-nowrap text-[13px] text-zinc-500">
                      {formatDateTime(tx.created_at)}
                    </td>
                    <td class="px-4 py-3.5 whitespace-nowrap text-[13.5px]">
                      {tx.account_type === 'CASH' ? (
                        <span class="inline-flex items-center gap-1 font-medium text-emerald-800">
                          💵 Tiền mặt
                        </span>
                      ) : (
                        <span class="inline-flex items-center gap-1 font-medium text-blue-800">
                          🏦 {tx.bank_name || 'Ngân hàng'}
                        </span>
                      )}
                    </td>
                    <td class="px-4 py-3.5 whitespace-nowrap">
                      <span class={`inline-flex items-center rounded-full border px-2 py-0.5 text-[11.5px] font-medium ${catBadge.bg}`}>
                        {catBadge.label}
                      </span>
                    </td>
                    <td class="px-4 py-3.5 font-normal text-zinc-900 text-[14.5px]">
                      {tx.recipient_name || '---'}
                    </td>
                    <td class="px-4 py-3.5 max-w-sm text-zinc-700">
                      <div class="truncate text-[13px]">{tx.note || '---'}</div>
                      {tx.reference_type === 'repair_ticket' && tx.reference_id && (
                        <a
                          href={`/admin/repairs/${tx.reference_id}`}
                          class="inline-block mt-0.5 text-[12px] text-indigo-600 hover:underline"
                        >
                          → Xem phiếu sửa #{tx.reference_id}
                        </a>
                      )}
                    </td>
                    <td class="px-4 py-3.5 whitespace-nowrap text-right tabular-nums text-[14.5px] font-normal">
                      {tx.status === 'CANCELLED' ? (
                        <span class="text-gray-400 line-through">
                          {isIncome ? `+ ${formatVND(tx.amount_cents)}` : `- ${formatVND(tx.amount_cents)}`}
                        </span>
                        <span class="block text-[10.5px] text-rose-500 font-bold">Đã hủy phiếu</span>
                      ) : isIncome ? (
                        <span class="text-emerald-600 font-semibold">+ {formatVND(tx.amount_cents)}</span>
                      ) : (
                        <span class="text-rose-600 font-semibold">- {formatVND(tx.amount_cents)}</span>
                      )}
                    </td>
                    <td class="px-4 py-3.5 whitespace-nowrap text-center text-[12.5px] text-zinc-500 font-normal">
                      {tx.created_by || 'Hệ thống'}
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
      <div class="border-t border-zinc-200 bg-zinc-50 px-4 py-3 text-[13px] text-zinc-500 flex justify-between items-center">
        <span>Tổng cộng: <strong class="text-zinc-800">{total}</strong> giao dịch</span>
        <span>Hiển thị tối đa 50 giao dịch gần nhất</span>
      </div>
    </div>
  </div>

  <!-- MODAL LẬP PHIẾU THU / CHI THỦ CÔNG -->
  <div id="cash-modal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-zinc-900/60 backdrop-blur-sm p-4 flex items-center justify-center">
    <div class="relative w-full max-w-md rounded-2xl border border-zinc-200 bg-white p-6 shadow-2xl">
      <div class="flex items-center justify-between pb-3 border-b border-zinc-100">
        <h3 id="modal-title" class="text-base font-bold text-zinc-900">Lập phiếu sổ quỹ</h3>
        <button type="button" onclick="closeCashModal()" class="text-zinc-400 hover:text-zinc-700 font-bold text-xl">✕</button>
      </div>

      <form method="POST" action="/api/admin/cash" class="mt-4 space-y-4">
        <input type="hidden" name="request_id" value={crypto.randomUUID()} />
        <input type="hidden" name="flow_type" id="modal-flow-type" value="IN" />

        <div>
          <label class="block text-xs font-semibold text-zinc-700">Loại quỹ</label>
          <div class="grid grid-cols-2 gap-3 mt-1">
            <label class="flex items-center gap-2 rounded-lg border border-zinc-300 p-2.5 cursor-pointer has-[:checked]:border-zinc-900 has-[:checked]:bg-zinc-50">
              <input type="radio" name="account_type" value="CASH" checked class="text-zinc-900" onchange="toggleModalBank(this.value)" />
              <span class="text-xs font-bold">💵 Tiền mặt</span>
            </label>
            <label class="flex items-center gap-2 rounded-lg border border-zinc-300 p-2.5 cursor-pointer has-[:checked]:border-zinc-900 has-[:checked]:bg-zinc-50">
              <input type="radio" name="account_type" value="BANK" class="text-zinc-900" onchange="toggleModalBank(this.value)" />
              <span class="text-xs font-bold">🏦 Ngân hàng</span>
            </label>
          </div>
        </div>

        <div id="modal-bank-field" class="hidden">
          <label class="block text-xs font-semibold text-zinc-700">Tên ngân hàng / Tài khoản</label>
          <input
            type="text"
            name="bank_name"
            placeholder="VD: Vietcombank, MB Bank..."
            class="mt-1 w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm focus:border-zinc-900 focus:outline-none"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-zinc-700">Số tiền (VNĐ) <span class="text-red-500">*</span></label>
          <input
            type="text"
            name="amount"
            required
            placeholder="0"
            class="mt-1 w-full rounded-lg border border-zinc-300 px-3 py-2 text-base font-mono font-bold text-zinc-900 focus:border-zinc-900 focus:outline-none"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-zinc-700">Hạng mục thu / chi</label>
          <p class="mt-1 text-xs text-gray-500">Tiền bán hàng, nhập hàng, sửa chữa và số dư khách ghi từ chứng từ tương ứng để cập nhật đúng công nợ.</p>
          <select name="category" class="mt-1 w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm bg-white focus:outline-none">
            <option value="OTHER" selected>Thu chi khác</option>
            <option value="EXPENSE">Chi phí vận hành</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-zinc-700">Người nộp / nhận tiền</label>
          <input
            type="text"
            name="recipient_name"
            placeholder="VD: Anh Ba, Thợ Kiên, Công ty điện..."
            class="mt-1 w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm focus:border-zinc-900 focus:outline-none"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-zinc-700">Diễn giải / Ghi chú</label>
          <textarea
            name="note"
            rows="2"
            placeholder="Nội dung chi tiết khoản tiền..."
            class="mt-1 w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm focus:border-zinc-900 focus:outline-none"
          ></textarea>
        </div>

        <div class="pt-2 flex items-center justify-end gap-2">
          <button type="button" onclick="closeCashModal()" class="rounded-lg border border-zinc-300 px-4 py-2 text-xs font-semibold text-zinc-700 hover:bg-zinc-50">
            Hủy
          </button>
          <button type="submit" id="modal-submit-btn" class="rounded-lg bg-zinc-900 px-5 py-2 text-xs font-bold text-white hover:bg-zinc-800">
            Lưu giao dịch
          </button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    function openCashModal(flow) {
      const modal = document.getElementById('cash-modal');
      const title = document.getElementById('modal-title');
      const flowInput = document.getElementById('modal-flow-type');
      const submitBtn = document.getElementById('modal-submit-btn');

      flowInput.value = flow;
      const expenseOption = modal.querySelector('option[value="EXPENSE"]');
      if (expenseOption) expenseOption.disabled = flow === 'IN';
      if (flow === 'IN' && modal.querySelector('select[name="category"]').value === 'EXPENSE') modal.querySelector('select[name="category"]').value = 'OTHER';
      if (flow === 'IN') {
        title.innerText = '💵 Lập Phiếu Thu Tiền Vào Quỹ';
        submitBtn.className = 'rounded-lg bg-emerald-600 px-5 py-2 text-xs font-bold text-white hover:bg-emerald-700';
        submitBtn.innerText = '✓ Xác nhận Thu Tiền';
      } else {
        title.innerText = '💸 Lập Phiếu Chi Tiền Ra Khỏi Quỹ';
        submitBtn.className = 'rounded-lg bg-rose-600 px-5 py-2 text-xs font-bold text-white hover:bg-rose-700';
        submitBtn.innerText = '✓ Xác nhận Chi Tiền';
      }
      modal.classList.remove('hidden');
    }

    function closeCashModal() {
      document.getElementById('cash-modal').classList.add('hidden');
    }

    function toggleModalBank(val) {
      const field = document.getElementById('modal-bank-field');
      if (val === 'BANK') {
        field.classList.remove('hidden');
      } else {
        field.classList.add('hidden');
      }
    }
  </script>
</AdminLayout>

---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listPurchaseReturns } from '../../../features/kgame/purchaseReturns.ts';
import { listPurchaseRefunds } from '../../../features/kgame/refunds.ts';
import { getPurchaseReceiptById } from '../../../features/kgame/db';

export const prerender = false;

const idParam = Astro.params.id;
const receiptId = Number(idParam);

if (!receiptId || isNaN(receiptId)) {
  return Astro.redirect('/admin/purchases');
}

const receipt = await getPurchaseReceiptById(env.DB, receiptId);

if (!receipt) {
  return Astro.redirect('/admin/purchases?error=not_found');
}

const subtotal = receipt.items.reduce((sum: number, item: any) => sum + item.quantity * item.unit_cost_cents - (item.discount_cents || 0), 0);
const refunds = await listPurchaseRefunds(env.DB, receiptId);
const purchaseReturns = await listPurchaseReturns(env.DB, receiptId);
const returnedRows = (await env.DB.prepare('SELECT pri.purchase_item_id,SUM(pri.quantity) AS quantity FROM purchase_return_items pri JOIN purchase_returns pr ON pr.id=pri.return_id WHERE pr.receipt_id=? GROUP BY pri.purchase_item_id').bind(receiptId).all<{purchase_item_id:number;quantity:number}>()).results;
const returnedQuantities = Object.fromEntries(returnedRows.map(row=>[row.purchase_item_id,row.quantity]));

const cashHistory = (await env.DB.prepare("SELECT transaction_code,flow_type,amount_cents,status FROM cash_transactions WHERE LOWER(reference_type) IN ('purchase_receipt','purchase_receipt_other_fee') AND reference_id = ? ORDER BY id").bind(receiptId).all<any>()).results;
const refundError = Astro.url.searchParams.get('error');

function formatNumber(cents: number) {
  if (!cents || isNaN(cents)) return '0';
  return new Intl.NumberFormat('en-US').format(cents);
}
const formatVND = formatNumber;
---

<AdminLayout title={`Phiếu nhập ${receipt.receipt_code}`} active="purchases">
  {refundError && <p role="alert" class="mb-4 rounded border border-red-300 bg-red-50 p-3 text-red-800">{refundError}</p>}
  {Astro.url.searchParams.get('refund') === 'received' && <p role="status" class="mb-4 rounded border border-green-300 bg-green-50 p-3 text-green-800">Đã ghi phiếu thu tiền nhà cung cấp hoàn lại.</p>}
  {refunds.map((refund) => (
    <section id="refunds" class="mb-5 rounded-lg border border-amber-300 bg-amber-50 p-4">
      <h2 class="font-semibold">{refund.settled_cents === refund.amount_cents ? 'Đã nhận đủ tiền hoàn' : 'Chờ nhận hoàn tiền từ nhà cung cấp'}</h2>
      <p class="mt-2 text-sm">Cần nhận: {formatVND(refund.amount_cents)}đ · Đã nhận: {formatVND(refund.settled_cents)}đ · Còn lại: {formatVND(refund.amount_cents - refund.settled_cents)}đ</p>
      {refund.amount_cents > refund.settled_cents && (
        <form method="POST" action="/api/admin/purchase-refunds" class="mt-3 grid gap-3 sm:grid-cols-2">
          <input type="hidden" name="obligation_id" value={refund.id} />
          <input type="hidden" name="request_id" value={crypto.randomUUID()} />
          <label class="text-sm">Số tiền thực nhận (đ)<input class="mt-1 block w-full rounded border p-2" type="number" name="amount_cents" min="1" max={refund.amount_cents - refund.settled_cents} step="1" value={refund.amount_cents - refund.settled_cents} required /></label>
          <label class="text-sm">Quỹ nhận<select class="mt-1 block w-full rounded border p-2" name="account_type"><option value="CASH">Tiền mặt</option><option value="BANK">Ngân hàng</option></select></label>
          <label class="text-sm">Ngân hàng<input class="mt-1 block w-full rounded border p-2" name="bank_name" /></label>
          <label class="text-sm">Thông tin giao dịch chuyển khoản<input class="mt-1 block w-full rounded border p-2" name="reference_code" /></label>
          <label class="text-sm sm:col-span-2">Ghi chú<input class="mt-1 block w-full rounded border p-2" name="note" /></label>
          <label class="text-sm sm:col-span-2"><input type="checkbox" name="confirmed" required /> Tôi đã nhận khoản tiền này thực tế</label>
          <button class="rounded bg-green-700 px-4 py-2 text-white sm:col-span-2" type="submit">Xác nhận nhận tiền và lập phiếu thu</button>
        </form>
      )}
    </section>
  ))}
  <!-- TOP HEADER -->
  <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div class="flex items-center gap-3">
      <a
        href="/admin/purchases"
        class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-line bg-white text-gray-500 hover:text-gray-900 transition hover:bg-gray-50"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      </a>
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl font-bold text-gray-900 tracking-tight">{receipt.receipt_code}</h1>
          <span
            class={`inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold ${
              receipt.receipt_status === 'COMPLETED'
                ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                : 'bg-amber-50 text-amber-700 border border-amber-200'
            }`}
          >
            {receipt.receipt_status === 'CANCELLED' ? 'Đã hủy' : receipt.receipt_status === 'COMPLETED' ? '✓ Đã hoàn thành' : '⏳ Phiếu tạm (Đặt hàng nhập)'}
          </span>
        </div>
        <p class="mt-1 text-xs text-gray-500">
          Tạo lúc {new Date(receipt.created_at).toLocaleString('vi-VN')} {receipt.completed_at ? `• Hoàn thành lúc ${new Date(receipt.completed_at).toLocaleString('vi-VN')}` : ''} • Người tạo: Kỹ thuật Kgame
        </p>
        {(receipt.order_receipt_code || receipt.invoice_number) && (
          <div class="mt-1 flex items-center gap-4 text-xs text-gray-600">
            {receipt.order_receipt_code && <span>Mã đặt hàng: <strong class="text-gray-900">{receipt.order_receipt_code}</strong></span>}
            {receipt.invoice_number && <span>Hóa đơn đầu vào: <strong class="text-gray-900">{receipt.invoice_number}</strong></span>}
          </div>
        )}
      </div>
    </div>

    <!-- ACTIONS -->
    <div class="flex items-center gap-2.5">
      {receipt.receipt_status === 'DRAFT' && (
        <button
          type="button"
          id="openCompleteModalBtn"
          class="inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-sm transition hover:bg-emerald-700"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Hoàn thành nhập hàng
        </button>
      )}
      <a
        href={`/admin/purchases/${receipt.id}/print`}
        target="_blank"
        class="inline-flex items-center gap-2 rounded-lg border border-line bg-white px-4 py-2.5 text-xs font-semibold uppercase tracking-wider text-gray-700 shadow-sm transition hover:bg-gray-50 hover:text-brand"
      >
        <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
        In phiếu nhập
      </a>
      <a
        href="/admin/purchases/new"
        class="inline-flex items-center gap-2 rounded-lg bg-brand px-4 py-2.5 text-xs font-semibold uppercase tracking-wider text-white shadow-sm transition hover:bg-brand-hover"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Tạo phiếu mới
      </a>
    </div>
  </div>

  <!-- MAIN GRID -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- CỘT TRÁI (8/12): BẢNG CHI TIẾT HÀNG HÓA -->
    <div class="lg:col-span-8 space-y-6">
      <div class="bg-white rounded-xl border border-line shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-line bg-gray-50/50 flex items-center justify-between">
          <h2 class="text-sm font-bold text-gray-800 uppercase tracking-wider">
            Danh sách hàng hóa nhập ({receipt.items.length} mặt hàng)
          </h2>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-[14.5px] text-gray-700">
            <thead class="bg-[#f8f9fa] border-b border-line text-[14px] font-semibold text-gray-700 select-none">
              <tr>
                <th class="px-3 py-3 text-center w-10">STT</th>
                <th class="px-3 py-3 w-24">Mã hàng</th>
                <th class="px-4 py-3">Tên hàng hóa</th>
                <th class="px-3 py-3 w-24 text-center">Tình trạng</th>
                <th class="px-3 py-3 w-36">Serial / Mã bộ</th>
                <th class="px-3 py-3 w-16 text-center">ĐVT</th>
                <th class="px-3 py-3 w-16 text-center">SL</th>
                <th class="px-3 py-3 w-24 text-right">Đơn giá</th>
                <th class="px-3 py-3 w-20 text-right">Giảm giá</th>
                <th class="px-4 py-3 w-28 text-right">Thành tiền</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              {receipt.items.map((it: any, idx: number) => {
                const lineTotal = it.quantity * it.unit_cost_cents - (it.discount_cents || 0);
                const serial = it.program_code || it.unit_program_code;
                return (
                  <tr class="hover:bg-blue-50/40 transition">
                    <td class="px-3 py-3 text-center text-gray-400 tabular-nums">{idx + 1}</td>
                    <td class="px-3 py-3 text-gray-600 font-normal">{it.product_code || '--'}</td>
                    <td class="px-4 py-3">
                      <div class="font-normal text-gray-900">{it.product_name}</div>
                      {it.type_name && it.type_name !== 'Tiêu chuẩn' && (
                        <div class="text-[12px] text-gray-500">Phiên bản: {it.type_name}</div>
                      )}
                      {it.item_note && (
                        <div class="text-[12px] text-gray-400 italic mt-0.5">Ghi chú: {it.item_note}</div>
                      )}
                    </td>
                    <td class="px-3 py-3 text-center">
                      <span
                        class={`inline-flex items-center px-2 py-0.5 rounded text-[12px] font-medium ${
                          it.condition === 'NEW'
                            ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                            : 'bg-amber-50 text-amber-700 border border-amber-200'
                        }`}
                      >
                        {it.condition === 'NEW' ? 'Mới (NEW)' : 'Cũ (QSD)'}
                      </span>
                    </td>
                    <td class="px-3 py-3">
                      {serial ? (
                        <a
                          href={`/admin/units/lookup?code=${encodeURIComponent(serial)}`}
                          class="inline-flex items-center gap-1 font-normal text-brand bg-blue-50 px-2 py-0.5 rounded hover:underline text-[12.5px]"
                          title="Bấm để xem lịch sử vòng đời serial"
                        >
                          🔑 {serial}
                        </a>
                      ) : (
                        <span class="text-gray-400 italic text-[13px]">--</span>
                      )}
                    </td>
                    <td class="px-3 py-3 text-center text-gray-600">{it.unit_name || 'Cái'}</td>
                    <td class="px-3 py-3 text-center font-normal text-gray-900 tabular-nums">{it.quantity}</td>
                    <td class="px-3 py-3 text-right tabular-nums text-gray-700 font-normal">{formatVND(it.unit_cost_cents)}</td>
                    <td class="px-3 py-3 text-right tabular-nums text-gray-500 font-normal">{formatVND(it.discount_cents || 0)}</td>
                    <td class="px-4 py-3 text-right tabular-nums font-normal text-gray-900">{formatVND(lineTotal)}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        {receipt.note && (
          <div class="p-4 bg-gray-50/70 border-t border-line text-xs text-gray-600">
            <span class="font-bold text-gray-700">Ghi chú phiếu:</span> {receipt.note}
          </div>
        )}
      </div>

      <!-- TÍCH HỢP SỔ KHO & SỔ QUỸ -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-white rounded-xl border border-line p-4 shadow-sm">
          <div class="flex items-center gap-2 text-xs font-bold text-gray-800 uppercase tracking-wider mb-2">
            <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
            Tác động Sổ Kho
          </div>
          <p class="text-xs text-gray-600">
            {receipt.receipt_status === 'COMPLETED' ? 'Đã ghi nhận nhập kho. Xem thẻ kho để đối chiếu hàng và serial.' : receipt.receipt_status === 'CANCELLED' ? 'Phiếu đã hủy. Xem thẻ kho để đối chiếu lịch sử; hủy đặt nhập không tự cộng hàng vào kho.' : 'Phiếu đặt nhập chưa hoàn tất, chưa ghi nhận nhận hàng vào kho.'}
          </p>
          <a href="/admin/inventory" class="inline-block mt-2 text-xs font-semibold text-brand hover:underline">
            Xem Sổ kho & Thẻ kho →
          </a>
        </div>

        <div class="bg-white rounded-xl border border-line p-4 shadow-sm">
          <div class="flex items-center gap-2 text-xs font-bold text-gray-800 uppercase tracking-wider mb-2">
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Tác động Sổ Quỹ
          </div>
          {cashHistory.length ? (
            <div class="space-y-1 text-xs text-gray-600">
              {cashHistory.map((entry) => <p>{entry.flow_type === 'IN' ? 'Phiếu thu' : 'Phiếu chi'} <strong>{entry.transaction_code}</strong>: {formatVND(entry.amount_cents)}đ {entry.status === 'CANCELLED' ? '· Đã hủy phiếu tiền' : ''}</p>)}
              <a href="/admin/cash" class="inline-block mt-2 font-semibold text-brand hover:underline">Xem sổ quỹ thu chi →</a>
            </div>
          ) : <p class="text-xs text-gray-500">Chưa có phiếu thu/chi liên kết.</p>}

        </div>
      </div>
    </div>

    <!-- CỘT PHẢI (4/12): THÔNG TIN NCC & THANH TOÁN -->
    <div class="lg:col-span-4 space-y-6">
      <!-- 1. THÔNG TIN NHÀ CUNG CẤP -->
      <div class="bg-white rounded-xl border border-line p-5 shadow-sm space-y-3">
        <h3 class="text-xs font-bold text-gray-800 uppercase tracking-wider border-b border-line pb-2">
          Thông tin Nhà Cung Cấp / Người bán
        </h3>

        <div class="text-sm">
          <div class="font-bold text-gray-900 text-base">
            {receipt.supplier_name || 'Nhà cung cấp vãng lai / Khách bán lại'}
          </div>
          {receipt.supplier_code && (
            <div class="text-xs text-gray-500 font-mono mt-0.5">Mã NCC: {receipt.supplier_code}</div>
          )}
        </div>

        <div class="text-xs space-y-1.5 text-gray-600 pt-2 border-t border-line">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <span>{receipt.supplier_phone || 'Chưa cập nhật SĐT'}</span>
          </div>
          <div class="flex items-start gap-2">
            <svg class="w-4 h-4 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span>{receipt.supplier_address || 'Chưa có địa chỉ'}</span>
          </div>
        </div>
      </div>

      <!-- 2. THANH TOÁN PHIẾU NHẬP (CHUẨN KIOTVIET) -->
      <div class="bg-white rounded-xl border border-line p-5 shadow-sm space-y-3.5 text-[14px]">
        <h3 class="text-[14.5px] font-semibold text-gray-900 border-b border-line pb-2">
          Chi tiết thanh toán
        </h3>

        <div class="space-y-2.5">
          <div class="flex items-center justify-between text-gray-600">
            <span>Tổng tiền hàng:</span>
            <span class="font-normal tabular-nums text-gray-900">{formatVND(subtotal)}</span>
          </div>

          <div class="flex items-center justify-between text-gray-600">
            <span>Giảm giá:</span>
            <span class="font-normal tabular-nums text-emerald-600">-{formatVND(receipt.discount_cents || 0)}</span>
          </div>

          <div class="flex items-center justify-between text-gray-600">
            <span>Chi phí nhập trả NCC:</span>
            <span class="font-normal tabular-nums text-gray-900">+{formatVND(receipt.extra_fee_cents || 0)}</span>
          </div>

          <div class="pt-2 border-t border-line flex items-center justify-between font-medium text-[14.5px]">
            <span class="text-gray-900">Giá trị phiếu nhập gốc:</span>
            <span class="font-normal tabular-nums text-gray-900">{formatVND(receipt.total_amount_cents)}</span>
          </div>

          <div class="flex items-center justify-between text-gray-700 pt-1">
            <span>Tổng tiền đã trả NCC:</span>
            <span class="font-normal tabular-nums text-emerald-700">{formatVND(receipt.paid_amount_cents || 0)}</span>
          </div>

          <div class="flex items-center justify-between text-gray-700 pt-1">
            <span>Tính vào công nợ:</span>
            <span class={`font-normal tabular-nums ${receipt.debt_amount_cents > 0 ? 'text-amber-600' : 'text-gray-400'}`}>
              {formatVND(receipt.debt_amount_cents || 0)}
            </span>
          </div>

          {(receipt.other_fee_cents > 0) && (
            <div class="pt-2.5 border-t border-dashed border-line">
              <div class="flex items-center justify-between text-gray-700 font-medium">
                <span>Chi phí nhập khác (vận chuyển...):</span>
                <span class="font-normal tabular-nums text-indigo-700">{formatVND(receipt.other_fee_cents)}</span>
              </div>
              <div class="text-[12px] text-gray-500 mt-0.5">
                {receipt.other_fee_note || 'Phí vận chuyển/chành xe'} (Đã tạo phiếu chi sổ quỹ riêng)
              </div>
            </div>
          )}

          {(receipt.returned_amount_cents || 0) > 0 && <div class="flex justify-between text-sm"><span>Giá trị còn lại sau trả hàng:</span><span>{formatVND(receipt.total_amount_cents - receipt.returned_amount_cents)}đ</span></div>}
          {(receipt.returned_amount_cents || 0) > 0 && <div class="flex justify-between text-sm"><span>Giá trị hàng đã trả NCC:</span><span>{formatVND(receipt.returned_amount_cents)}đ</span></div>}
          {(receipt.refunded_amount_cents || 0) > 0 && <div class="flex justify-between text-sm"><span>NCC đã hoàn lại:</span><span>{formatVND(receipt.refunded_amount_cents)}đ</span></div>}
          {(receipt.refunded_amount_cents || 0) > 0 && <div class="flex justify-between text-sm"><span>Tiền còn tại NCC:</span><span>{formatVND(receipt.paid_amount_cents - receipt.refunded_amount_cents)}đ</span></div>}
          <div class="pt-3 border-t border-line flex items-center justify-between text-gray-500 text-[13px]">
            <span>Phương thức:</span>
            <span class="font-normal text-gray-800">
              {receipt.payment_method === 'BANK' ? `Chuyển khoản (${receipt.bank_name || 'Ngân hàng'})` : 'Tiền mặt'}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  {receipt.receipt_status === 'COMPLETED' && <section class="mt-6 rounded-xl border border-line bg-white p-5">
    <h2 class="font-semibold">Trả hàng nhà cung cấp</h2>
    <p class="mt-2 text-sm text-gray-600">Chỉ xác nhận khi đã giao hàng trả. Tiền hàng được tính sau giảm giá; phí nhập và vận chuyển không tự hoàn. Hệ thống giảm nợ trước, phần dư chờ nhận hoàn tại phiếu này.</p>
    {Astro.url.searchParams.has('returned') && <p role="status" class="mt-2 text-green-700">Đã ghi nhận phiếu xuất trả và cập nhật công nợ.</p>}
    <form method="POST" action="/api/admin/purchase-returns" class="mt-4 space-y-3">
      <input type="hidden" name="receipt_id" value={receiptId} />
      <input type="hidden" name="request_id" value={crypto.randomUUID()} />
      {receipt.items.map((item:any) => {
        const remaining=item.quantity-(returnedQuantities[item.id]||0);
        return <label class="flex items-center justify-between gap-4 text-sm"><span>{item.product_name || item.name || `Hàng #${item.product_id}`} · {item.program_code || item.condition} · Còn được trả: {remaining}</span><input aria-label={`Số lượng trả dòng ${item.id}`} class="w-24 rounded border p-2" type="number" name={`quantity:${item.id}`} min="0" max={remaining} step="1" value="0" disabled={remaining===0} /></label>;
      })}
      <label class="block text-sm">Lý do trả hàng<textarea class="mt-1 block w-full rounded border p-2" name="reason" required></textarea></label>
      <label class="block text-sm"><input type="checkbox" name="confirmed" required /> Tôi đã giao số hàng này trả lại nhà cung cấp</label>
      <button class="rounded bg-amber-700 px-4 py-2 text-white" type="submit">Xác nhận xuất trả và giảm công nợ</button>
    </form>
    {purchaseReturns.length > 0 && <div class="mt-4 border-t pt-3"><h3 class="font-semibold">Lịch sử trả hàng</h3>{purchaseReturns.map(row=><p class="mt-2 text-sm">{row.return_code} · {formatVND(row.amount_cents)}đ · {row.reason}</p>)}</div>}
  </section>}

  <!-- MODAL HOÀN THÀNH NHẬP HÀNG (CHO PHIẾU TẠM) -->
  {receipt.receipt_status === 'DRAFT' && (
    <div id="completeModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
        <div class="flex items-center justify-between border-b border-line pb-3">
          <h3 class="text-base font-bold text-gray-900">Xác nhận Hoàn Thành Nhập Hàng</h3>
          <button type="button" id="closeCompleteModalBtn" class="text-gray-400 hover:text-gray-600">✕</button>
        </div>
        <p class="text-xs text-gray-600">
          Khi bấm Hoàn thành, hệ thống sẽ <strong>tăng số lượng tồn kho</strong> các sản phẩm tương ứng, kích hoạt mã serial (nếu có), và ghi nhận thanh toán NCC vào Sổ Quỹ.
        </p>

        <div class="space-y-3 bg-gray-50 p-3.5 rounded-xl border border-line text-xs">
          <div class="flex justify-between">
            <span class="text-gray-500">Mã phiếu:</span>
            <span class="font-bold text-gray-800">{receipt.receipt_code}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Cần trả NCC:</span>
            <span class="font-bold text-gray-900">{formatVND(receipt.total_amount_cents)}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Đã cọc/trả trước:</span>
            <span class="font-bold text-emerald-700">{formatVND(receipt.paid_amount_cents || 0)}</span>
          </div>
          <div class="flex justify-between border-t border-line pt-2 text-[13px]">
            <span class="text-gray-700 font-semibold">Còn thiếu:</span>
            <span class="font-bold text-amber-600">{formatVND(receipt.debt_amount_cents || 0)}</span>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-700 mb-1">Số tiền thanh toán thêm lần này (đ):</label>
          <input
            type="number"
            id="modalPaidAdditional"
            value={receipt.debt_amount_cents || 0}
            min="0"
            max={receipt.debt_amount_cents || 0}
            class="w-full px-3 py-2 border border-line rounded-lg text-sm font-semibold focus:outline-none focus:border-brand"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-700 mb-1">Phương thức thanh toán:</label>
          <select id="modalPaymentMethod" class="w-full px-3 py-2 border border-line rounded-lg text-xs bg-white">
            <option value="CASH">Tiền mặt</option>
            <option value="BANK">Chuyển khoản</option>
          </select>
        </div>

        <div class="flex items-center justify-end gap-3 pt-3 border-t border-line">
          <button type="button" id="cancelCompleteBtn" class="px-4 py-2 text-xs font-medium text-gray-600 hover:bg-gray-100 rounded-lg">
            Hủy
          </button>
          <button type="button" id="confirmCompleteBtn" class="px-5 py-2 text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg shadow">
            Xác nhận Nhập kho & Hoàn tất
          </button>
        </div>
      </div>
    </div>

    <script is:inline define:vars={{ receiptId: receipt.id }}>
      const openBtn = document.getElementById('openCompleteModalBtn');
      const closeBtn = document.getElementById('closeCompleteModalBtn');
      const cancelBtn = document.getElementById('cancelCompleteBtn');
      const modal = document.getElementById('completeModal');
      const confirmBtn = document.getElementById('confirmCompleteBtn');
      const modalPaid = document.getElementById('modalPaidAdditional');
      const completeRequestId = crypto.randomUUID();
      const modalMethod = document.getElementById('modalPaymentMethod');

      if (openBtn && modal) {
        openBtn.addEventListener('click', () => modal.classList.remove('hidden'));
      }
      if (closeBtn && modal) {
        closeBtn.addEventListener('click', () => modal.classList.add('hidden'));
      }
      if (cancelBtn && modal) {
        cancelBtn.addEventListener('click', () => modal.classList.add('hidden'));
      }

      if (confirmBtn) {
        confirmBtn.addEventListener('click', async () => {
          confirmBtn.disabled = true;
          confirmBtn.textContent = 'Đang xử lý...';

          try {
            const res = await fetch('/api/admin/purchases', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'complete',
                receiptId: receiptId,
                request_id: completeRequestId,
                additional_paid_cents: Number(modalPaid?.value || 0),
                payment_method: modalMethod?.value || 'CASH'
              })
            });

            const data = await res.json();
            if (data.success) {
              window.location.reload();
            } else {
              alert(data.error || 'Có lỗi xảy ra khi hoàn thành phiếu');
              confirmBtn.disabled = false;
              confirmBtn.textContent = 'Xác nhận Nhập kho & Hoàn tất';
            }
          } catch (e) {
            alert('Lỗi mạng: ' + e.message);
            confirmBtn.disabled = false;
            confirmBtn.textContent = 'Xác nhận Nhập kho & Hoàn tất';
          }
        });
      }
    </script>
  )}
</AdminLayout>

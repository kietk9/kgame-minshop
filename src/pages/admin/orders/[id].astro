---
import { hasPermission,withoutCosts } from '../../../features/auth/permissions';
import { env } from 'cloudflare:workers';
import KgameOrderDetail from '../../../features/kgame/KgameOrderDetail.astro';
import { getPosOrderById, listKgameCustomers } from '../../../features/kgame/db';

export const prerender = false;

const rawParam = Astro.params.id || '';
let kgameOrder: any = null;

if (/^\d+$/.test(rawParam)) {
  kgameOrder = await getPosOrderById(env.DB, Number(rawParam));
} else if (/^ĐH/i.test(rawParam)) {
  const match = await env.DB.prepare('SELECT id FROM orders WHERE order_code = ? LIMIT 1').bind(rawParam).first<{ id: number }>();
  if (match) kgameOrder = await getPosOrderById(env.DB, match.id);
}


const success = Astro.url.searchParams.get('success');
const error = Astro.url.searchParams.get('error');

if (!kgameOrder) {
  // If not found in numeric or ĐH code, try to query by id or order_code
  const row = await env.DB.prepare('SELECT id FROM orders WHERE order_code = ? OR id = ? LIMIT 1')
    .bind(rawParam, Number(rawParam) || -1)
    .first<{ id: number }>();
  if (row) {
    kgameOrder = await getPosOrderById(env.DB, row.id);
  }
}

if (!kgameOrder) {
  return new Response('Không tìm thấy đơn hàng', { status: 404 });
}
kgameOrder.refund_obligation = await env.DB.prepare("SELECT * FROM kgame_refund_obligations WHERE source_type='ORDER' AND source_id=?").bind(kgameOrder.id).first();
kgameOrder.customer_returns = (await env.DB.prepare('SELECT * FROM customer_returns WHERE order_id=? ORDER BY id DESC').bind(kgameOrder.id).all()).results;
kgameOrder.return_inspection_items=(await env.DB.prepare('SELECT ri.*,r.return_code,l.product_name_snapshot,l.condition FROM customer_return_items ri JOIN customer_returns r ON r.id=ri.return_id JOIN order_lines l ON l.id=ri.order_line_id WHERE r.order_id=? ORDER BY ri.id').bind(kgameOrder.id).all()).results;
kgameOrder.return_inspections=(await env.DB.prepare('SELECT i.* FROM customer_return_inspections i JOIN customer_return_items ri ON ri.id=i.return_item_id JOIN customer_returns r ON r.id=ri.return_id WHERE r.order_id=? ORDER BY i.id DESC').bind(kgameOrder.id).all()).results;
kgameOrder.return_disposals=(await env.DB.prepare('SELECT d.* FROM customer_return_disposals d JOIN customer_return_items ri ON ri.id=d.return_item_id JOIN customer_returns r ON r.id=ri.return_id WHERE r.order_id=? ORDER BY d.id DESC').bind(kgameOrder.id).all()).results;
const returnedLines=(await env.DB.prepare('SELECT ri.order_line_id,SUM(ri.quantity) AS quantity FROM customer_return_items ri JOIN customer_returns r ON r.id=ri.return_id WHERE r.order_id=? GROUP BY ri.order_line_id').bind(kgameOrder.id).all<any>()).results;
for(const line of kgameOrder.lines??[])line.returned_quantity=returnedLines.find(r=>r.order_line_id===line.id)?.quantity??0;
if(!hasPermission(Astro.locals.adminPrincipal,'cost.view'))kgameOrder=withoutCosts(kgameOrder);
const { customers: creditCustomers } = kgameOrder && !kgameOrder.customer_id && kgameOrder.paid_amount_cents > 0
  ? await listKgameCustomers(env.DB, { limit: 300 }) : { customers: [] };
---

<KgameOrderDetail creditCustomers={creditCustomers} order={kgameOrder} success={success} error={error} />

---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';

export const prerender = false;

const url = new URL(Astro.request.url);
const selectedPartnerId = url.searchParams.get('partner') || '';

// 1. Lấy danh sách Đối tác Giao hàng
const { results: rawPartners } = await env.DB.prepare(`
  SELECT id, partner_code, name, partner_type, phone FROM delivery_partners WHERE status = 'ACTIVE' ORDER BY name ASC
`).all<any>();
const partners = rawPartners ?? [];

// 2. Lấy danh sách các phiếu đối soát đã thực hiện
const { results: rawRecons } = await env.DB.prepare(`
  SELECT 
    dr.*,
    dp.name AS partner_name,
    dp.partner_type,
    ct.transaction_code,
    ct.flow_type AS cash_flow_type
  FROM delivery_reconciliations dr
  LEFT JOIN delivery_partners dp ON dr.partner_id = dp.id
  LEFT JOIN cash_transactions ct ON dr.cash_transaction_id = ct.id
  ORDER BY dr.id DESC
`).all<any>();
const reconciliations = rawRecons ?? [];

// 3. Nếu đang chọn đối tác cụ thể, lấy danh sách các vận đơn ĐÃ GIAO mà CHƯA ĐỐI SOÁT
let pendingShipments: any[] = [];
if (selectedPartnerId) {
  const { results: rawPending } = await env.DB.prepare(`
    SELECT 
      s.*,
      o.order_code,
      o.amount_total_cents
    FROM shipments s
    LEFT JOIN orders o ON s.order_id = o.id
    WHERE s.delivery_partner_id = ?
      AND s.status = 'DELIVERED'
      AND (s.reconciliation_status IS NULL OR s.reconciliation_status != 'RECONCILED')
    ORDER BY s.id ASC
  `).bind(Number(selectedPartnerId)).all<any>();

  pendingShipments = rawPending ?? [];
}

const formatNum = (val: number) => {
  if (!val || isNaN(val)) return '0';
  return new Intl.NumberFormat('en-US').format(val);
};

const formatDate = (iso: string) => {
  if (!iso) return '—';
  try {
    const d = new Date(iso);
    return d.toLocaleString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  } catch {
    return iso;
  }
};
---

<AdminLayout title="Đối soát COD & Cước giao vận" active="orders">
  <div class="space-y-6">
    
    <!-- HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 bg-white p-4 rounded-xl border border-gray-200 shadow-xs">
      <div>
        <div class="flex items-center gap-2">
          <a href="/admin/shipments" class="text-gray-400 hover:text-gray-700 transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          </a>
          <h1 class="text-xl font-bold text-gray-900">Đối soát COD & Cước phí giao vận</h1>
        </div>
        <p class="text-xs text-gray-500 mt-1">
          Quy trình đối soát an toàn 2 lớp: Kiểm tra tài khoản thực tế &rarr; Xác nhận khớp tiền &rarr; Tự động vào Sổ quỹ & hoàn tất đơn.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/admin/cash"
          class="px-3.5 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-lg text-xs transition flex items-center gap-1.5"
        >
          <span>📖</span> Xem Sổ quỹ
        </a>
      </div>
    </div>

    <!-- KHU VỰC TẠO KỲ ĐỐI SOÁT MỚI -->
    <div class="bg-white rounded-xl border border-blue-200 shadow-sm overflow-hidden">
      <div class="p-4 bg-blue-50/70 border-b border-blue-100 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-blue-600 text-white font-bold text-xs">
            1
          </span>
          <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wide">
            Lập kỳ đối soát mới với đối tác
          </h2>
        </div>
        <span class="text-xs text-blue-700 font-medium">Chọn chành xe hoặc hãng để tải danh sách vận đơn</span>
      </div>

      <div class="p-4 space-y-4">
        <!-- CHỌN ĐỐI TÁC GIAO HÀNG -->
        <div class="max-w-md">
          <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
            Chọn đối tác giao hàng / Chành xe:
          </label>
          <select
            id="reconPartnerSelect"
            class="w-full h-9 px-3 bg-white border-2 border-blue-300 rounded-lg text-xs font-bold text-gray-900 focus:outline-none focus:border-blue-600"
          >
            <option value="">-- Bấm chọn đối tác để đối soát --</option>
            {partners.map((p: any) => (
              <option value={p.id} selected={String(p.id) === selectedPartnerId}>
                {p.name} ({p.partner_type === 'BUS' ? 'Chành xe' : p.partner_type === 'INTEGRATED' ? 'Hãng GH' : 'Shipper'})
              </option>
            ))}
          </select>
        </div>

        {selectedPartnerId && (
          <div class="space-y-4 pt-2 border-t border-gray-100">
            {pendingShipments.length > 0 ? (
              <div>
                <div class="flex items-center justify-between mb-2 text-xs">
                  <span class="font-bold text-gray-800">
                    Danh sách vận đơn đã giao thành công (Chờ nhận tiền COD):
                  </span>
                  <span class="text-blue-600 font-semibold">
                    {pendingShipments.length} vận đơn chưa đối soát
                  </span>
                </div>

                <!-- BẢNG CÁC VẬN ĐƠN CHỜ ĐỐI SOÁT -->
                <div class="border border-gray-200 rounded-lg overflow-x-auto">
                  <table class="w-full text-left text-xs text-gray-700">
                    <thead class="bg-gray-50 border-b border-gray-200 text-[11px] font-bold text-gray-600 uppercase">
                      <tr>
                        <th class="py-2.5 px-3 w-10 text-center">
                          <input type="checkbox" id="reconSelectAll" checked class="rounded text-blue-600 focus:ring-0 cursor-pointer" />
                        </th>
                        <th class="py-2.5 px-3 w-28">Đơn hàng</th>
                        <th class="py-2.5 px-3 w-32">Mã vận đơn / Xe</th>
                        <th class="py-2.5 px-3">Người nhận / Trạm đón</th>
                        <th class="py-2.5 px-3 text-right">Tiền COD thu hộ</th>
                        <th class="py-2.5 px-3 text-right">Cước xe shop trả</th>
                        <th class="py-2.5 px-3 text-right">Shop thực nhận</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100" id="reconShipmentsBody">
                      {pendingShipments.map((s: any) => {
                        const shopFee = s.shipping_payer === 'SHOP_PAYS' ? (s.shipping_fee_cents || 0) : 0;
                        const netUnit = (s.cod_amount_cents || 0) - shopFee;
                        return (
                          <tr class="hover:bg-blue-50/40 transition">
                            <td class="py-2.5 px-3 text-center">
                              <input
                                type="checkbox"
                                class="recon-item-checkbox rounded text-blue-600 focus:ring-0 cursor-pointer"
                                value={s.id}
                                data-cod={s.cod_amount_cents || 0}
                                data-fee={shopFee}
                                checked
                              />
                            </td>
                            <td class="py-2.5 px-3 font-mono font-bold text-blue-700">
                              {s.order_code || `DH#${s.order_id}`}
                            </td>
                            <td class="py-2.5 px-3 font-mono font-semibold text-gray-800">
                              {s.tracking_code || s.bus_plate || '—'}
                            </td>
                            <td class="py-2.5 px-3">
                              <span class="font-medium text-gray-900">{s.receiver_name}</span>
                              <span class="text-gray-400 text-[11px] block">{s.bus_station || s.receiver_phone || ''}</span>
                            </td>
                            <td class="py-2.5 px-3 text-right tabular-nums font-bold text-[#0070d2]">
                              {formatNum(s.cod_amount_cents || 0)}
                            </td>
                            <td class="py-2.5 px-3 text-right tabular-nums font-semibold text-amber-600">
                              {formatNum(shopFee)}
                            </td>
                            <td class="py-2.5 px-3 text-right tabular-nums font-extrabold text-emerald-600">
                              {formatNum(netUnit)}
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>

                <!-- TỔNG HỢP VÀ KHỐI XÁC NHẬN KIỂM TRA TÀI KHOẢN (2-FACTOR CONFIRMATION) -->
                <div class="mt-4 p-4 rounded-xl border border-blue-200 bg-blue-50/50 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                  <!-- BẢNG TỔNG TIỀN -->
                  <div class="space-y-1 text-xs">
                    <div class="flex items-center gap-4 text-gray-600">
                      <span>Tổng tiền COD thu hộ:</span>
                      <span id="reconTotalCod" class="font-bold text-gray-900 text-sm tabular-nums">0</span>
                    </div>
                    <div class="flex items-center gap-4 text-gray-600">
                      <span>Trừ cước vận chuyển shop trả:</span>
                      <span id="reconTotalFee" class="font-semibold text-amber-700 text-sm tabular-nums">0</span>
                    </div>
                    <div class="flex items-center gap-4 text-gray-900 font-extrabold text-base pt-1 border-t border-blue-200">
                      <span>SỐ TIỀN SHOP THỰC NHẬN:</span>
                      <span id="reconNetAmount" class="text-xl text-[#0070d2] tabular-nums">0</span>
                    </div>
                  </div>

                  <!-- FORM XÁC NHẬN KIỂM TRA TÀI KHOẢN -->
                  <div class="space-y-3 bg-white p-3.5 rounded-lg border border-gray-200 text-xs max-w-md w-full">
                    <div class="grid grid-cols-2 gap-2">
                      <div>
                        <label class="block text-gray-600 font-medium mb-0.5">Tài khoản nhận tiền:</label>
                        <select id="reconAccountType" class="w-full h-8 px-2 border border-gray-300 rounded font-bold text-xs focus:outline-none">
                          <option value="BANK" selected>💳 Tài khoản Ngân hàng</option>
                          <option value="CASH">💵 Tiền mặt tại xưởng</option>
                        </select>
                      </div>
                      <div>
                        <label class="block text-gray-600 font-medium mb-0.5">Ngân hàng / STK:</label>
                        <input
                          type="text"
                          id="reconBankName"
                          placeholder="VD: MB Bank 9999..."
                          class="w-full h-8 px-2 border border-gray-300 rounded text-xs focus:outline-none"
                        />
                      </div>
                    </div>

                    <div>
                      <input
                        type="text"
                        id="reconNote"
                        placeholder="Ghi chú đối soát / Mã ủy nhiệm chi..."
                        class="w-full h-8 px-2 border border-gray-300 rounded text-xs focus:outline-none"
                      />
                    </div>

                    <!-- CHECKBOX KHÓA BẢO MẬT BẮT BUỘC -->
                    <label class="flex items-start gap-2 p-2 rounded bg-amber-50 border border-amber-200 text-amber-900 text-[11.5px] cursor-pointer">
                      <input type="checkbox" id="reconVerifyCheck" class="mt-0.5 rounded text-blue-600 focus:ring-0" />
                      <span>
                        <strong>Tôi xác nhận:</strong> Đã kiểm tra tài khoản ngân hàng / tiền mặt thực tế và số tiền đã về tài khoản đúng khớp.
                      </span>
                    </label>

                    <button
                      type="button"
                      id="reconSubmitBtn"
                      disabled
                      class="w-full h-10 bg-[#0070d2] hover:bg-[#005bb5] active:bg-[#004a94] disabled:opacity-40 disabled:pointer-events-none text-white font-extrabold text-xs rounded shadow transition flex items-center justify-center gap-2 cursor-pointer"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                      </svg>
                      XÁC NHẬN TIỀN VỀ & VÀO SỔ QUỸ
                    </button>
                  </div>
                </div>
              </div>
            ) : (
              <div class="py-8 text-center text-gray-400 text-xs">
                Không có vận đơn nào của đối tác này ở trạng thái "Đã giao" đang chờ đối soát.
              </div>
            )}
          </div>
        )}
      </div>
    </div>

    <!-- KHU VỰC LỊCH SỬ CÁC PHIẾU ĐỐI SOÁT ĐÃ HOÀN TẤT -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-xs overflow-hidden">
      <div class="p-4 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wide flex items-center gap-2">
          <span>Lịch sử các phiếu đối soát giao vận</span>
          <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800">
            {reconciliations.length} phiếu đã hạch toán
          </span>
        </h2>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-gray-700">
          <thead class="bg-[#f8f9fa] border-b border-gray-200 text-[11.5px] font-bold text-gray-600 uppercase tracking-wider select-none">
            <tr>
              <th class="py-3 px-3 w-28">Mã đối soát</th>
              <th class="py-3 px-3">Đối tác giao hàng</th>
              <th class="py-3 px-3 w-24 text-center">Số vận đơn</th>
              <th class="py-3 px-3 text-right">Tổng COD thu</th>
              <th class="py-3 px-3 text-right">Trừ cước shop trả</th>
              <th class="py-3 px-3 text-right">Thực nhận về quỹ</th>
              <th class="py-3 px-3">Phiếu Sổ quỹ</th>
              <th class="py-3 px-3">Người xác nhận</th>
              <th class="py-3 px-3 text-center w-28">Trạng thái</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {reconciliations.length > 0 ? (
              reconciliations.map((r: any) => (
                <tr class="hover:bg-blue-50/40 transition">
                  <td class="py-3 px-3 font-mono font-bold text-blue-700">
                    {r.reconciliation_code}
                  </td>
                  <td class="py-3 px-3 font-semibold text-gray-900">
                    {r.partner_name || '—'}
                  </td>
                  <td class="py-3 px-3 text-center tabular-nums font-bold">
                    {r.total_orders} đơn
                  </td>
                  <td class="py-3 px-3 text-right tabular-nums font-bold text-gray-800">
                    {formatNum(r.total_cod_cents)}
                  </td>
                  <td class="py-3 px-3 text-right tabular-nums font-semibold text-amber-600">
                    {formatNum(r.total_fee_cents)}
                  </td>
                  <td class="py-3 px-3 text-right tabular-nums font-extrabold text-emerald-600 text-sm">
                    {formatNum(r.net_amount_cents)}
                  </td>
                  <td class="py-3 px-3">
                    {r.transaction_code ? (
                      <a href="/admin/cash" class="font-mono font-bold text-blue-600 hover:underline">
                        {r.transaction_code}
                      </a>
                    ) : (
                      <span class="text-gray-400 italic">Đã vào quỹ</span>
                    )}
                  </td>
                  <td class="py-3 px-3 text-gray-500">
                    <div>{r.verified_by || 'Kế toán'}</div>
                    <div class="text-[10.5px] text-gray-400">{formatDate(r.verified_at)}</div>
                  </td>
                  <td class="py-3 px-3 text-center">
                    <span class="inline-block px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10.5px] font-bold">
                      Đã vào sổ quỹ
                    </span>
                  </td>
                </tr>
              ))
            ) : (
              <tr>
                <td colspan="9" class="py-10 text-center text-gray-400">
                  Chưa có phiếu đối soát nào được thực hiện.
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const partnerSelect = document.getElementById('reconPartnerSelect');
      partnerSelect?.addEventListener('change', (e) => {
        const val = e.target.value;
        window.location.href = `/admin/delivery-reconciliations?partner=${val}`;
      });

      const selectAll = document.getElementById('reconSelectAll');
      const itemCheckboxes = document.querySelectorAll('.recon-item-checkbox');
      const totalCodEl = document.getElementById('reconTotalCod');
      const totalFeeEl = document.getElementById('reconTotalFee');
      const netAmountEl = document.getElementById('reconNetAmount');
      const verifyCheck = document.getElementById('reconVerifyCheck');
      const submitBtn = document.getElementById('reconSubmitBtn');

      const formatNum = (val) => {
        if (!val || isNaN(val)) return '0';
        return new Intl.NumberFormat('en-US').format(val);
      };

      const recalculate = () => {
        let cod = 0;
        let fee = 0;
        itemCheckboxes.forEach(cb => {
          if (cb.checked) {
            cod += Number(cb.dataset.cod || 0);
            fee += Number(cb.dataset.fee || 0);
          }
        });

        const net = cod - fee;
        if (totalCodEl) totalCodEl.innerText = formatNum(cod);
        if (totalFeeEl) totalFeeEl.innerText = formatNum(fee);
        if (netAmountEl) netAmountEl.innerText = formatNum(net);
      };

      selectAll?.addEventListener('change', (e) => {
        itemCheckboxes.forEach(cb => cb.checked = e.target.checked);
        recalculate();
      });

      itemCheckboxes.forEach(cb => {
        cb.addEventListener('change', recalculate);
      });

      recalculate();

      // Chỉ kích hoạt nút submit khi người dùng tick vào checkbox xác nhận kiểm tra tài khoản
      verifyCheck?.addEventListener('change', (e) => {
        if (submitBtn) {
          submitBtn.disabled = !e.target.checked;
        }
      });

      // Submit đối soát
      submitBtn?.addEventListener('click', async () => {
        const checked = Array.from(itemCheckboxes).filter(cb => cb.checked);
        if (checked.length === 0) {
          alert('Vui lòng chọn ít nhất 1 vận đơn để đối soát');
          return;
        }

        const partnerId = partnerSelect?.value;
        const shipmentIds = checked.map(cb => Number(cb.value));
        const accountType = document.getElementById('reconAccountType')?.value || 'BANK';
        const bankName = document.getElementById('reconBankName')?.value || '';
        const note = document.getElementById('reconNote')?.value || '';

        submitBtn.disabled = true;
        submitBtn.innerText = 'Đang hạch toán vào Sổ quỹ...';

        try {
          const resp = await fetch('/api/admin/delivery-reconciliations', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'create_and_settle',
              partner_id: Number(partnerId),
              shipment_ids: shipmentIds,
              account_type: accountType,
              bank_name: bankName,
              note: note,
              verified_by: 'Kế toán Kgame'
            })
          });

          const result = await resp.json();
          if (result.success) {
            alert(`Thành công: ${result.message}`);
            window.location.href = '/admin/delivery-reconciliations';
          } else {
            alert(result.error || 'Lỗi khi đối soát');
            submitBtn.disabled = false;
            submitBtn.innerText = 'XÁC NHẬN TIỀN VỀ & VÀO SỔ QUỸ';
          }
        } catch (err) {
          alert('Lỗi kết nối mạng');
          submitBtn.disabled = false;
          submitBtn.innerText = 'XÁC NHẬN TIỀN VỀ & VÀO SỔ QUỸ';
        }
      });
    });
  </script>
</AdminLayout>

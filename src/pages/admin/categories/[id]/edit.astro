---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import CategoryForm from '../../../../features/categories/CategoryForm.astro';
import {
  getCategoryByPublicId,
  listCategories,
  buildTree,
  flattenTree,
  descendantIds,
} from '../../../../features/categories/db';
import { parsePublicId } from '../../../../features/ids/publicId';

const publicId = parsePublicId(Astro.params.id, 'category');
const category = publicId ? await getCategoryByPublicId(env.DB, publicId) : null;

if (!category) {
  return new Response('Not found', { status: 404 });
}

// A category can't be moved under itself or one of its descendants — exclude them.
const blocked = new Set(await descendantIds(env.DB, category.id));
const parentOptions = flattenTree(buildTree(await listCategories(env.DB))).filter(
  (o) => !blocked.has(o.id),
);
const error = Astro.url.searchParams.get('error');
---

<AdminLayout title={`Sửa danh mục: ${category.name}`} active="categories">
  <div class="mb-6">
    <a href="/admin/categories" class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-brand transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      Quay lại danh mục
    </a>
    <h1 class="mt-2 text-2xl font-bold text-gray-900">Sửa tên danh mục: {category.name}</h1>
    <p class="text-sm text-gray-500 mt-1">Cập nhật tên gọi hoặc thay đổi cấp bậc của danh mục.</p>
  </div>

  <CategoryForm
    action={`/api/admin/categories/${category.public_id}`}
    submitLabel="Cập nhật danh mục"
    category={category}
    parentOptions={parentOptions}
    error={error}
  />
</AdminLayout>

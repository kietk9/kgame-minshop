---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import CategoryForm from '../../../features/categories/CategoryForm.astro';
import { listCategories, buildTree, flattenTree } from '../../../features/categories/db';

const parentOptions = flattenTree(buildTree(await listCategories(env.DB)));
const error = Astro.url.searchParams.get('error');
---

<AdminLayout title="Thêm danh mục mới" active="categories">
  <div class="mb-6">
    <a href="/admin/categories" class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-brand transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      Quay lại danh mục
    </a>
    <h1 class="mt-2 text-2xl font-bold text-gray-900">Thêm danh mục mới</h1>
    <p class="text-sm text-gray-500 mt-1">Tạo nhóm phân loại mới cho kho hàng KGAME.</p>
  </div>

  <CategoryForm
    action="/api/admin/categories"
    submitLabel="Lưu danh mục"
    parentOptions={parentOptions}
    error={error}
  />
</AdminLayout>

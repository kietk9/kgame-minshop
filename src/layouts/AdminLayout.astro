---
import { hasPermission } from '../features/auth/permissions';
import { roleLabels } from '../features/auth/staffPolicy';
import { getConfig } from '../config';
import { paymentsInDemoMode } from '../features/payments';
import { shippingFor } from '../features/shipping/effective';
import { env } from 'cloudflare:workers';
import { countUnresolvedInventoryExceptions } from '../features/orders/db';
import '../styles/admin.css';

type Section =
  | 'dashboard'
  | 'units'
  | 'products'
  | 'categories'
  | 'brands'
  | 'inventory'
  | 'production'
  | 'repairs'
  | 'cash'
  | 'pending-actions'
  | 'orders'
  | 'purchases'
  | 'buybacks'
  | 'customers'
  | 'suppliers'
  | 'reports'
  | 'reports-daily'
  | 'reports-sales'
  | 'reports-orders'
  | 'reports-products'
  | 'reports-customers'
  | 'reports-financial'
  | 'media'
  | 'pages'
  | 'navigation'
  | 'shipping'
  | 'staff'
  | 'settings';

interface Props {
  title?: string;
  active?: Section;
}

const { title, active } = Astro.props;
const config = getConfig();
const storeName = Astro.locals.settings?.storeName ?? config.storeName;
const principal = Astro.locals.adminPrincipal;
const isStaff = !!principal && principal.role !== 'OWNER';
const showSetupNudge = !isStaff &&
  !Astro.locals.settings?.setupComplete && Astro.url.pathname !== '/admin/setup';
const showLogout = !!Astro.cookies.get('admin_session')?.value || !!Astro.cookies.get('staff_session')?.value;
const pageTitle = title ? `${title} — ${storeName} Kgame` : `${storeName} Kgame Quản trị`;

const shippingIssue = isStaff ? null : shippingFor(Astro.locals.settings).issue;
const inventoryExceptionCount = isStaff ? 0 : await countUnresolvedInventoryExceptions(env.DB);

// Group active checking
const isProductsActive = ['products', 'categories', 'brands', 'units', 'inventory', 'production'].includes(active ?? '');
const isPurchasesActive = ['purchases', 'buybacks'].includes(active ?? '');
const isOrdersActive = ['orders', 'repairs'].includes(active ?? '');
const isReportsActive = (active ?? '').startsWith('report');
const isSettingsActive = ['settings', 'media', 'pages', 'navigation', 'shipping'].includes(active ?? '');
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-paper text-ink antialiased font-sans flex flex-col">
    <!-- TOP NAVIGATION BAR (CHUẨN KIOTVIET) -->
    {isStaff ? <header class="sticky top-0 z-50 bg-[#0b4d9c] text-white px-4 py-3 flex flex-wrap gap-4 items-center"><strong>{principal.name} · {roleLabels[principal.role]}</strong>{hasPermission(principal,'sales.view') && <a href="/admin/orders">Đơn hàng</a>}{hasPermission(principal,'sales.create') && <a href="/admin/sale">Bán hàng</a>}{hasPermission(principal,'purchases.manage') && <a href="/admin/purchases">Nhập mua</a>}{hasPermission(principal,'inventory.adjust') && <a href="/admin/inventory">Kho</a>}{hasPermission(principal,'reports.view') && <a href="/admin/reports/staff">Báo cáo</a>}<a href="/admin/my-access">Quyền của tôi</a><a href="/admin/change-password">Đổi mật khẩu</a><a href="/admin/logout" class="ml-auto">Đăng xuất</a></header> : <header class="sticky top-0 z-50 bg-[#0b4d9c] shadow-md select-none">
      <div class="mx-auto flex h-[50px] w-full max-w-[1720px] items-center justify-between px-3 sm:px-4">
        <!-- LEFT: BRAND LOGO & DESKTOP MENU -->
        <div class="flex items-center gap-1 lg:gap-2">
          <!-- Mobile Menu Trigger -->
          <label for="mobile-nav-toggle" class="cursor-pointer p-1.5 text-white/80 hover:text-white lg:hidden">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </label>

          <!-- Store Logo -->
          <a href="/admin" class="flex items-center gap-2 pr-3 text-white font-bold tracking-tight text-base sm:text-lg">
            <span class="flex h-7 w-7 items-center justify-center rounded bg-white text-[#0b4d9c] font-black text-sm shadow-xs">
              K
            </span>
            <span class="hidden font-extrabold tracking-wide sm:inline">{storeName}</span>
          </a>

          <!-- DESKTOP NAV TABS -->
          <nav class="hidden items-center lg:flex">
            <!-- 1. TỔNG QUAN -->
            <a
              href="/admin"
              class={`flex h-[50px] items-center px-3.5 text-[14px] font-medium tracking-wide transition ${
                active === 'dashboard'
                  ? 'bg-[#083a77] text-white font-semibold shadow-inner'
                  : 'text-white/90 hover:bg-white/10 hover:text-white'
              }`}
            >
              Tổng quan
            </a>

            <!-- 2. HÀNG HÓA (MEGA DROPDOWN) -->
            <div class="group relative">
              <a
                href="/admin/products"
                class={`flex h-[50px] items-center gap-1 px-3.5 text-[14px] font-medium tracking-wide transition ${
                  isProductsActive
                    ? 'bg-[#083a77] text-white font-semibold shadow-inner'
                    : 'text-white/90 hover:bg-white/10 hover:text-white'
                }`}
              >
                <span>Hàng hóa</span>
                <svg class="h-3.5 w-3.5 opacity-70 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </a>

              <!-- Dropdown Menu -->
              <div class="absolute left-0 top-full hidden pt-1 group-hover:block z-50">
                <div class="flex rounded-lg border border-gray-200 bg-white p-4 shadow-2xl min-w-[390px] text-gray-800 divide-x divide-gray-100">
                  <!-- Cột Hàng hóa -->
                  <div class="pr-4 flex-1 space-y-1">
                    <div class="px-2 pb-1.5 text-[11.5px] font-bold uppercase tracking-wider text-gray-400">
                      Hàng hóa
                    </div>
                    <a href="/admin/products" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition">
                      <span class="text-gray-400">📦</span> Danh sách hàng hóa
                    </a>
                    <a href="/admin/categories" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition">
                      <span class="text-gray-400">🏷️</span> Nhóm hàng
                    </a>
                    <a href="/admin/units/lookup" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition">
                      <span class="text-gray-400">🔍</span> Tra cứu Serial / IMEI
                    </a>
                  </div>

                  <!-- Cột Kho hàng -->
                  <div class="pl-4 flex-1 space-y-1">
                    <div class="px-2 pb-1.5 text-[11.5px] font-bold uppercase tracking-wider text-gray-400">
                      Kho hàng
                    </div>
                    <a href="/admin/inventory" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition">
                      <span class="text-gray-400">📋</span> Sổ kho & Thẻ kho
                    </a>
                    <a href="/admin/inventory/outbound/new" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition">
                      <span class="text-gray-400">🛠️</span> Lập phiếu xuất kho khác
                    </a>
                    <a href="/admin/production" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition">
                      <span class="text-gray-400">⚙️</span> Lắp ráp & Đóng gói
                    </a>
                  </div>
                </div>
              </div>
            </div>

            <!-- 3. MUA HÀNG (MEGA DROPDOWN) -->
            <div class="group relative">
              <a
                href="/admin/purchases"
                class={`flex h-[50px] items-center gap-1 px-3.5 text-[14px] font-medium tracking-wide transition ${
                  isPurchasesActive
                    ? 'bg-[#083a77] text-white font-semibold shadow-inner'
                    : 'text-white/90 hover:bg-white/10 hover:text-white'
                }`}
              >
                <span>Mua hàng</span>
                <svg class="h-3.5 w-3.5 opacity-70 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </a>

              <!-- Dropdown Menu -->
              <div class="absolute left-0 top-full hidden pt-1 group-hover:block z-50">
                <div class="rounded-lg border border-gray-200 bg-white p-3 shadow-2xl min-w-[250px] text-gray-800 space-y-1">
                  <div class="px-2 pb-1 text-[11.5px] font-bold uppercase tracking-wider text-gray-400">
                    Nhập hàng & Nhà cung cấp
                  </div>
                  <a href="/admin/purchases" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition">
                    <span class="text-gray-400">📥</span> Danh sách phiếu nhập
                  </a>
                  <a href="/admin/purchases/new" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition">
                    <span class="text-gray-400">➕</span> Nhập hàng
                  </a>
                  <a href="/admin/suppliers" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition">
                    <span class="text-gray-400">🏭</span> Quản lý Nhà cung cấp
                  </a>
                </div>
              </div>
            </div>

            <!-- 4. ĐƠN HÀNG & BÁN HÀNG (DROPDOWN) -->
            <div class="group relative">
              <a
                href="/admin/orders"
                class={`flex h-[50px] items-center gap-1 px-3.5 text-[14px] font-medium tracking-wide transition ${
                  isOrdersActive
                    ? 'bg-[#083a77] text-white font-semibold shadow-inner'
                    : 'text-white/90 hover:bg-white/10 hover:text-white'
                }`}
              >
                <span>Đơn hàng</span>
                <svg class="h-3.5 w-3.5 opacity-70 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </a>

              <!-- Dropdown Menu -->
              <div class="absolute left-0 top-full hidden pt-1 group-hover:block z-50">
                <div class="rounded-lg border border-gray-200 bg-white p-3 shadow-2xl min-w-[250px] text-gray-800 space-y-1">
                  <div class="px-2 pb-1 text-[11.5px] font-bold uppercase tracking-wider text-gray-400">
                    Bán hàng & Dịch vụ
                  </div>
                  <a href="/admin/orders" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition">
                    <span class="text-blue-600">⚡</span> Bán hàng
                  </a>
                  <a href="/admin/orders?type=PREORDER" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium text-gray-700 hover:bg-amber-50 hover:text-amber-700 transition">
                    <span class="text-amber-600">📋</span> Đặt hàng
                  </a>
                  <a href="/admin/repairs" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition">
                    <span class="text-gray-400">🔧</span> Tiếp nhận & Sửa chữa
                  </a>
                  <a href="/admin/repairs/new" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition">
                    <span class="text-gray-400">➕</span> Tạo phiếu sửa chữa mới
                  </a>

                  <div class="my-1 border-t border-gray-100"></div>
                  <div class="px-2 pb-1 text-[11.5px] font-bold uppercase tracking-wider text-gray-400">
                    Giao vận & Chành xe
                  </div>
                  <a href="/admin/shipments" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition">
                    <span class="text-gray-400">🚚</span> Quản lý Vận đơn
                  </a>
                  <a href="/admin/delivery-partners" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition">
                    <span class="text-gray-400">🤝</span> Đối tác giao hàng (Chành xe / Hãng)
                  </a>
                  <a href="/admin/delivery-reconciliations" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition">
                    <span class="text-gray-400">⚖️</span> Đối soát COD & Cước
                  </a>
                </div>
              </div>
            </div>

            <!-- 5. ĐỐI TÁC (MEGA DROPDOWN CHUẨN KIOTVIET) -->
            <div class="group relative">
              <a
                href="/admin/customers"
                class={`flex h-[50px] items-center gap-1 px-3.5 text-[14px] font-medium tracking-wide transition ${
                  active === 'customers' || active === 'suppliers'
                    ? 'bg-[#083a77] text-white font-semibold shadow-inner'
                    : 'text-white/90 hover:bg-white/10 hover:text-white'
                }`}
              >
                <span>Đối tác</span>
                <svg class="h-3.5 w-3.5 opacity-70 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </a>

              <div class="absolute left-0 top-full hidden pt-1 group-hover:block z-50">
                <div class="rounded-lg border border-gray-200 bg-white p-3 shadow-2xl min-w-[230px] text-gray-800 space-y-1">
                  <div class="px-2 pb-1 text-[11.5px] font-bold uppercase tracking-wider text-gray-400">
                    Khách Hàng & Nhà Cung Cấp
                  </div>
                  <a href="/admin/customers" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition">
                    <span class="text-blue-600">👤</span> Khách hàng
                  </a>
                  <a href="/admin/suppliers" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition">
                    <span class="text-indigo-600">🏭</span> Nhà cung cấp
                  </a>
                  <a href="/admin/delivery-partners" class="flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition">
                    <span class="text-gray-500">🚚</span> Đối tác giao hàng
                  </a>
                </div>
              </div>
            </div>

            <!-- 6. SỔ QUỸ -->
            <a
              href="/admin/cash"
              class={`flex h-[50px] items-center px-3.5 text-[14px] font-medium tracking-wide transition ${
                active === 'cash'
                  ? 'bg-[#083a77] text-white font-semibold shadow-inner'
                  : 'text-white/90 hover:bg-white/10 hover:text-white'
              }`}
            >
              Sổ quỹ
            </a>

            <a href="/admin/pending-actions" class={`flex h-[50px] items-center px-3.5 text-[14px] font-medium ${active === 'pending-actions' ? 'bg-[#083a77] text-white' : 'text-white/90 hover:bg-white/10'}`}>Cần xử lý</a>

            <!-- 7. BÁO CÁO (DROPDOWN 6 MỤC CHUẨN KIOTVIET) -->
            <div class="group relative">
              <a
                href="/admin/reports/daily"
                class={`flex h-[50px] items-center gap-1 px-3.5 text-[14px] font-medium tracking-wide transition ${
                  isReportsActive
                    ? 'bg-[#083a77] text-white font-semibold shadow-inner'
                    : 'text-white/90 hover:bg-white/10 hover:text-white'
                }`}
              >
                <span>Báo cáo</span>
                <svg class="h-3.5 w-3.5 opacity-70 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </a>

              <!-- Dropdown Menu 6 Mục (2 cột gọn gàng) -->
              <div class="absolute left-0 top-full hidden pt-1 group-hover:block z-50">
                <div class="flex rounded-lg border border-gray-200 bg-white p-3 shadow-2xl min-w-[360px] text-gray-800 divide-x divide-gray-100">
                  <!-- Cột 1 -->
                  <div class="pr-3 flex-1 space-y-1">
                    <a href="/admin/reports/daily" class={`flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium transition ${active === 'reports-daily' ? 'bg-blue-50 text-blue-700 font-semibold' : 'text-gray-700 hover:bg-blue-50 hover:text-blue-700'}`}>
                      <span class="text-gray-400">🌅</span> Cuối ngày
                    </a>
                    <a href="/admin/reports/sales" class={`flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium transition ${active === 'reports-sales' ? 'bg-blue-50 text-blue-700 font-semibold' : 'text-gray-700 hover:bg-blue-50 hover:text-blue-700'}`}>
                      <span class="text-gray-400">📈</span> Bán hàng
                    </a>
                    <a href="/admin/reports/orders" class={`flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium transition ${active === 'reports-orders' ? 'bg-blue-50 text-blue-700 font-semibold' : 'text-gray-700 hover:bg-blue-50 hover:text-blue-700'}`}>
                      <span class="text-gray-400">📦</span> Đặt hàng
                    </a>
                  </div>

                  <!-- Cột 2 -->
                  <div class="pl-3 flex-1 space-y-1">
                    <a href="/admin/reports/products" class={`flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium transition ${active === 'reports-products' ? 'bg-blue-50 text-blue-700 font-semibold' : 'text-gray-700 hover:bg-blue-50 hover:text-blue-700'}`}>
                      <span class="text-gray-400">🏷️</span> Hàng hóa
                    </a>
                    <a href="/admin/reports/customers" class={`flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium transition ${active === 'reports-customers' ? 'bg-blue-50 text-blue-700 font-semibold' : 'text-gray-700 hover:bg-blue-50 hover:text-blue-700'}`}>
                      <span class="text-gray-400">👥</span> Khách hàng
                    </a>
                    <a href="/admin/reports/financial" class={`flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13.5px] font-medium transition ${active === 'reports-financial' ? 'bg-blue-50 text-blue-700 font-semibold' : 'text-gray-700 hover:bg-blue-50 hover:text-blue-700'}`}>
                      <span class="text-gray-400">📊</span> Tài chính
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </nav>
        </div>

        <!-- RIGHT: POS ACTION BUTTON & SETTINGS -->
        <div class="flex items-center gap-2 sm:gap-3">
          <!-- POS BÁN HÀNG BUTTON (HIGHLIGHTED) -->
          <a
            href="/admin/sale"
            class="inline-flex items-center gap-1.5 rounded bg-[#00a2ff] hover:bg-[#008fe0] active:bg-[#007cc7] px-3.5 py-1.5 text-[13px] font-bold uppercase tracking-wider text-white shadow-sm transition"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
            <span>Bán hàng</span>
          </a>

          <!-- SETTINGS DROPDOWN (BÁNH RĂNG ⚙️) -->
          <div class="group relative">
            <button
              type="button"
              class={`flex h-8 w-8 items-center justify-center rounded text-white/80 hover:bg-white/15 hover:text-white transition ${
                isSettingsActive ? 'bg-white/20 text-white' : ''
              }`}
              title="Cài đặt hệ thống"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </button>

            <!-- Dropdown Menu -->
            <div class="absolute right-0 top-full hidden pt-1 group-hover:block z-50">
              <div class="w-56 rounded-lg border border-gray-200 bg-white p-2 shadow-2xl text-gray-800 space-y-0.5">
                <div class="px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-gray-400">
                  Cấu hình cửa hàng
                </div>
                <a href="/admin/staff" class="block rounded-md px-3 py-1.5 text-xs font-medium hover:bg-gray-100">Tài khoản nhân viên</a>
                <a href="/admin/settings" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-100 transition">
                  <span>⚙️</span> Cài đặt hệ thống
                </a>
                <a href="/admin/shipping" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-100 transition">
                  <span>🚚</span> Cước vận chuyển
                </a>
                <a href="/admin/media" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-100 transition">
                  <span>🖼️</span> Thư viện hình ảnh
                </a>
                <a href="/admin/navigation" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-100 transition">
                  <span>📑</span> Menu Website
                </a>
                <a href="/admin/pages" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-100 transition">
                  <span>📄</span> Trang thông tin
                </a>
                <div class="my-1 border-t border-gray-100"></div>
                <a href="/" target="_blank" class="flex items-center justify-between rounded-md px-3 py-1.5 text-xs font-medium text-blue-600 hover:bg-blue-50 transition">
                  <span>Xem Website Cửa Hàng</span>
                  <span>↗</span>
                </a>
                {showLogout && (
                  <a href="/admin/logout" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50 transition">
                    <span>🚪</span> Đăng xuất
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- MOBILE DRAWER (RESPONSIVE TOGGLE) -->
      <input type="checkbox" id="mobile-nav-toggle" class="peer sr-only" />
      <div class="fixed inset-0 bg-black/50 z-40 hidden peer-checked:block lg:hidden" onclick="document.getElementById('mobile-nav-toggle').checked = false;"></div>
      <div class="fixed inset-y-0 left-0 w-72 bg-white shadow-2xl z-50 p-4 transform -translate-x-full peer-checked:translate-x-0 transition-transform duration-200 overflow-y-auto lg:hidden">
        <div class="flex items-center justify-between pb-3 border-b border-gray-200 mb-3">
          <span class="font-extrabold text-[#0b4d9c] text-lg">{storeName}</span>
          <label for="mobile-nav-toggle" class="p-1 text-gray-400 hover:text-gray-700 cursor-pointer">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </label>
        </div>
        <div class="space-y-3 text-sm">
          <a href="/admin" class="block font-semibold px-2 py-1.5 rounded hover:bg-blue-50">Tổng quan</a>
          
          <div class="font-bold text-xs uppercase text-gray-400 pt-2 px-2">Hàng hóa & Kho</div>
          <a href="/admin/products" class="block pl-4 py-1 hover:text-[#0b4d9c]">Danh sách hàng hóa</a>
          <a href="/admin/categories" class="block pl-4 py-1 hover:text-[#0b4d9c]">Nhóm hàng</a>
          <a href="/admin/units/lookup" class="block pl-4 py-1 hover:text-[#0b4d9c]">Tra cứu Serial / IMEI</a>
          <a href="/admin/inventory" class="block pl-4 py-1 hover:text-[#0b4d9c]">Sổ kho & Thẻ kho</a>
          <a href="/admin/inventory/outbound/new" class="block pl-4 py-1 hover:text-[#0b4d9c]">Lập phiếu xuất kho khác</a>
          <a href="/admin/production" class="block pl-4 py-1 hover:text-[#0b4d9c]">Lắp ráp & Đóng gói</a>
          
          <div class="font-bold text-xs uppercase text-gray-400 pt-2 px-2">Mua hàng & Đơn hàng</div>
          <a href="/admin/purchases" class="block pl-4 py-1 hover:text-[#0b4d9c]">Nhập hàng / Thu mua</a>
          <a href="/admin/orders" class="block pl-4 py-1 hover:text-[#0b4d9c]">⚡ Bán hàng</a>
          <a href="/admin/orders?type=PREORDER" class="block pl-4 py-1 hover:text-[#0b4d9c]">📋 Đặt hàng</a>
          <a href="/admin/repairs" class="block pl-4 py-1 hover:text-[#0b4d9c]">Sửa chữa bo máy</a>
          
          <div class="font-bold text-xs uppercase text-gray-400 pt-2 px-2">Đối tác & Sổ quỹ</div>
          <a href="/admin/customers" class="block pl-4 py-1 hover:text-[#0b4d9c]">Khách hàng</a>
          <a href="/admin/customers?tab=supplier" class="block pl-4 py-1 hover:text-[#0b4d9c]">Nhà cung cấp</a>
          <a href="/admin/pending-actions" class="block pl-4 py-1 hover:text-[#0b4d9c]">Cần xử lý</a>
          <a href="/admin/cash" class="block pl-4 py-1 hover:text-[#0b4d9c]">Sổ quỹ</a>

          <div class="font-bold text-xs uppercase text-gray-400 pt-2 px-2">Báo cáo thống kê</div>
          <a href="/admin/reports/daily" class="block pl-4 py-1 hover:text-[#0b4d9c]">Cuối ngày</a>
          <a href="/admin/reports/sales" class="block pl-4 py-1 hover:text-[#0b4d9c]">Bán hàng</a>
          <a href="/admin/reports/orders" class="block pl-4 py-1 hover:text-[#0b4d9c]">Đặt hàng</a>
          <a href="/admin/reports/products" class="block pl-4 py-1 hover:text-[#0b4d9c]">Hàng hóa</a>
          <a href="/admin/reports/customers" class="block pl-4 py-1 hover:text-[#0b4d9c]">Khách hàng</a>
          <a href="/admin/reports/financial" class="block pl-4 py-1 hover:text-[#0b4d9c]">Tài chính</a>

          <a href="/admin/staff" class="block pl-4 py-1">Tài khoản nhân viên</a>
          <div class="pt-4 border-t border-gray-200">
            <a href="/admin/sale" class="block text-center py-2 bg-[#00a2ff] text-white font-bold rounded">
              🛒 Vào Màn Hình Bán Hàng (POS)
            </a>
          </div>
        </div>
      </div>
    </header>}

    <!-- MAIN BODY WORKSPACE (EXPANDED TO FULL WIDTH) -->
    <main class="flex-1 w-full max-w-[1720px] mx-auto px-3 sm:px-4 py-4">
      {/* Alert Notices */}
      {showSetupNudge && (
        <a
          href="/admin/setup"
          class="mb-4 flex items-center justify-between gap-3 rounded-lg border border-blue-200 bg-blue-50 px-4 py-2.5 text-sm text-blue-900 shadow-xs transition hover:bg-blue-100"
        >
          <span>
            <strong class="font-semibold">Hoàn tất thiết lập cửa hàng:</strong> Tên cửa hàng, thanh toán, v.v.
          </span>
          <span aria-hidden="true" class="text-blue-700">&rarr;</span>
        </a>
      )}
      {Astro.locals.settings && active === 'settings' && paymentsInDemoMode(Astro.locals.settings) && (
        <div class="mb-4 rounded-lg border border-amber-300 bg-amber-50 px-4 py-2 text-xs sm:text-sm text-amber-800">
          <strong class="font-semibold">Chế độ Demo Checkout:</strong> Chưa cấu hình cổng thanh toán thật. Đơn thử nghiệm sẽ được gắn tag <code class="rounded bg-amber-100 px-1">demo</code>.
        </div>
      )}
      {shippingIssue && (
        <a
          href="/admin/shipping"
          class="mb-4 flex items-center justify-between gap-3 rounded-lg border border-red-300 bg-red-50 px-4 py-2.5 text-sm text-red-800 shadow-xs transition hover:bg-red-100"
        >
          <span>
            <strong class="font-semibold">Vấn đề cấu hình vận chuyển:</strong> {shippingIssue.reason}
          </span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      )}
      {inventoryExceptionCount > 0 && (
        <a
          href="/admin/orders#inventory-exceptions"
          class="mb-4 flex items-center justify-between gap-3 rounded-lg border border-red-300 bg-red-50 px-4 py-2.5 text-sm text-red-800 shadow-xs transition hover:bg-red-100"
        >
          <span>
            <strong class="font-semibold">Cảnh báo tồn kho:</strong> Có {inventoryExceptionCount} đơn hàng cần xử lý tồn kho.
          </span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      )}

      <!-- Page Content -->
      <slot />
    </main>
  </body>
</html>
